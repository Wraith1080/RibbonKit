<Window x:Class="RibbonKit.Writer.Page.WriterCustomMarginsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Margins" Width="520" Height="430" MinWidth="480" MinHeight="400"
        SizeToContent="Manual" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True"
        AutomationProperties.AutomationId="CustomMarginsDialog"
        AutomationProperties.Name="Custom Margins">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Set the physical page margins in inches. All four edges must leave a positive content area."
                   TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Top:" Margin="0,7,12,9" />
                <TextBox x:Name="TopBox" Grid.Column="1" Margin="0,0,0,8" TextChanged="OnMarginTextChanged"
                         AutomationProperties.AutomationId="MarginTop" AutomationProperties.Name="Top margin in inches" />
                <TextBlock Grid.Row="1" Text="Bottom:" Margin="0,7,12,9" />
                <TextBox x:Name="BottomBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextChanged="OnMarginTextChanged"
                         AutomationProperties.AutomationId="MarginBottom" AutomationProperties.Name="Bottom margin in inches" />
                <TextBlock Grid.Row="2" Text="Left:" Margin="0,7,12,9" />
                <TextBox x:Name="LeftBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" TextChanged="OnMarginTextChanged"
                         AutomationProperties.AutomationId="MarginLeft" AutomationProperties.Name="Left margin in inches" />
                <TextBlock Grid.Row="3" Text="Right:" Margin="0,7,12,9" />
                <TextBox x:Name="RightBox" Grid.Row="3" Grid.Column="1" TextChanged="OnMarginTextChanged"
                         AutomationProperties.AutomationId="MarginRight" AutomationProperties.Name="Right margin in inches" />
            </Grid>
            <Border Grid.Column="1" Margin="30,0,12,0" Padding="12"
                    Background="{DynamicResource RibbonKit.Brushes.Control.CompanionBackground}"
                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1">
                <Viewbox Stretch="Uniform">
                    <Border x:Name="PagePreview" Width="150" Height="194" Background="White"
                            BorderBrush="#80909090" BorderThickness="1">
                        <Border x:Name="MarginPreview" BorderBrush="#FF607A96" BorderThickness="1"
                                Background="#0F607A96" />
                    </Border>
                </Viewbox>
            </Border>
        </Grid>
        <TextBlock x:Name="ValidationText" Grid.Row="2" MinHeight="20" TextWrapping="Wrap"
                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                   AutomationProperties.AutomationId="MarginValidation" AutomationProperties.Name="Margin validation" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Content="Apply" Width="88" IsDefault="True" Click="OnApply"
                    AutomationProperties.AutomationId="ApplyMargins" AutomationProperties.Name="Apply custom margins" />
            <Button Content="Cancel" Width="88" Margin="10,0,0,0" IsCancel="True"
                    AutomationProperties.AutomationId="CancelMargins" AutomationProperties.Name="Cancel custom margins" />
        </StackPanel>
    </Grid>
</Window>
