<UserControl x:Class="RibbonKit.Writer.Appearance.WriterAppearancePage" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rk="clr-namespace:RibbonKit;assembly=RibbonKit" xmlns:animation="clr-namespace:RibbonKit.Animation;assembly=RibbonKit" xmlns:controls="clr-namespace:RibbonKit.Controls;assembly=RibbonKit" xmlns:interop="clr-namespace:RibbonKit.Interop;assembly=RibbonKit" xmlns:theming="clr-namespace:RibbonKit.Theming;assembly=RibbonKit" MinWidth="260" SizeChanged="OnAppearanceSizeChanged" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" AutomationProperties.AutomationId="WriterAppearancePage" AutomationProperties.Name="Appearance settings">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.OptionsDialog.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
        <TextBlock Margin="0,0,0,14" TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" Text="Preview Writer's theme, File surface, window material, and motion. Apply or OK saves these separately from document and ribbon customization." />
        <Grid x:Name="AppearanceColumns">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="AppearanceLeftColumn" Grid.Column="0">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Theme" Margin="0,0,0,3" />
                    <controls:RibbonComboBox x:Name="ThemeCombo" InputWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" MinHeight="26" SelectionChanged="OnValueChanged" AutomationProperties.AutomationId="AppearanceTheme" AutomationProperties.Name="Ribbon theme">
                        <ComboBoxItem Content="Crystal" Tag="{x:Static theming:RibbonTheme.CrystalLight}" />
                        <ComboBoxItem Content="Office 2024" Tag="{x:Static theming:RibbonTheme.Office2024}" />
                        <ComboBoxItem Content="Office 2019" Tag="{x:Static theming:RibbonTheme.Office2019}" />
                        <ComboBoxItem Content="Office 2013" Tag="{x:Static theming:RibbonTheme.Office2013}" />
                        <ComboBoxItem Content="Office 2010" Tag="{x:Static theming:RibbonTheme.Office2010}" />
                        <ComboBoxItem Content="Office 2007" Tag="{x:Static theming:RibbonTheme.Office2007}" />
                    </controls:RibbonComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Palette" Margin="0,0,0,3" />
                    <controls:RibbonComboBox x:Name="PaletteCombo" InputWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" MinHeight="26" SelectionChanged="OnValueChanged" AutomationProperties.AutomationId="AppearancePalette" AutomationProperties.Name="Light or dark palette">
                        <ComboBoxItem Content="Light" Tag="False" />
                        <ComboBoxItem Content="Dark / Black" Tag="True" />
                    </controls:RibbonComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Accent" Margin="0,0,0,3" />
                    <StackPanel Orientation="Horizontal">
                        <controls:RibbonCheckBox x:Name="CustomAccentCheck" MinHeight="28" Margin="0,1,0,1" VerticalAlignment="Center" Content="Custom" Checked="OnAccentModeChanged" Unchecked="OnAccentModeChanged" AutomationProperties.AutomationId="AppearanceCustomAccent" AutomationProperties.Name="Use custom accent" />
                        <Button x:Name="AccentButton" Margin="10,0,0,0" Padding="10,4" Style="{DynamicResource OptionsDialogActionButtonStyle}" Click="OnChooseAccent" Content="#FF2B579A" AutomationProperties.AutomationId="AppearanceAccentColor" AutomationProperties.Name="Choose accent color" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Backstage design" Margin="0,0,0,3" />
                    <controls:RibbonComboBox x:Name="BackstageCombo" InputWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" MinHeight="26" SelectionChanged="OnValueChanged" AutomationProperties.AutomationId="AppearanceBackstageDesign" AutomationProperties.Name="Backstage design">
                        <ComboBoxItem Content="Crystal Sidebar" Tag="{x:Static rk:RibbonBackstageDesign.CrystalSidebar}" />
                        <ComboBoxItem Content="Crystal Floating" Tag="{x:Static rk:RibbonBackstageDesign.CrystalFloating}" />
                        <ComboBoxItem Content="Modern" Tag="{x:Static rk:RibbonBackstageDesign.Modern}" />
                        <ComboBoxItem Content="Classic" Tag="{x:Static rk:RibbonBackstageDesign.Classic}" />
                        <ComboBoxItem Content="Classic 2010" Tag="{x:Static rk:RibbonBackstageDesign.Classic2010}" />
                        <ComboBoxItem Content="Glass 2007" Tag="{x:Static rk:RibbonBackstageDesign.Glass2007}" />
                        <ComboBoxItem Content="Classic 2007" Tag="{x:Static rk:RibbonBackstageDesign.Classic2007}" />
                    </controls:RibbonComboBox>
                </StackPanel>
                <controls:RibbonCheckBox x:Name="AccentedTitleBarCheck" MinHeight="28" Margin="0,1,0,1" Content="Use accent color" Checked="OnValueChanged" Unchecked="OnValueChanged" AutomationProperties.AutomationId="AppearanceAccentedTitleBar" AutomationProperties.Name="Use accented title bar" />
                <controls:RibbonCheckBox x:Name="GlassSurfacesCheck" MinHeight="28" Margin="0,1,0,1" Content="Glass surface treatment" Checked="OnValueChanged" Unchecked="OnValueChanged" AutomationProperties.AutomationId="AppearanceGlassSurfaces" AutomationProperties.Name="Use glass surface treatment" />
                <controls:RibbonCheckBox x:Name="CapturedPopupBackdropCheck" MinHeight="28" Margin="0,1,0,1" Content="Blur behind ribbon popups" Checked="OnValueChanged" Unchecked="OnValueChanged" AutomationProperties.AutomationId="AppearanceCapturedPopupBackdrop" AutomationProperties.Name="Capture backdrop behind supported ribbon popups" />
                <controls:RibbonCheckBox x:Name="BackstageTranslucentCheck" MinHeight="28" Margin="0,1,0,1" Content="Translucent Backstage" Checked="OnValueChanged" Unchecked="OnValueChanged" AutomationProperties.AutomationId="AppearanceBackstageTranslucent" AutomationProperties.Name="Use translucent Backstage" />
            </StackPanel>
            <StackPanel x:Name="AppearanceRightColumn" Grid.Column="2">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Window backdrop" Margin="0,0,0,3" />
                    <controls:RibbonComboBox x:Name="BackdropCombo" InputWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" MinHeight="26" SelectionChanged="OnValueChanged" AutomationProperties.AutomationId="AppearanceBackdrop" AutomationProperties.Name="Window backdrop">
                        <ComboBoxItem Content="None" Tag="{x:Static interop:RibbonBackdrop.None}" />
                        <ComboBoxItem Content="Mica" Tag="{x:Static interop:RibbonBackdrop.Mica}" />
                        <ComboBoxItem Content="Acrylic" Tag="{x:Static interop:RibbonBackdrop.Acrylic}" />
                        <ComboBoxItem Content="Tabbed / Mica Alt" Tag="{x:Static interop:RibbonBackdrop.Tabbed}" />
                    </controls:RibbonComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Window frame" Margin="0,0,0,3" />
                    <controls:RibbonComboBox x:Name="FrameCombo" InputWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" MinHeight="26" SelectionChanged="OnValueChanged" AutomationProperties.AutomationId="AppearanceFrame" AutomationProperties.Name="Window frame presentation">
                        <ComboBoxItem Content="Theme default" Tag="{x:Static controls:RibbonWindowFrameAppearance.Default}" />
                        <ComboBoxItem Content="Office 2007 Aero" Tag="{x:Static controls:RibbonWindowFrameAppearance.Office2007Aero}" />
                        <ComboBoxItem Content="Office 2010 Aero" Tag="{x:Static controls:RibbonWindowFrameAppearance.Office2010Aero}" />
                    </controls:RibbonComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Application button" Margin="0,0,0,3" />
                    <controls:RibbonComboBox x:Name="ApplicationButtonCombo" InputWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" MinHeight="26" SelectionChanged="OnValueChanged" AutomationProperties.AutomationId="AppearanceApplicationButton" AutomationProperties.Name="Application button presentation">
                        <ComboBoxItem Content="File tab" Tag="{x:Static rk:RibbonApplicationButtonShape.Tab}" />
                        <ComboBoxItem Content="Office orb" Tag="{x:Static rk:RibbonApplicationButtonShape.Orb}" />
                    </controls:RibbonComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Ribbon motion" Margin="0,0,0,3" />
                    <controls:RibbonComboBox x:Name="AnimationCombo" InputWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" MinHeight="26" SelectionChanged="OnValueChanged" AutomationProperties.AutomationId="AppearanceAnimation" AutomationProperties.Name="Ribbon animation level">
                        <ComboBoxItem Content="None" Tag="{x:Static animation:RibbonAnimationLevel.None}" />
                        <ComboBoxItem Content="Subtle" Tag="{x:Static animation:RibbonAnimationLevel.Subtle}" />
                        <ComboBoxItem Content="Expressive" Tag="{x:Static animation:RibbonAnimationLevel.Expressive}" />
                    </controls:RibbonComboBox>
                </StackPanel>
                <controls:RibbonCheckBox x:Name="RespectReducedMotionCheck" MinHeight="28" Margin="0,1,0,1" Content="Respect Windows reduced motion" Checked="OnValueChanged" Unchecked="OnValueChanged" AutomationProperties.AutomationId="AppearanceRespectReducedMotion" AutomationProperties.Name="Respect Windows reduced motion" />
                <controls:RibbonCheckBox x:Name="ShowRulerCheck" MinHeight="28" Margin="0,1,0,1" Content="Show ruler in Paper view" Checked="OnValueChanged" Unchecked="OnValueChanged" AutomationProperties.AutomationId="AppearanceShowRuler" AutomationProperties.Name="Show ruler" />
                <controls:RibbonCheckBox x:Name="ShowMarginGuidesCheck" MinHeight="28" Margin="0,1,0,1" Content="Show margin guides in Paper view" Checked="OnValueChanged" Unchecked="OnValueChanged" AutomationProperties.AutomationId="AppearanceShowMarginGuides" AutomationProperties.Name="Show margin guides" />
            </StackPanel>
        </Grid>
        <Expander Margin="0,10,0,0" Header="Compatibility details" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}">
            <Border Margin="0,6,0,0" Padding="10" CornerRadius="3" Background="{DynamicResource RibbonKit.Brushes.Control.CompanionBackground}">
                <TextBlock x:Name="CompatibilityText" TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" AutomationProperties.AutomationId="AppearanceCompatibility" AutomationProperties.Name="Compatibility explanation" />
            </Border>
        </Expander>
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AppearanceDefaultsButton" Margin="0,0,8,0" Padding="12,5" Content="Appearance defaults" Style="{DynamicResource OptionsDialogActionButtonStyle}" Click="OnDefaults" AutomationProperties.AutomationId="AppearanceDefaults" AutomationProperties.Name="Restore appearance defaults" />
            <Button x:Name="AppearanceApplyButton" Padding="16,5" Content="Apply appearance" Click="OnApply" Style="{DynamicResource OptionsDialogPrimaryButtonStyle}" AutomationProperties.AutomationId="AppearanceApply" AutomationProperties.Name="Apply appearance settings" />
        </StackPanel>
    </StackPanel>
</UserControl>