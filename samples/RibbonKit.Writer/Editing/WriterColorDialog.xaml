<Window x:Class="RibbonKit.Writer.Editing.WriterColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rk="clr-namespace:RibbonKit.Controls;assembly=RibbonKit"
        Title="Color" Width="600" MinWidth="600" MaxWidth="600"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
        Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
        AutomationProperties.AutomationId="WriterColorDialog"
        AutomationProperties.Name="Color">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.OptionsDialog.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ColorSectionStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.CompanionBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RibbonKit.Metrics.GroupCornerRadius}" />
        </Style>
        <Style x:Key="ColorSectionHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choose a standard or recent color, or enter an exact Hex/RGB value."
                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                   TextWrapping="Wrap" />

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource ColorSectionStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Palette" Style="{StaticResource ColorSectionHeaderStyle}" />
                <WrapPanel x:Name="PalettePanel" Grid.Row="1" Margin="0,10,0,0"
                           AutomationProperties.AutomationId="ColorPalette"
                           AutomationProperties.Name="Color palette" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource ColorSectionStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Color picker" Style="{StaticResource ColorSectionHeaderStyle}" />
                <Border x:Name="SaturationValueSurface" Grid.Row="1" Height="138" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                        ClipToBounds="True" Cursor="Cross" Focusable="True"
                        MouseLeftButtonDown="OnSaturationValueMouseDown"
                        MouseMove="OnSaturationValueMouseMove"
                        MouseLeftButtonUp="OnPickerMouseUp"
                        LostMouseCapture="OnPickerLostMouseCapture"
                        SizeChanged="OnPickerSizeChanged"
                        KeyDown="OnSaturationValueKeyDown"
                        AutomationProperties.AutomationId="ColorSaturationValuePicker"
                        AutomationProperties.Name="Color saturation and brightness picker">
                    <Grid x:Name="SaturationValueField">
                        <Border x:Name="HueBackground" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#FF000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SaturationValueIndicatorOuter" Width="14" Height="14"
                                     Stroke="#CC000000" StrokeThickness="3" />
                            <Ellipse x:Name="SaturationValueIndicatorInner" Width="10" Height="10"
                                     Stroke="White" StrokeThickness="2" />
                        </Canvas>
                    </Grid>
                </Border>
                <Border x:Name="HueSurface" Grid.Row="2" Height="18" Margin="0,10,0,0"
                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource RibbonKit.Metrics.SmallControlCornerRadius}"
                        ClipToBounds="True" Cursor="Hand" Focusable="True"
                        MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove"
                        MouseLeftButtonUp="OnPickerMouseUp" LostMouseCapture="OnPickerLostMouseCapture"
                        SizeChanged="OnPickerSizeChanged" KeyDown="OnHueKeyDown"
                        AutomationProperties.AutomationId="ColorHuePicker"
                        AutomationProperties.Name="Color hue picker">
                    <Grid>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFF0000" Offset="0" />
                                    <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                    <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                    <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                    <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                    <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                    <GradientStop Color="#FFFF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas Height="14" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border x:Name="HueIndicator" Width="4" Height="14"
                                    Background="White" BorderBrush="#CC000000" BorderThickness="1" />
                        </Canvas>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="3" Margin="0,7,0,0"
                           Text="Drag the box to choose saturation and brightness; use the strip for hue."
                           Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource ColorSectionStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Custom color" Style="{StaticResource ColorSectionHeaderStyle}" />
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <rk:RibbonTextBox x:Name="HexBox" Header="Hex" InputWidth="142" MaxLength="7"
                                      TextChanged="OnHexChanged"
                                      AutomationProperties.AutomationId="ColorHex"
                                      AutomationProperties.Name="Hex color" />
                    <rk:RibbonTextBox x:Name="RedBox" Grid.Column="1" Header="R" InputWidth="58"
                                      Margin="12,0,0,0" MaxLength="3" TextChanged="OnRgbChanged"
                                      AutomationProperties.AutomationId="ColorRed"
                                      AutomationProperties.Name="Red channel" />
                    <rk:RibbonTextBox x:Name="GreenBox" Grid.Column="2" Header="G" InputWidth="58"
                                      Margin="12,0,0,0" MaxLength="3" TextChanged="OnRgbChanged"
                                      AutomationProperties.AutomationId="ColorGreen"
                                      AutomationProperties.Name="Green channel" />
                    <rk:RibbonTextBox x:Name="BlueBox" Grid.Column="3" Header="B" InputWidth="58"
                                      Margin="12,0,0,0" MaxLength="3" TextChanged="OnRgbChanged"
                                      AutomationProperties.AutomationId="ColorBlue"
                                      AutomationProperties.Name="Blue channel" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource ColorSectionStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewSwatch" Width="68" Height="48"
                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Selected color" Style="{StaticResource ColorSectionHeaderStyle}" />
                    <TextBlock x:Name="SelectedColorText" Margin="0,4,0,0"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="ColorValidation"
                       AutomationProperties.Name="Color validation" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="OK" IsDefault="True"
                        Style="{DynamicResource OptionsDialogPrimaryButtonStyle}"
                        Click="OnOk" AutomationProperties.AutomationId="OkColor"
                        AutomationProperties.Name="Accept color" />
                <Button x:Name="CancelButton" Content="Cancel" Margin="10,0,0,0" IsCancel="True"
                        Style="{DynamicResource OptionsDialogActionButtonStyle}"
                        AutomationProperties.AutomationId="CancelColor"
                        AutomationProperties.Name="Cancel color" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
