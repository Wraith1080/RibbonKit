<Window x:Class="RibbonKit.Writer.Editing.WriterDateTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Date and Time" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        AutomationProperties.AutomationId="InsertDateTimeDialog"
        AutomationProperties.Name="Insert Date and Time">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Choose a value and format. The inserted text is ordinary editable document text."
                   TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Date:" VerticalAlignment="Center" />
            <DatePicker x:Name="DateBox" Grid.Column="1" SelectedDateChanged="OnDateChanged"
                        AutomationProperties.AutomationId="DateTimeDate"
                        AutomationProperties.Name="Date" />
            <TextBlock Grid.Row="1" Text="Time:" VerticalAlignment="Center" Margin="0,10,0,0" />
            <TextBox x:Name="TimeBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                     VerticalContentAlignment="Center" TextChanged="OnTimeChanged"
                     AutomationProperties.AutomationId="DateTimeTime"
                     AutomationProperties.Name="Time" />
            <TextBlock Grid.Row="2" Text="Format:" VerticalAlignment="Center" Margin="0,10,0,0" />
            <ComboBox x:Name="FormatBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                      VerticalAlignment="Center" SelectedIndex="0"
                      SelectionChanged="OnFormatChanged"
                      AutomationProperties.AutomationId="DateTimeFormat"
                      AutomationProperties.Name="Date and time format">
                <ComboBoxItem Tag="g" Content="Short date and time" />
                <ComboBoxItem Tag="d" Content="Short date" />
                <ComboBoxItem Tag="D" Content="Long date" />
                <ComboBoxItem Tag="yyyy-MM-dd HH:mm" Content="ISO date and time" />
            </ComboBox>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="DateTimeValidation"
                       AutomationProperties.Name="Date and time validation" />
            <Button x:Name="InsertButton" Grid.Column="1" Content="Insert" Width="92" IsDefault="True"
                    Click="OnInsert" AutomationProperties.AutomationId="InsertDateTime"
                    AutomationProperties.Name="Insert date and time" />
            <Button Grid.Column="2" Content="Cancel" Width="92" Margin="10,0,0,0" IsCancel="True"
                    AutomationProperties.AutomationId="CancelDateTime"
                    AutomationProperties.Name="Cancel date and time insertion" />
        </Grid>
    </Grid>
</Window>
