<Window x:Class="RibbonKit.Writer.Editing.WriterFontDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rk="clr-namespace:RibbonKit.Controls;assembly=RibbonKit"
        Title="Font" Width="680" MinWidth="680" MaxWidth="680"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
        Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
        AutomationProperties.AutomationId="WriterFontDialog"
        AutomationProperties.Name="Font">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.OptionsDialog.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="FontSectionStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.CompanionBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RibbonKit.Metrics.GroupCornerRadius}" />
        </Style>
        <Style x:Key="FontSectionHeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        </Style>
        <Style x:Key="FontLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choose supported character formatting. The preview updates before anything is applied."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />

        <Border x:Name="TypefaceSection" Grid.Row="1" Margin="0,14,0,0"
                Style="{StaticResource FontSectionStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <TextBlock Text="Typeface" Style="{StaticResource FontSectionHeaderStyle}" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Font family" Style="{StaticResource FontLabelStyle}" />
                    <rk:RibbonComboBox x:Name="FontFamilyBox" Grid.Column="1"
                                       InputWidth="474" IsEditable="True" IsTextSearchEnabled="True"
                                       TextSearch.TextPath="DisplayName"
                                       SelectionChanged="OnInputChanged"
                                       AutomationProperties.AutomationId="FontDialogFamily"
                                       AutomationProperties.Name="Font family">
                        <rk:RibbonComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding FontFamily}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </rk:RibbonComboBox.ItemTemplate>
                    </rk:RibbonComboBox>
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Font style" Style="{StaticResource FontLabelStyle}" />
                    <rk:RibbonComboBox x:Name="FontStyleBox" Grid.Column="1" InputWidth="260"
                                       SelectionChanged="OnInputChanged"
                                       AutomationProperties.AutomationId="FontDialogStyle"
                                       AutomationProperties.Name="Font style">
                        <ComboBoxItem Tag="Regular" Content="Regular" />
                        <ComboBoxItem Tag="Italic" Content="Italic" />
                        <ComboBoxItem Tag="Bold" Content="Bold" />
                        <ComboBoxItem Tag="BoldItalic" Content="Bold Italic" />
                    </rk:RibbonComboBox>
                    <TextBlock Grid.Column="2" Text="Size (pt)" Margin="10,0,0,0"
                               Style="{StaticResource FontLabelStyle}" />
                    <rk:RibbonComboBox x:Name="FontSizeBox" Grid.Column="3" InputWidth="120"
                                       IsEditable="True" IsTextSearchEnabled="False"
                                       SelectionChanged="OnInputChanged"
                                       AutomationProperties.AutomationId="FontDialogSize"
                                       AutomationProperties.Name="Font size in points">
                        <ComboBoxItem Content="8" />
                        <ComboBoxItem Content="9" />
                        <ComboBoxItem Content="10" />
                        <ComboBoxItem Content="11" />
                        <ComboBoxItem Content="12" />
                        <ComboBoxItem Content="14" />
                        <ComboBoxItem Content="16" />
                        <ComboBoxItem Content="18" />
                        <ComboBoxItem Content="20" />
                        <ComboBoxItem Content="24" />
                        <ComboBoxItem Content="28" />
                        <ComboBoxItem Content="36" />
                        <ComboBoxItem Content="48" />
                        <ComboBoxItem Content="72" />
                    </rk:RibbonComboBox>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource FontSectionStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Effects" Style="{StaticResource FontSectionHeaderStyle}" />
                    <rk:RibbonCheckBox x:Name="UnderlineBox" Header="Underline" Margin="0,10,0,0"
                                       Checked="OnInputChanged" Unchecked="OnInputChanged"
                                       AutomationProperties.AutomationId="FontDialogUnderline"
                                       AutomationProperties.Name="Underline" />
                    <rk:RibbonCheckBox x:Name="StrikethroughBox" Header="Strikethrough" Margin="0,6,0,0"
                                       Checked="OnStrikethroughChanged" Unchecked="OnInputChanged"
                                       AutomationProperties.AutomationId="FontDialogStrikethrough"
                                       AutomationProperties.Name="Strikethrough" />
                    <rk:RibbonCheckBox x:Name="DoubleStrikethroughBox" Header="Double strikethrough" Margin="0,6,0,0"
                                       Checked="OnDoubleStrikethroughChanged" Unchecked="OnInputChanged"
                                       AutomationProperties.AutomationId="FontDialogDoubleStrikethrough"
                                       AutomationProperties.Name="Double strikethrough" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Position" Style="{StaticResource FontSectionHeaderStyle}" />
                    <rk:RibbonCheckBox x:Name="SuperscriptBox" Header="Superscript" Margin="0,10,0,0"
                                       Checked="OnSuperscriptChanged" Unchecked="OnInputChanged"
                                       AutomationProperties.AutomationId="FontDialogSuperscript"
                                       AutomationProperties.Name="Superscript" />
                    <rk:RibbonCheckBox x:Name="SubscriptBox" Header="Subscript" Margin="0,6,0,0"
                                       Checked="OnSubscriptChanged" Unchecked="OnInputChanged"
                                       AutomationProperties.AutomationId="FontDialogSubscript"
                                       AutomationProperties.Name="Subscript" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Font color" Style="{StaticResource FontSectionHeaderStyle}" />
                    <Button x:Name="ColorButton" Margin="0,8,0,0"
                            Style="{DynamicResource OptionsDialogActionButtonStyle}"
                            Click="OnChooseColor"
                            AutomationProperties.AutomationId="FontDialogColor"
                            AutomationProperties.Name="Choose font color">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ColorSwatch" Width="22" Height="14" Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.SmallControlCornerRadius}" />
                            <TextBlock x:Name="ColorNameText" Text="Choose color..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource FontSectionStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Preview" Style="{StaticResource FontSectionHeaderStyle}" />
                <Border Grid.Row="1" Height="104" Margin="0,10,0,0"
                        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}">
                    <TextBlock x:Name="PreviewText" FontSize="28"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Run x:Name="PreviewRun" Text="Aa Bb Cc 123" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="ValidationText" Grid.Row="4" Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.AutomationId="FontDialogValidation"
                   AutomationProperties.Name="Font dialog validation" />

        <StackPanel Grid.Row="5" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ApplyButton" Content="Apply" Margin="0,0,10,0"
                    Style="{DynamicResource OptionsDialogActionButtonStyle}"
                    Click="OnApply" AutomationProperties.AutomationId="ApplyFont"
                    AutomationProperties.Name="Apply font changes" />
            <Button x:Name="OkButton" Content="OK" IsDefault="True"
                    Style="{DynamicResource OptionsDialogPrimaryButtonStyle}"
                    Click="OnOk" AutomationProperties.AutomationId="OkFont"
                    AutomationProperties.Name="Accept font changes" />
            <Button x:Name="CancelButton" Content="Cancel" Margin="10,0,0,0" IsCancel="True"
                    Style="{DynamicResource OptionsDialogActionButtonStyle}"
                    AutomationProperties.AutomationId="CancelFont"
                    AutomationProperties.Name="Cancel font changes" />
        </StackPanel>
    </Grid>
</Window>
