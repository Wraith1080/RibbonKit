<rk:RibbonWindow x:Class="RibbonKit.Writer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rk="urn:ribbonkit"
                 Title="{Binding Title}"
                 Width="1100"
                 Height="720"
                 MinWidth="480"
                 MinHeight="320"
                 WindowStartupLocation="CenterScreen"
                 UseLayoutRounding="True">
    <rk:RibbonWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </rk:RibbonWindow.Resources>
    <rk:RibbonWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
    </rk:RibbonWindow.InputBindings>
    <DockPanel AutomationProperties.AutomationId="WriterWindow">
        <rk:Ribbon x:Name="MainRibbon" DockPanel.Dock="Top" QuickAccessPosition="BelowRibbon"
                   AutomationProperties.AutomationId="MainRibbon" AutomationProperties.Name="Main ribbon">
            <rk:Ribbon.QuickAccessItems>
                <rk:RibbonButton Header="Save" Size="Small" Icon="{StaticResource Icon.WriterSave}" Command="{Binding SaveCommand}" rk:Ribbon.CommandId="Writer.Save" rk:KeyTip.Keys="S" ScreenTipTitle="Save" ScreenTipText="Save the current document (Ctrl+S)." AutomationProperties.AutomationId="QatSave" AutomationProperties.Name="Save" />
            </rk:Ribbon.QuickAccessItems>
            <rk:Ribbon.Backstage>
                <rk:Backstage Design="Modern" AutomationProperties.AutomationId="WriterBackstage" AutomationProperties.Name="File">
                    <rk:BackstageTabItem Header="Home" rk:KeyTip.Keys="H">
                        <StackPanel Margin="32" AutomationProperties.AutomationId="RecentPage">
                            <TextBlock Text="Recent documents" FontSize="28" Margin="0,0,0,12" />
                            <TextBlock Text="TXT keeps characters only; formatting, images, tables, and page settings are lost. RTF preserves representative formatting; advanced content is best effort." TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,18" />
                            <ItemsControl x:Name="RecentList" ItemsSource="{Binding RecentEntries}" AutomationProperties.AutomationId="RecentList" AutomationProperties.Name="Recent documents">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Content="{Binding Path}" Click="OnRecentItemClick" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding Path}" AutomationProperties.Name="{Binding Path}" Margin="0,2" Padding="8,4" HorizontalAlignment="Left" />
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </rk:BackstageTabItem>
                    <rk:BackstageTabItem Header="New" IsButton="True" rk:Ribbon.CommandId="Writer.New" rk:KeyTip.Keys="N" Click="OnBackstageAction" Command="{Binding NewCommand}" AutomationProperties.AutomationId="FileNew" AutomationProperties.Name="New" />
                    <rk:BackstageTabItem Header="Open" IsButton="True" rk:Ribbon.CommandId="Writer.Open" rk:KeyTip.Keys="O" Click="OnBackstageAction" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="FileOpen" AutomationProperties.Name="Open" />
                    <rk:BackstageTabItem Header="Save" IsButton="True" rk:Ribbon.CommandId="Writer.Save" rk:KeyTip.Keys="S" Click="OnBackstageAction" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="FileSave" AutomationProperties.Name="Save" />
                    <rk:BackstageTabItem Header="Save As" IsButton="True" rk:Ribbon.CommandId="Writer.SaveAs" rk:KeyTip.Keys="A" Click="OnBackstageAction" Command="{Binding SaveAsCommand}" AutomationProperties.AutomationId="FileSaveAs" AutomationProperties.Name="Save As" />
                    <rk:BackstageTabItem Header="Exit" IsButton="True" Placement="Bottom" rk:Ribbon.CommandId="Writer.Exit" rk:KeyTip.Keys="X" Click="OnBackstageAction" Command="{Binding ExitCommand}" AutomationProperties.AutomationId="FileExit" AutomationProperties.Name="Exit" />
                </rk:Backstage>
            </rk:Ribbon.Backstage>
            <rk:RibbonTab Header="Home" rk:Ribbon.CommandId="Writer.Home" rk:KeyTip.Keys="H" AutomationProperties.AutomationId="HomeTab" AutomationProperties.Name="Home">
                <rk:RibbonGroup Header="Document" rk:Ribbon.CommandId="Writer.DocumentGroup" AutomationProperties.AutomationId="DocumentGroup" AutomationProperties.Name="Document">
                    <rk:RibbonButton Header="New" Size="Medium" Command="{Binding NewCommand}" rk:Ribbon.CommandId="Writer.New" rk:KeyTip.Keys="N" ScreenTipTitle="New" ScreenTipText="Create a new document (Ctrl+N)." AutomationProperties.AutomationId="HomeNew" AutomationProperties.Name="New" />
                    <rk:RibbonButton Header="Open" Size="Medium" Command="{Binding OpenCommand}" rk:Ribbon.CommandId="Writer.Open" rk:KeyTip.Keys="O" ScreenTipTitle="Open" ScreenTipText="Open a document (Ctrl+O)." AutomationProperties.AutomationId="HomeOpen" AutomationProperties.Name="Open" />
                    <rk:RibbonButton Header="Save" Size="Medium" Command="{Binding SaveCommand}" rk:Ribbon.CommandId="Writer.Save" rk:KeyTip.Keys="S" ScreenTipTitle="Save" ScreenTipText="Save the current document (Ctrl+S)." AutomationProperties.AutomationId="HomeSave" AutomationProperties.Name="Save" />
                    <rk:RibbonButton Header="Save As" Size="Medium" Command="{Binding SaveAsCommand}" rk:Ribbon.CommandId="Writer.SaveAs" rk:KeyTip.Keys="A" ScreenTipTitle="Save As" ScreenTipText="Save to a new file (Ctrl+Shift+S)." AutomationProperties.AutomationId="HomeSaveAs" AutomationProperties.Name="Save As" />
                </rk:RibbonGroup>
            </rk:RibbonTab>
        </rk:Ribbon>
        <StatusBar DockPanel.Dock="Bottom" AutomationProperties.AutomationId="Status" AutomationProperties.Name="Status"><TextBlock Text="{Binding StatusText}" /></StatusBar>
        <RichTextBox x:Name="DocumentEditor"
                     Background="White"
                     BorderThickness="0"
                     Padding="28,22"
                     FontFamily="Segoe UI"
                     FontSize="13"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="DocumentEditor"
                     AutomationProperties.Name="Document editor">
            <FlowDocument PagePadding="0" />
        </RichTextBox>
    </DockPanel>
</rk:RibbonWindow>
