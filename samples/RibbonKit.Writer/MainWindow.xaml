                    <rk:RibbonButton x:Name="ZoomInButton" Header="Zoom In" Size="Large"
                                     Icon="{StaticResource Icon.WriterZoomIn}" LargeIcon="{StaticResource Icon.WriterZoomIn}"
                                     rk:Ribbon.CommandId="Writer.Home.Editing.ZoomIn" rk:KeyTip.Keys="ZI"
                                     ScreenTipTitle="Zoom In" ScreenTipText="Increase the current document view zoom by ten percent."
                                     AutomationProperties.AutomationId="ZoomIn" AutomationProperties.Name="Zoom In" />
                </rk:RibbonGroup>
                <rk:RibbonGroup x:Name="ViewDisplayGroup" Header="Show" rk:Ribbon.CommandId="Writer.View.Show" rk:KeyTip.Keys="S"
                                Icon="{StaticResource Icon.WriterRuler}"
                                AutomationProperties.AutomationId="ViewDisplayGroup" AutomationProperties.Name="Show">
                    <rk:RibbonToggleButton x:Name="RulerToggleButton" Header="Ruler" Size="Large"
                                           Icon="{StaticResource Icon.WriterRuler}" LargeIcon="{StaticResource Icon.WriterRuler}"
                                           Click="OnRulerToggleClick" rk:Ribbon.CommandId="Writer.View.Show.Ruler" rk:KeyTip.Keys="RU"
                                           ScreenTipTitle="Ruler" ScreenTipText="Show the calibrated horizontal ruler in Paper view."
                                           AutomationProperties.AutomationId="ViewRuler" AutomationProperties.Name="Ruler" />
                    <rk:RibbonToggleButton x:Name="MarginGuidesToggleButton" Header="Margin Guides" Size="Large"
                                           Icon="{StaticResource Icon.WriterGridlines}" LargeIcon="{StaticResource Icon.WriterGridlines}"
                                           Click="OnMarginGuidesToggleClick" rk:Ribbon.CommandId="Writer.View.Show.MarginGuides" rk:KeyTip.Keys="MG"
                                           ScreenTipTitle="Margin Guides" ScreenTipText="Show non-printing dotted guides at the page content boundary."
                                           AutomationProperties.AutomationId="ViewMarginGuides" AutomationProperties.Name="Margin Guides" />
                </rk:RibbonGroup>
            </rk:RibbonTab>
            <rk:RibbonTab x:Name="PrintPreviewTab" Header="Print Preview"
                          rk:Ribbon.CommandId="Writer.PrintPreview" IsModal="True" CanClose="True"
                          CloseButtonText="Close Print Preview" Visibility="Collapsed"
                          AutomationProperties.AutomationId="PrintPreviewTab" AutomationProperties.Name="Print Preview">
                <rk:RibbonGroup x:Name="PreviewLayoutGroup" Header="Preview Layout" rk:Ribbon.CommandId="Writer.View.Preview" rk:KeyTip.Keys="L"
                                Icon="{StaticResource Icon.WriterPrintPreview}"
                                AutomationProperties.AutomationId="PreviewGroup" AutomationProperties.Name="Preview Layout">
                    <rk:RibbonToggleButton x:Name="OnePageButton" Header="One Page" Size="Large"
                                           Icon="{StaticResource Icon.WriterOnePage}" LargeIcon="{StaticResource Icon.WriterOnePage}"
                                           Click="OnOnePageClick" rk:Ribbon.CommandId="Writer.View.Preview.OnePage" rk:KeyTip.Keys="O"
                                           ScreenTipTitle="One Page" ScreenTipText="Show one preview page at the current zoom."
                                           AutomationProperties.AutomationId="PreviewOnePage" AutomationProperties.Name="One Page" />
                    <rk:RibbonToggleButton x:Name="TwoPagesButton" Header="Two Pages" Size="Large"
                                           Icon="{StaticResource Icon.WriterTwoPages}" LargeIcon="{StaticResource Icon.WriterTwoPages}"
                                           Click="OnTwoPagesClick" rk:Ribbon.CommandId="Writer.View.Preview.TwoPages" rk:KeyTip.Keys="T"
                                           ScreenTipTitle="Two Pages" ScreenTipText="Fit up to two adjacent preview pages."
                                           AutomationProperties.AutomationId="PreviewTwoPages" AutomationProperties.Name="Two Pages" />
                    <rk:RibbonToggleButton x:Name="PageWidthButton" Header="Page Width" Size="Large"
                                           Icon="{StaticResource Icon.WriterPageWidth}" LargeIcon="{StaticResource Icon.WriterPageWidth}"
                                           Click="OnPageWidthClick" rk:Ribbon.CommandId="Writer.View.Preview.PageWidth" rk:KeyTip.Keys="W"
                                           ScreenTipTitle="Page Width" ScreenTipText="Fit the preview page width to the available viewport."
                                           AutomationProperties.AutomationId="PreviewPageWidth" AutomationProperties.Name="Page Width" />
                </rk:RibbonGroup>
                <rk:RibbonGroup x:Name="PreviewNavigationGroup" Header="Navigation" rk:Ribbon.CommandId="Writer.View.Preview.Navigation" rk:KeyTip.Keys="N"
                                Icon="{StaticResource Icon.WriterNextPage}"
                                AutomationProperties.AutomationId="PreviewNavigationGroup" AutomationProperties.Name="Preview Navigation">
                    <rk:RibbonButton x:Name="PreviousPageButton" Header="Previous Page" Size="Large"
                                     Icon="{StaticResource Icon.WriterPreviousPage}" LargeIcon="{StaticResource Icon.WriterPreviousPage}"
                                     Click="OnPreviousPageClick" rk:Ribbon.CommandId="Writer.View.Preview.Previous" rk:KeyTip.Keys="B"
                                     ScreenTipTitle="Previous Page" ScreenTipText="Move to the previous preview page."
                                     AutomationProperties.AutomationId="PreviewPreviousPage" AutomationProperties.Name="Previous Page" />
                    <rk:RibbonButton x:Name="NextPageButton" Header="Next Page" Size="Large"
                                     Icon="{StaticResource Icon.WriterNextPage}" LargeIcon="{StaticResource Icon.WriterNextPage}"
                                     Click="OnNextPageClick" rk:Ribbon.CommandId="Writer.View.Preview.Next" rk:KeyTip.Keys="N"
                                     ScreenTipTitle="Next Page" ScreenTipText="Move to the next preview page."
                                     AutomationProperties.AutomationId="PreviewNextPage" AutomationProperties.Name="Next Page" />
                </rk:RibbonGroup>
                <rk:RibbonGroup x:Name="PreviewZoomGroup" Header="Zoom" rk:Ribbon.CommandId="Writer.PrintPreview.Zoom" rk:KeyTip.Keys="Z"
                                Icon="{StaticResource Icon.WriterZoomReset}"
                                AutomationProperties.AutomationId="PreviewZoomGroup" AutomationProperties.Name="Preview Zoom">
                    <rk:RibbonButton x:Name="PreviewZoomOutButton" Header="Zoom Out" Size="Large"
                                     Icon="{StaticResource Icon.WriterZoomOut}" LargeIcon="{StaticResource Icon.WriterZoomOut}"
                                     rk:Ribbon.CommandId="Writer.Home.Editing.ZoomOut" rk:KeyTip.Keys="ZO"
                                     ScreenTipTitle="Zoom Out" ScreenTipText="Reduce preview zoom by ten percent."
                                     AutomationProperties.AutomationId="PreviewZoomOut" AutomationProperties.Name="Zoom Out" />
                    <rk:RibbonButton x:Name="PreviewZoomResetButton" Header="100%" Size="Large"
                                     Icon="{StaticResource Icon.WriterZoomReset}" LargeIcon="{StaticResource Icon.WriterZoomReset}"
                                     rk:Ribbon.CommandId="Writer.Home.Editing.ZoomReset" rk:KeyTip.Keys="ZR"
                                     ScreenTipTitle="Reset Zoom" ScreenTipText="Restore preview zoom to 100 percent."
                                     AutomationProperties.AutomationId="PreviewZoomReset" AutomationProperties.Name="Reset Zoom" />
                    <rk:RibbonButton x:Name="PreviewZoomInButton" Header="Zoom In" Size="Large"
                                     Icon="{StaticResource Icon.WriterZoomIn}" LargeIcon="{StaticResource Icon.WriterZoomIn}"
                                     rk:Ribbon.CommandId="Writer.Home.Editing.ZoomIn" rk:KeyTip.Keys="ZI"
                                     ScreenTipTitle="Zoom In" ScreenTipText="Increase preview zoom by ten percent."
                                     AutomationProperties.AutomationId="PreviewZoomIn" AutomationProperties.Name="Zoom In" />
                </rk:RibbonGroup>
            </rk:RibbonTab>
        </rk:Ribbon>
        <StatusBar DockPanel.Dock="Bottom" Padding="12,3"
                   Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                   BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                   BorderThickness="0,1,0,0"
                   AutomationProperties.AutomationId="Status" AutomationProperties.Name="Status">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}">
                    <TextBlock x:Name="StatusMessage" Text="{Binding StatusText}" FontWeight="SemiBold" />
                    <TextBlock Text="·" Margin="12,0" Opacity="0.65" />
                    <TextBlock x:Name="StatisticsText" Text="0 words, 0 characters" AutomationProperties.AutomationId="DocumentStatistics" AutomationProperties.Name="Document statistics" />
                    <TextBlock Text="·" Margin="12,0" Opacity="0.65" />
                    <TextBlock x:Name="SpellCheckStatusText" Text="Spelling off" AutomationProperties.AutomationId="SpellingStatus" AutomationProperties.Name="Spelling status" />
                    <TextBlock x:Name="PreviewPageText" Text="" Margin="12,0,0,0"
                               AutomationProperties.AutomationId="PreviewPageStatus" AutomationProperties.Name="Preview page position" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StatusZoomOutButton" Content="−" Style="{StaticResource StatusZoomButtonStyle}" Click="OnStatusZoomOutClick"
                            AutomationProperties.AutomationId="StatusZoomOut" AutomationProperties.Name="Zoom Out" />
                    <TextBlock x:Name="ZoomText" Text="100%" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="ZoomStatus" AutomationProperties.Name="Zoom" />
                    <Button x:Name="StatusZoomInButton" Content="+" Style="{StaticResource StatusZoomButtonStyle}" Click="OnStatusZoomInClick"
                            AutomationProperties.AutomationId="StatusZoomIn" AutomationProperties.Name="Zoom In" />
                </StackPanel>
            </Grid>
        </StatusBar>
        <Grid x:Name="DocumentPresentationHost">
            <editing:WriterEditorSurface x:Name="EditorSurface"
                                         ViewMode="Paper"
                                         Focusable="False"
                                         Background="{DynamicResource RibbonKit.Brushes.Control.CompanionBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="EditorViewport" Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              Background="{DynamicResource RibbonKit.Brushes.Control.CompanionBackground}">
                    <Border x:Name="PaperCanvas"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}">
                        <RichTextBox x:Name="DocumentEditor"
                                     Background="White"
                                     BorderThickness="0"
                                     Padding="28,22"
                                     FontFamily="Segoe UI"
                                     FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="DocumentEditor"
                                     AutomationProperties.Name="Document editor">
                            <FlowDocument PagePadding="0" />
                        </RichTextBox>
                    </Border>
                </ScrollViewer>
                <editing:WriterMarginGuide x:Name="MarginGuide" Grid.Row="1" Panel.ZIndex="20"
                                           IsHitTestVisible="False"
                                           AutomationProperties.AutomationId="MarginGuide"
                                           AutomationProperties.Name="Non-printing margin guide" />
                <Border x:Name="EditorTopSeparator" Grid.Row="1" Panel.ZIndex="25"
                        Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                        Background="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                        AutomationProperties.AutomationId="EditorTopSeparator"
                        AutomationProperties.Name="Ribbon and document separator">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=HorizontalRuler}"
                                             Value="Collapsed">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <editing:WriterRuler x:Name="HorizontalRuler" Grid.Row="0" Panel.ZIndex="30"
                                     FlowDirection="LeftToRight"
                                     AutomationProperties.AutomationId="WriterRuler"
                                     AutomationProperties.Name="Horizontal ruler" />
            </editing:WriterEditorSurface>
            <preview:WriterDocumentPreviewView x:Name="PreviewView" Visibility="Collapsed"
                                               AutomationProperties.AutomationId="DocumentPreview"
                                               AutomationProperties.Name="Print layout preview" />
            <Border x:Name="PreviewTopSeparator" Panel.ZIndex="25"
                    Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                    Background="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                    Visibility="{Binding Visibility, ElementName=PreviewView}"
                    AutomationProperties.AutomationId="PreviewTopSeparator"
                    AutomationProperties.Name="Ribbon and print preview separator" />
            <Border x:Name="PreviewPendingOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20,12" Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                    AutomationProperties.AutomationId="PreviewUpdating" AutomationProperties.Name="Updating preview">
                <TextBlock Text="Updating preview…" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
            </Border>
        </Grid>
    </DockPanel>
</rk:RibbonWindow>
