<rk:RibbonWindow x:Class="RibbonKit.Writer.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rk="urn:ribbonkit"
                 xmlns:editing="clr-namespace:RibbonKit.Writer.Editing"
                 xmlns:preview="clr-namespace:RibbonKit.Writer.Preview"
                 Title="{Binding Title}"
                 Width="1100"
                 Height="720"
                 MinWidth="480"
                 MinHeight="320"
                 WindowStartupLocation="CenterScreen"
                 UseLayoutRounding="True">
    <rk:RibbonWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RecentDocumentButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Margin" Value="0,2,0,2" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush"
                                            Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush"
                                            Value="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush"
                                            Value="{DynamicResource RibbonKit.Brushes.Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StatusZoomButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="MinWidth" Value="25" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
            </Style>
            <Style x:Key="BackstagePrimaryActionButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="210" />
                <Setter Property="Height" Value="48" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.Dialog.PrimaryBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Dialog.PrimaryBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonKit.Brushes.ApplicationButton.HoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonKit.Brushes.ApplicationButton.PressedBackground}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BackstageSecondaryActionButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="210" />
                <Setter Property="Height" Value="38" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="15,0" />
                <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Accent}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NewProfileCardStyle" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="220" />
                <Setter Property="MinHeight" Value="224" />
                <Setter Property="Margin" Value="0,0,14,14" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush"
                                            Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush"
                                            Value="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush"
                                            Value="{DynamicResource RibbonKit.Brushes.Accent}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="RecentDocumentTemplate">
                <Grid MaxWidth="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="36" Padding="7,6"
                            Background="{DynamicResource RibbonKit.Brushes.Control.CompanionBackground}"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.SmallControlCornerRadius}"
                            VerticalAlignment="Center">
                        <Image Source="{StaticResource Icon.WriterDocument}"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FolderPath}"
                                   Margin="0,2,0,0" FontSize="11"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FormatLabel}"
                                   Margin="0,3,0,0" FontSize="10"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding LastUsedLabel}"
                               Margin="8,0,0,0" MaxWidth="140" FontSize="10"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </rk:RibbonWindow.Resources>
    <rk:RibbonWindow.InputBindings>
        <KeyBinding x:Name="NewKeyBinding" Key="N" Modifiers="Control" />
        <KeyBinding x:Name="OpenKeyBinding" Key="O" Modifiers="Control" />
        <KeyBinding x:Name="SaveKeyBinding" Key="S" Modifiers="Control" />
        <KeyBinding x:Name="SaveAsKeyBinding" Key="S" Modifiers="Control+Shift" />
        <KeyBinding x:Name="UndoKeyBinding" Key="Z" Modifiers="Control" />
        <KeyBinding x:Name="RedoKeyBinding" Key="Y" Modifiers="Control" />
        <KeyBinding x:Name="CutKeyBinding" Key="X" Modifiers="Control" />
        <KeyBinding x:Name="CopyKeyBinding" Key="C" Modifiers="Control" />
        <KeyBinding x:Name="PasteKeyBinding" Key="V" Modifiers="Control" />
        <KeyBinding x:Name="BoldKeyBinding" Key="B" Modifiers="Control" />
        <KeyBinding x:Name="ItalicKeyBinding" Key="I" Modifiers="Control" />
        <KeyBinding x:Name="UnderlineKeyBinding" Key="U" Modifiers="Control" />
        <KeyBinding x:Name="FindKeyBinding" Key="F" Modifiers="Control" />
        <KeyBinding x:Name="ReplaceKeyBinding" Key="H" Modifiers="Control" />
    </rk:RibbonWindow.InputBindings>
    <DockPanel AutomationProperties.AutomationId="WriterWindow">
        <rk:Ribbon x:Name="MainRibbon" DockPanel.Dock="Top" QuickAccessPosition="BelowRibbon"
                   ModalEntered="OnRibbonModalEntered" ModalExited="OnRibbonModalExited"
                   AutomationProperties.AutomationId="MainRibbon" AutomationProperties.Name="Main ribbon">
            <rk:Ribbon.QuickAccessItems>
                <rk:RibbonButton x:Name="QatSave" Header="Save" Size="Small" Icon="{StaticResource Icon.WriterSave}"
                                 rk:Ribbon.CommandId="Writer.Save" rk:KeyTip.Keys="QS"
                                 ScreenTipTitle="Save" ScreenTipText="Save the current document (Ctrl+S)."
                                 AutomationProperties.AutomationId="QatSave" AutomationProperties.Name="Save" />
                <rk:RibbonButton x:Name="QatUndo" Header="Undo" Size="Small" Icon="{StaticResource Icon.WriterUndo}"
                                 rk:Ribbon.CommandId="Writer.Undo" rk:KeyTip.Keys="QU"
                                 ScreenTipTitle="Undo" ScreenTipText="Undo the last editing action (Ctrl+Z)."
                                 AutomationProperties.AutomationId="QatUndo" AutomationProperties.Name="Undo" />
                <rk:RibbonButton x:Name="QatRedo" Header="Redo" Size="Small" Icon="{StaticResource Icon.WriterRedo}"
                                 rk:Ribbon.CommandId="Writer.Redo" rk:KeyTip.Keys="QR"
                                 ScreenTipTitle="Redo" ScreenTipText="Redo the last undone editing action (Ctrl+Y)."
                                 AutomationProperties.AutomationId="QatRedo" AutomationProperties.Name="Redo" />
            </rk:Ribbon.QuickAccessItems>
            <rk:Ribbon.Backstage>
                <rk:Backstage x:Name="WriterBackstage" Design="Modern"
                              SelectionChanged="OnBackstageSelectionChanged"
                              AutomationProperties.AutomationId="WriterBackstage" AutomationProperties.Name="File">
                    <rk:BackstageTabItem Header="Home" rk:KeyTip.Keys="H">
                        <StackPanel Margin="32" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RecentPage">
                            <TextBlock Text="Recent documents" FontSize="28" FontWeight="Light"
                                       Foreground="{DynamicResource RibbonKit.Brushes.Accent}" Margin="0,0,0,10" />
                            <TextBlock Text="Open a document to continue where you left off. TXT keeps characters only; RTF preserves representative formatting; advanced content is best effort."
                                       TextWrapping="Wrap" MaxWidth="700"
                                       Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" Margin="0,0,0,18" />
                            <ItemsControl x:Name="RecentList" ItemsSource="{Binding RecentEntries}"
                                          AutomationProperties.AutomationId="RecentList" AutomationProperties.Name="Recent documents">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RecentDocumentButtonStyle}"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource RecentDocumentTemplate}"
                                                Click="OnRecentItemClick"
                                                Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.AutomationId="{Binding Path}"
                                                AutomationProperties.Name="{Binding FileName}"
                                                AutomationProperties.HelpText="{Binding Path}"
                                                ToolTip="{Binding Path}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="RecentEmptyState" Margin="0,14,0,0" Padding="24,26"
                                    MaxWidth="700" HorizontalAlignment="Stretch"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    AutomationProperties.AutomationId="RecentEmptyState"
                                    AutomationProperties.Name="No recent documents">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentEntries.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Image Source="{StaticResource Icon.WriterDocument}" Width="28" Height="28"
                                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="No recent documents" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Open or save a document and it will appear here."
                                               Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </rk:BackstageTabItem>
                    <rk:BackstageTabItem x:Name="NewBackstageTab" Header="New" rk:Ribbon.CommandId="Writer.New" rk:KeyTip.Keys="N"
                                         AutomationProperties.AutomationId="FileNew" AutomationProperties.Name="New">
                        <Grid x:Name="NewProfilePage" Margin="32" HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="NewProfilePage"
                              AutomationProperties.Name="New document profiles">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Create a new document" FontSize="28" FontWeight="Light"
                                       Foreground="{DynamicResource RibbonKit.Brushes.Accent}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="Choose the profile that matches the fidelity and compatibility you need."
                                       TextWrapping="Wrap" MaxWidth="760"
                                       Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" Margin="0,0,0,22" />
                            <ScrollViewer x:Name="NewProfileCardsScrollViewer" Grid.Row="2"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="False"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          AutomationProperties.AutomationId="NewProfileCardsScrollViewer"
                                          AutomationProperties.Name="New document profile cards">
                                <WrapPanel x:Name="NewProfileCardsPanel" Orientation="Horizontal"
                                           HorizontalAlignment="Left">
                                <Button x:Name="PlainTextCard" Tag="PlainText" Style="{StaticResource NewProfileCardStyle}"
                                        Click="OnNewProfileCardClick" Command="{Binding NewCommand}"
                                        CommandParameter="PlainText" Focusable="True" IsTabStop="True"
                                        rk:KeyTip.Keys="1"
                                        AutomationProperties.AutomationId="NewPlainTextCard"
                                        AutomationProperties.Name="Plain Text"
                                        AutomationProperties.HelpText="Create an untitled Plain Text document. Characters are preserved; formatting and page settings are not.">
                                    <StackPanel>
                                        <Image Source="{StaticResource Icon.WriterProfilePlainText}" Width="64" Height="76"
                                               HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,16" />
                                        <TextBlock Text="Plain Text" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                        <TextBlock Text="Characters only" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                        <TextBlock Text="Best for lightweight .txt files. Preview and print remain available."
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RichTextCard" Tag="RichText" Style="{StaticResource NewProfileCardStyle}"
                                        Click="OnNewProfileCardClick" Command="{Binding NewCommand}"
                                        CommandParameter="RichText" Focusable="True" IsTabStop="True"
                                        rk:KeyTip.Keys="2"
                                        AutomationProperties.AutomationId="NewRichTextCard"
                                        AutomationProperties.Name="Rich Text"
                                        AutomationProperties.HelpText="Create an untitled Rich Text document with interoperable formatting.">
                                    <StackPanel>
                                        <Image Source="{StaticResource Icon.WriterProfileRichText}" Width="64" Height="76"
                                               HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,16" />
                                        <TextBlock Text="Rich Text" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                        <TextBlock Text="Interoperable formatting" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                        <TextBlock Text="Best for .rtf exchange while keeping common text formatting."
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RibbonKitWriterCard" Tag="RibbonKitWriter" Style="{StaticResource NewProfileCardStyle}"
                                        Click="OnNewProfileCardClick" Command="{Binding NewCommand}"
                                        CommandParameter="RibbonKitWriter" Focusable="True" IsTabStop="True"
                                        rk:KeyTip.Keys="3"
                                        AutomationProperties.AutomationId="NewRibbonKitWriterCard"
                                        AutomationProperties.Name="RibbonKit Writer"
                                        AutomationProperties.HelpText="Create an untitled native RibbonKit Writer document with page settings and full supported fidelity.">
                                    <StackPanel>
                                        <Image Source="{StaticResource Icon.WriterProfileNative}" Width="64" Height="76"
                                               HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,16" />
                                        <TextBlock Text="RibbonKit Writer" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                        <TextBlock Text="Native Writer fidelity" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                        <TextBlock Text="Best for .rkw files with supported page settings and formatting."
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                    </StackPanel>
                                </Button>
                                </WrapPanel>
                            </ScrollViewer>
                        </Grid>
                    </rk:BackstageTabItem>
                    <rk:BackstageTabItem Header="Open" IsButton="True" rk:Ribbon.CommandId="Writer.Open" rk:KeyTip.Keys="O" Click="OnBackstageAction" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="FileOpen" AutomationProperties.Name="Open" />
                    <rk:BackstageTabItem Header="Save" IsButton="True" rk:Ribbon.CommandId="Writer.Save" rk:KeyTip.Keys="S" Click="OnBackstageAction" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="FileSave" AutomationProperties.Name="Save" />
                    <rk:BackstageTabItem Header="Save As" IsButton="True" rk:Ribbon.CommandId="Writer.SaveAs" rk:KeyTip.Keys="A" Click="OnBackstageAction" Command="{Binding SaveAsCommand}" AutomationProperties.AutomationId="FileSaveAs" AutomationProperties.Name="Save As" />
                    <rk:BackstageTabItem x:Name="PrintBackstageTab" Header="Print" rk:KeyTip.Keys="P"
                                         AutomationProperties.AutomationId="FilePrintPage" AutomationProperties.Name="Print and page setup">
                        <Grid Margin="32" MaxWidth="820" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Print" FontSize="28" FontWeight="Light"
                                           Foreground="{DynamicResource RibbonKit.Brushes.Accent}" Margin="0,0,0,16" />
                                <rk:RibbonButton x:Name="BackstagePrintButton" Style="{StaticResource BackstagePrimaryActionButtonStyle}"
                                                 Margin="0,0,0,10" Click="OnPrintClick"
                                                 rk:Ribbon.CommandId="Writer.Print" rk:KeyTip.Keys="P"
                                                 ScreenTipTitle="Print" ScreenTipText="Print the exact current preview paginator after checking printer limits."
                                                 AutomationProperties.AutomationId="BackstagePrint"
                                                 AutomationProperties.Name="Print document">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{StaticResource Icon.WriterPrint}" Width="24" Height="24" Margin="0,0,12,0" />
                                        <TextBlock Text="Print…" VerticalAlignment="Center" />
                                    </StackPanel>
                                </rk:RibbonButton>
                                <rk:RibbonButton x:Name="BackstagePreviewButton" Style="{StaticResource BackstageSecondaryActionButtonStyle}"
                                                 Click="OnBackstagePreviewClick"
                                                 rk:Ribbon.CommandId="Writer.View.PrintPreview" rk:KeyTip.Keys="V"
                                                 ScreenTipTitle="Print Preview" ScreenTipText="Close Backstage and show stable fixed preview pages."
                                                 AutomationProperties.AutomationId="BackstagePrintPreview"
                                                 AutomationProperties.Name="Open print preview">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{StaticResource Icon.WriterPrintPreview}" Width="20" Height="20" Margin="0,0,12,0" />
                                        <TextBlock Text="Open print preview" VerticalAlignment="Center" />
                                    </StackPanel>
                                </rk:RibbonButton>
                            </StackPanel>
                            <Border Grid.Column="1" Margin="32,0,0,0" Padding="24"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
