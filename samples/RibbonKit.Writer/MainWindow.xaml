                    <Button x:Name="StatusZoomOutButton" Content="−" Style="{StaticResource StatusZoomButtonStyle}" Click="OnStatusZoomOutClick"
                            AutomationProperties.AutomationId="StatusZoomOut" AutomationProperties.Name="Zoom Out" />
                    <TextBlock x:Name="ZoomText" Text="100%" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="ZoomStatus" AutomationProperties.Name="Zoom" />
                    <Button x:Name="StatusZoomInButton" Content="+" Style="{StaticResource StatusZoomButtonStyle}" Click="OnStatusZoomInClick"
                            AutomationProperties.AutomationId="StatusZoomIn" AutomationProperties.Name="Zoom In" />
                </StackPanel>
            </Grid>
        </StatusBar>
        <Grid x:Name="DocumentPresentationHost">
            <editing:WriterEditorSurface x:Name="EditorSurface"
                                         ViewMode="Paper"
                                         Focusable="False"
                                         Background="{DynamicResource RibbonKit.Brushes.Control.CompanionBackground}">
                <ScrollViewer x:Name="EditorViewport"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              Background="{DynamicResource RibbonKit.Brushes.Control.CompanionBackground}">
                    <Border x:Name="PaperCanvas"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}">
                        <RichTextBox x:Name="DocumentEditor"
                                     Background="White"
                                     BorderThickness="0"
                                     Padding="28,22"
                                     FontFamily="Segoe UI"
                                     FontSize="13"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="DocumentEditor"
                                     AutomationProperties.Name="Document editor">
                            <FlowDocument PagePadding="0" />
                        </RichTextBox>
                    </Border>
                </ScrollViewer>
            </editing:WriterEditorSurface>
            <preview:WriterDocumentPreviewView x:Name="PreviewView" Visibility="Collapsed"
                                               AutomationProperties.AutomationId="DocumentPreview"
                                               AutomationProperties.Name="Print layout preview" />
            <Border x:Name="PreviewPendingOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20,12" Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                    AutomationProperties.AutomationId="PreviewUpdating" AutomationProperties.Name="Updating preview">
                <TextBlock Text="Updating preview…" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
            </Border>
        </Grid>
    </DockPanel>
</rk:RibbonWindow>
