<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RibbonKit.Writer</RootNamespace>
    <AssemblyName>RibbonKit.Writer</AssemblyName>
    <Product>RibbonKit Writer</Product>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Writer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RibbonKit\RibbonKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Writer.ico" />
  </ItemGroup>

</Project>
