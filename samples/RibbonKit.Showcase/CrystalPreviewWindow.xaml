<rk:RibbonWindow x:Class="RibbonKit.Showcase.CrystalPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rk="urn:ribbonkit"
                 xmlns:local="clr-namespace:RibbonKit.Showcase"
                 Title="Crystal — RibbonKit material study"
                 Icon="Assets/RibbonKit.ico"
                 Width="1080" Height="720" MinWidth="420" MinHeight="480"
                 WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
                 Background="{DynamicResource RibbonKit.Brushes.Window.Background}">
    <rk:RibbonWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Window scope keeps this study independent of Showcase theme/accent preferences. -->
                <ResourceDictionary Source="/RibbonKit;component/Themes/Tokens.Office2024.xaml" />
                <ResourceDictionary Source="Themes/Crystal.Light.xaml" />
                <ResourceDictionary Source="Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </rk:RibbonWindow.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,12" Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}">
            <TextBlock x:Name="StatusText" Text="Ready · Press Alt for key labels, open Arrange, or compare with Office 2024."
                       Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
        </Border>
        <rk:Ribbon x:Name="PreviewRibbon" DockPanel.Dock="Top" QuickAccessPosition="BelowRibbon">
            <rk:Ribbon.ApplicationMenu>
                <rk:RibbonApplicationMenu x:Name="CrystalFileMenu">
                    <rk:RibbonApplicationMenu.DefaultContent>
                        <StackPanel Margin="12">
                            <TextBlock Text="Recent documents" FontWeight="SemiBold" Margin="4,2,0,10"
                                       Foreground="{DynamicResource RibbonKit.Brushes.ApplicationMenu.HeadingForeground}" />
                            <rk:RibbonApplicationMenuPaneItem Content="A calmer workspace" Description="Crystal preview document" Click="OnApplicationMenuCommand" />
                            <rk:RibbonApplicationMenuPaneItem Content="Design notes" Description="Surface and color studies" Click="OnApplicationMenuCommand" />
                            <rk:RibbonApplicationMenuPaneItem Content="Meeting notes" Click="OnApplicationMenuCommand" />
                        </StackPanel>
                    </rk:RibbonApplicationMenu.DefaultContent>
                    <rk:RibbonApplicationMenuItem Header="New" Icon="{StaticResource Icon.Style}" Click="OnApplicationMenuCommand" />
                    <rk:RibbonApplicationMenuItem Header="Open" Icon="{StaticResource Icon.Table}" Click="OnApplicationMenuCommand" />
                    <rk:RibbonApplicationMenuItem Header="Save" Icon="{StaticResource Icon.Save}" Click="OnApplicationMenuCommand" />
                    <rk:RibbonApplicationMenuItem x:Name="CrystalSaveAsMenuItem" Header="Save as" IsSplit="True"
                                                  Icon="{StaticResource Icon.Save}" PaneHeader="Save a copy" Click="OnApplicationMenuCommand">
                        <StackPanel Margin="8">
                            <rk:RibbonApplicationMenuPaneItem Content="Document" Description="Keep the document formatting." Icon="{StaticResource Icon.Style}" Click="OnApplicationMenuCommand" />
                            <rk:RibbonApplicationMenuPaneItem Content="Plain text" Description="Save only the text content." Icon="{StaticResource Icon.Font}" Click="OnApplicationMenuCommand" />
                        </StackPanel>
                    </rk:RibbonApplicationMenuItem>
                    <rk:RibbonApplicationMenuSeparator />
                    <rk:RibbonApplicationMenuItem x:Name="CrystalPrintMenuItem" Header="Print" IsSplit="False"
                                                  Icon="{StaticResource Icon.Print}" PaneHeader="Print options">
                        <StackPanel Margin="8">
                            <rk:RibbonApplicationMenuPaneItem Content="Print preview" Description="Review the page before printing." Icon="{StaticResource Icon.Print}" Click="OnApplicationMenuCommand" />
                            <rk:RibbonApplicationMenuPaneItem Content="Quick print" IsEnabled="False" Description="Unavailable in this preview." Icon="{StaticResource Icon.Print}" />
                        </StackPanel>
                    </rk:RibbonApplicationMenuItem>
                    <rk:RibbonApplicationMenuItem Header="Share" Icon="{StaticResource Icon.Account}" IsEnabled="False" />
                    <rk:RibbonApplicationMenu.FooterContent>
                        <StackPanel Orientation="Horizontal">
                            <rk:RibbonApplicationMenuButton Content="Backstage" Click="OnUseBackstage" />
                            <rk:RibbonApplicationMenuButton Content="Close menu" Click="OnCloseApplicationMenu" />
                        </StackPanel>
                    </rk:RibbonApplicationMenu.FooterContent>
                </rk:RibbonApplicationMenu>
            </rk:Ribbon.ApplicationMenu>
            <rk:Ribbon.MessageBar>
                <rk:RibbonMessageBar x:Name="CrystalMessageBar">
                    <rk:RibbonMessage x:Name="CrystalProtectedMessage" IsOpen="False"
                                      Title="Protected view" Message="This sample is read-only until you enable editing."
                                      ActionContent="Enable editing" ActionClick="OnMessageAction" />
                    <rk:RibbonMessage x:Name="CrystalSecurityMessage" IsOpen="False"
                                      Title="Security notice" Message="Macros are disabled in this sample document."
                                      ActionContent="Got it" ActionClick="OnMessageAction" />
                </rk:RibbonMessageBar>
            </rk:Ribbon.MessageBar>
            <rk:Ribbon.QuickAccessItems>
                <rk:RibbonButton Header="Paste" Size="Small" Icon="{StaticResource Icon.Paste}" Click="OnPreviewCommand" />
                <rk:RibbonButton Header="Copy" Size="Small" Icon="{StaticResource Icon.Copy}" Click="OnPreviewCommand" />
                <rk:RibbonButton Header="Select" Size="Small" Icon="{StaticResource Icon.Select}" Click="OnPreviewCommand" />
            </rk:Ribbon.QuickAccessItems>
            <rk:Ribbon.Backstage>
                <rk:Backstage x:Name="CrystalBackstage" Design="Modern" SelectedIndex="0">
                    <rk:BackstageTabItem Header="Overview" Icon="{StaticResource Icon.Style}">
                        <ScrollViewer x:Name="CrystalOverviewScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,0,4,16">
                                <TextBlock Text="Space to think." FontSize="36" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                <TextBlock Text="Your document, with a little room to breathe." Margin="0,10,0,28" FontSize="15" TextWrapping="Wrap"
                                           Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                <Border Padding="28" CornerRadius="24"
                                        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1"
                                        Effect="{DynamicResource RibbonKit.Effects.ContentShadow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="CURRENT DOCUMENT" FontSize="11" Foreground="{DynamicResource RibbonKit.Brushes.Accent}" />
                                        <TextBlock x:Name="BackstageDocumentTitle" Margin="0,10,0,16" FontSize="26" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                        <TextBlock Text="Pick up where you left off."
                                                   TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                        <Button Content="Continue editing  →" Margin="0,24,0,0" HorizontalAlignment="Left"
                                                Style="{DynamicResource Crystal.Backstage.Action}" Click="OnReturnToDocument" />
                                    </StackPanel>
                                        <Border Grid.Column="1" Width="88" Height="120" VerticalAlignment="Center" CornerRadius="10"
                                                Background="{DynamicResource RibbonKit.Brushes.Tab.SelectedBackground}"
                                                BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" BorderThickness="1"
                                                IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><RotateTransform Angle="-5" /></Border.RenderTransform>
                                            <StackPanel Margin="16,24">
                                                <Border Height="5" Width="26" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource RibbonKit.Brushes.Accent}" Opacity="0.5" />
                                                <Border Height="3" Margin="0,14,0,0" Background="{DynamicResource RibbonKit.Brushes.Text.Secondary}" Opacity="0.18" />
                                                <Border Height="3" Margin="0,8,0,0" Background="{DynamicResource RibbonKit.Brushes.Text.Secondary}" Opacity="0.18" />
                                                <Border Height="3" Margin="0,8,16,0" Background="{DynamicResource RibbonKit.Brushes.Text.Secondary}" Opacity="0.18" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Margin="0,18,0,0" Padding="22,18" CornerRadius="18"
                                        Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1">
                                    <TextBlock Text="A space that feels like yours. Explore Appearance to change the glass tint."
                                               TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </rk:BackstageTabItem>
                    <rk:BackstageTabItem Header="Appearance" Icon="{StaticResource Icon.Palette}">
                        <ScrollViewer x:Name="CrystalAppearanceScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,0,4,16">
                                <TextBlock Text="Make it yours." FontSize="36" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                <TextBlock Text="A little color, the same clear glass." Margin="0,10,0,28" FontSize="15"
                                           TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                <Border Padding="28" CornerRadius="24"
                                        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Glass tint" FontSize="20" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                        <TextBlock Text="Choose a tint for this preview. Picture and table tabs keep their own colors."
                                                   Margin="0,10,0,18" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                        <rk:RibbonDropDownButton x:Name="BackstageAccentSelector" Header="Choose tint" Size="Medium"
                                                                 HorizontalAlignment="Left" Icon="{StaticResource Icon.Palette}">
                                            <rk:RibbonMenuItem Header="Blue (original)" Tag="#397CA9" Click="OnAccentSelected" />
                                            <rk:RibbonMenuItem Header="Green" Tag="#287E78" Click="OnAccentSelected" />
                                            <rk:RibbonMenuItem Header="Purple" Tag="#8659A5" Click="OnAccentSelected" />
                                            <rk:RibbonMenuItem Header="Amber" Tag="#AC731C" Click="OnAccentSelected" />
                                        </rk:RibbonDropDownButton>
                                        <TextBlock x:Name="BackstageTintLabel" Text="Current tint: Blue (original)" Margin="0,12,0,0"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                        <Separator Margin="0,24,0,20" Background="{DynamicResource RibbonKit.Brushes.Group.Separator}" />
                                        <TextBlock Text="File layout" FontSize="20" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                        <TextBlock Text="Keep familiar navigation at the side, or give your workspace a floating navigation bar."
                                                   Margin="0,10,0,18" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                        <rk:RibbonDropDownButton x:Name="BackstageLayoutSelector" Header="Choose layout" Size="Medium"
                                                                 HorizontalAlignment="Left" Icon="{StaticResource Icon.Select}">
                                            <rk:RibbonMenuItem Header="Glass sidebar" Tag="Sidebar" Click="OnBackstageLayoutSelected" />
                                            <rk:RibbonMenuItem Header="Floating workspace" Tag="Floating" Click="OnBackstageLayoutSelected" />
                                        </rk:RibbonDropDownButton>
                                        <TextBlock x:Name="BackstageLayoutLabel" Text="Current layout: Glass sidebar" Margin="0,12,0,0"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </rk:BackstageTabItem>
                    <rk:BackstageTabItem Header="About" Placement="Bottom" Icon="{StaticResource Icon.Palette}">
                        <ScrollViewer x:Name="CrystalAboutScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,0,4,16" MaxWidth="720" HorizontalAlignment="Left">
                                <TextBlock Text="Crystal" FontSize="36" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                <TextBlock Margin="0,16,0,0" FontSize="15" TextWrapping="Wrap"
                                           Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                           Text="A glass-inspired Office 2024 study, built around soft reflections, clear commands and a tint that feels like yours." />
                            </StackPanel>
                        </ScrollViewer>
                    </rk:BackstageTabItem>
                </rk:Backstage>
            </rk:Ribbon.Backstage>
            <rk:RibbonTab x:Name="HomeTab" Header="Home">
                <rk:RibbonGroup Header="Clipboard" Icon="{StaticResource Icon.Paste}">
                    <rk:RibbonButton Header="Paste" Size="Large" Icon="{StaticResource Icon.Paste}" Click="OnPreviewCommand" />
                    <StackPanel x:Name="CompactClipboard">
                        <rk:RibbonButton Header="Cut" Size="Medium" Icon="{StaticResource Icon.Cut}" Click="OnPreviewCommand" />
                        <rk:RibbonButton Header="Copy" Size="Medium" Icon="{StaticResource Icon.Copy}" Click="OnPreviewCommand" />
                        <rk:RibbonButton x:Name="UnavailableButton" Header="Unavailable" Size="Medium" Icon="{StaticResource Icon.Undo}" IsEnabled="False"
                                         ScreenTipTitle="Unavailable command" ScreenTipText="This preview command is disabled. Its description remains available while you hover." />
                    </StackPanel>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Text" Icon="{StaticResource Icon.Bold}">
                    <StackPanel x:Name="CompactText">
                        <rk:RibbonToggleButton Header="Bold" Size="Medium" Icon="{StaticResource Icon.Bold}" IsChecked="True" />
                        <rk:RibbonToggleButton Header="Italic" Size="Medium" Icon="{StaticResource Icon.Italic}" />
                        <rk:RibbonToggleButton Header="Underline" Size="Medium" Icon="{StaticResource Icon.Underline}" />
                    </StackPanel>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Layout" Icon="{StaticResource Icon.Select}">
                    <rk:RibbonDropDownButton x:Name="ArrangeButton" Header="Arrange" Size="Large" Icon="{StaticResource Icon.Select}"
                                             ScreenTipTitle="Arrange objects" ScreenTipText="Choose how an object sits on the page or in front of other objects.">
                        <rk:RibbonMenuItem Header="Bring to front" Click="OnPreviewCommand" />
                        <rk:RibbonMenuItem Header="Send to back" Click="OnPreviewCommand" />
                        <rk:RibbonMenuItem Header="Align to page" Click="OnPreviewCommand" />
                        <rk:RibbonMenuItem Header="Group objects" IsEnabled="False" />
                    </rk:RibbonDropDownButton>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Appearance" Icon="{StaticResource Icon.Palette}">
                    <rk:RibbonToggleButton x:Name="CompareToggle" Header="Compare 2024" Size="Large"
                                           Icon="{StaticResource Icon.Palette}"
                                           Checked="OnCompare" Unchecked="OnCompare"
                                           ScreenTipTitle="Compare the original palette"
                                           ScreenTipText="Switch this window between Crystal and Office 2024." />
                    <rk:RibbonToggleButton x:Name="DisableInputsToggle" Header="Disable inputs" Size="Large"
                                           Icon="{StaticResource Icon.Select}"
                                           Checked="OnDisableInputs" Unchecked="OnDisableInputs" />
                    <rk:RibbonDropDownButton x:Name="AccentSelector" Header="Glass tint" Size="Large"
                                             Icon="{StaticResource Icon.Palette}" ScreenTipTitle="Glass tint"
                                             ScreenTipText="Change the glass color throughout this preview. Contextual tabs keep their own colors.">
                        <rk:RibbonMenuItem Header="Blue (original)" Tag="#397CA9" Click="OnAccentSelected" />
                        <rk:RibbonMenuItem Header="Green" Tag="#287E78" Click="OnAccentSelected" />
                        <rk:RibbonMenuItem Header="Purple" Tag="#8659A5" Click="OnAccentSelected" />
                        <rk:RibbonMenuItem Header="Amber" Tag="#AC731C" Click="OnAccentSelected" />
                    </rk:RibbonDropDownButton>
                    <rk:RibbonButton Header="Customize" Size="Large" Icon="{StaticResource Icon.Style}"
                                     Click="OnCustomize" />
                    <rk:RibbonDropDownButton x:Name="PreviewControlsButton" Header="Preview controls" Size="Large" Icon="{StaticResource Icon.Select}">
                        <rk:RibbonMenuItem x:Name="ScrollPreviewToggle" Header="Show scroll arrows" Click="OnScrollPreview" />
                        <rk:RibbonMenuItem x:Name="BodyScrollPreviewToggle" Header="Keep Home groups expanded" Click="OnBodyScrollPreview" />
                        <rk:RibbonMenuItem x:Name="OverflowPreviewToggle" Header="Show QAT overflow" Click="OnOverflowPreview" />
                        <rk:RibbonMenuItem x:Name="MessagePreviewButton" Header="Show next message" Click="OnShowMessage" />
                        <rk:RibbonMenuItem x:Name="ApplicationMenuPreviewToggle" Header="Use application menu" Click="OnToggleApplicationMenu" />
                        <rk:RibbonMenuItem x:Name="DocumentFadeToggle" Header="Hide document edge fade" Click="OnDocumentFadeToggle" />
                        <rk:RibbonMenuItem x:Name="DocumentQatUnderlayToggle" Header="Keep document below QAT" Click="OnDocumentQatUnderlayToggle" />
                        <rk:RibbonMenuItem x:Name="DocumentLengthToggle" Header="Add scrolling text" Click="OnDocumentLengthToggle" />
                        <rk:RibbonMenuItem Header="Dismiss all messages" Click="OnDismissMessages" />
                    </rk:RibbonDropDownButton>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Inputs" Icon="{StaticResource Icon.Bold}">
                    <StackPanel>
                        <rk:RibbonComboBox x:Name="FontInput" Header="Font" InputWidth="150" Margin="0,1"
                                           SelectedIndex="0" SelectedValuePath="Content" AutomationProperties.Name="Preview font"
                                           ScreenTipTitle="Font" ScreenTipText="Choose the typeface for the sample paragraph.">
                            <ComboBoxItem Content="Segoe UI" />
                            <ComboBoxItem Content="Arial" />
                            <ComboBoxItem Content="Georgia" />
                            <ComboBoxItem Content="Times New Roman" />
                        </rk:RibbonComboBox>
                        <rk:RibbonComboBox x:Name="SizeInput" Header="Size" InputWidth="70" Margin="0,1"
                                           SelectedIndex="2" SelectedValuePath="Content" AutomationProperties.Name="Preview font size"
                                           ScreenTipTitle="Font size" ScreenTipText="Choose the text size for the sample paragraph.">
                            <ComboBoxItem Content="11" />
                            <ComboBoxItem Content="12" />
                            <ComboBoxItem Content="15" />
                            <ComboBoxItem Content="18" />
                            <ComboBoxItem Content="24" />
                        </rk:RibbonComboBox>
                        <rk:RibbonTextBox x:Name="TitleInput" Header="Title" InputWidth="150" Margin="0,1"
                                          Text="A calmer workspace" AutomationProperties.Name="Preview title"
                                          ScreenTipTitle="Document title" ScreenTipText="Edit the heading shown in your document and in the File panel." />
                    </StackPanel>
                </rk:RibbonGroup>
            </rk:RibbonTab>
            <rk:RibbonTab Header="Insert">
                <rk:RibbonGroup Header="Illustrations" Icon="{StaticResource Icon.Table}">
                    <rk:RibbonButton Header="Table" Size="Large" Icon="{StaticResource Icon.Table}" Click="OnPreviewCommand" />
                    <rk:RibbonButton Header="Select" Size="Large" Icon="{StaticResource Icon.Select}" Click="OnPreviewCommand" />
                </rk:RibbonGroup>
            </rk:RibbonTab>
            <rk:RibbonTab Header="Design">
                <rk:RibbonGroup Header="Document style" Icon="{StaticResource Icon.Style}">
                    <rk:InRibbonGallery x:Name="CrystalStylesGallery" Width="282" SelectedIndex="0"
                                        SelectionChanged="OnGalleryStyleSelected" AutomationProperties.Name="Document heading style">
                        <rk:InRibbonGallery.ToolTip>
                            <rk:RibbonScreenTip Title="Document style" Description="Expand the gallery to see every style. Choose a tile to update the document heading." />
                        </rk:InRibbonGallery.ToolTip>
                        <rk:RibbonGalleryItem Tag="Calm" AutomationProperties.Name="Calm">
                            <StackPanel Width="72"><TextBlock Text="Aa" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="Calm" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </rk:RibbonGalleryItem>
                        <rk:RibbonGalleryItem Tag="Heading" AutomationProperties.Name="Heading">
                            <StackPanel Width="72"><TextBlock Text="Aa" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Heading" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </rk:RibbonGalleryItem>
                        <rk:RibbonGalleryItem Tag="Title" AutomationProperties.Name="Title">
                            <StackPanel Width="72"><TextBlock Text="Aa" FontSize="18" FontWeight="Light" HorizontalAlignment="Center" /><TextBlock Text="Title" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </rk:RibbonGalleryItem>
                        <rk:RibbonGalleryItem Tag="Quote" AutomationProperties.Name="Quote">
                            <StackPanel Width="72"><TextBlock Text="Aa" FontSize="18" FontFamily="Georgia" FontStyle="Italic" HorizontalAlignment="Center" /><TextBlock Text="Quote" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </rk:RibbonGalleryItem>
                        <rk:RibbonGalleryItem Tag="Emphasis" AutomationProperties.Name="Emphasis">
                            <StackPanel Width="72"><TextBlock Text="Aa" FontSize="18" FontStyle="Italic" HorizontalAlignment="Center" /><TextBlock Text="Emphasis" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </rk:RibbonGalleryItem>
                        <rk:RibbonGalleryItem Tag="Classic" AutomationProperties.Name="Classic">
                            <StackPanel Width="72"><TextBlock Text="Aa" FontSize="18" FontFamily="Georgia" HorizontalAlignment="Center" /><TextBlock Text="Classic" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </rk:RibbonGalleryItem>
                    </rk:InRibbonGallery>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Options" Icon="{StaticResource Icon.Select}">
                    <StackPanel x:Name="CrystalOptionsPanel">
                        <rk:RibbonCheckBox Header="Show guides" IsChecked="True" />
                        <rk:RibbonCheckBox Header="Snap to grid" />
                        <rk:RibbonCheckBox Header="Mixed selection" IsThreeState="True" IsChecked="{x:Null}" />
                    </StackPanel>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Spacing" Icon="{StaticResource Icon.Select}">
                    <StackPanel x:Name="CrystalSpacingPanel">
                        <rk:RibbonRadioButton Header="Comfortable" GroupName="CrystalSpacing" IsChecked="True" />
                        <rk:RibbonRadioButton Header="Compact" GroupName="CrystalSpacing" />
                        <rk:RibbonRadioButton Header="Custom" GroupName="CrystalSpacing" />
                    </StackPanel>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Preview states" Icon="{StaticResource Icon.Select}">
                    <rk:RibbonToggleButton x:Name="DisableGalleryToggle" Header="Disable gallery" Size="Large" Icon="{StaticResource Icon.Select}"
                                           Checked="OnDisableGallery" Unchecked="OnDisableGallery" />
                    <rk:RibbonToggleButton x:Name="EnableOptionsToggle" Header="Enable options" Size="Large"
                                           Icon="{StaticResource Icon.Select}" IsChecked="True" />
                </rk:RibbonGroup>
            </rk:RibbonTab>
            <local:CrystalContextualTab x:Name="PictureTab" Header="Picture Format" IsContextual="True" ContextualColor="#287E78">
                <rk:RibbonGroup Header="Picture" Icon="{StaticResource Icon.Select}">
                    <rk:RibbonButton Header="Select" Size="Large" Icon="{StaticResource Icon.Select}" Click="OnPreviewCommand" />
                    <rk:RibbonButton Header="Change tint" Size="Large" Icon="{StaticResource Icon.Palette}" Click="OnChangeContextTint" />
                </rk:RibbonGroup>
            </local:CrystalContextualTab>
            <local:CrystalContextualTab x:Name="TableTab" Header="Table Design" IsContextual="True" ContextualColor="#8659A5">
                <rk:RibbonGroup Header="Table" Icon="{StaticResource Icon.Table}">
                    <rk:RibbonButton Header="Table" Size="Large" Icon="{StaticResource Icon.Table}" Click="OnPreviewCommand" />
                    <rk:RibbonButton Header="Change tint" Size="Large" Icon="{StaticResource Icon.Palette}" Click="OnChangeContextTint" />
                </rk:RibbonGroup>
            </local:CrystalContextualTab>
        </rk:Ribbon>
        <ScrollViewer x:Name="CrystalDocumentScroll" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,30,40,36" MaxWidth="920">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,24">
                    <TextBlock x:Name="PreviewLabel" Text="CRYSTAL / LIGHT STUDY" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource RibbonKit.Brushes.Accent}" />
                    <TextBlock Text="A little light. A little depth." FontSize="32" Margin="0,8,0,10"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                    <TextBlock Text="Soft edges and clear commands, with room for the work itself." FontSize="15"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                </StackPanel>
                <Border Grid.Row="1" Padding="32" CornerRadius="16"
                        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="DocumentHeading" Text="{Binding Text, ElementName=TitleInput}" FontSize="24" TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                        <TextBlock Margin="0,14,0,24" FontSize="{Binding SelectedValue, ElementName=SizeInput, FallbackValue=15}"
                                   FontFamily="{Binding SelectedValue, ElementName=FontInput, FallbackValue=Segoe UI}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                   Text="The ribbon carries a cool, luminous surface. Subtle borders catch the light, while the document keeps a steady, readable background. Color appears where it helps you see what is selected." />
                        <Separator Background="{DynamicResource RibbonKit.Brushes.Group.Separator}" />
                        <TextBlock Margin="0,20,0,0" Text="01   Surfaces &amp; light" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                        <TextBlock Margin="0,8,0,0" Text="An early visual study of layered gradients, soft reflections, and frosted menu glass."
                                   TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                        <ItemsControl x:Name="DocumentScrollDemo" Margin="0,24,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,16"
                                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
