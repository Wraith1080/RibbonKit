<rk:RibbonWindow x:Class="RibbonKit.Showcase.CrystalPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rk="urn:ribbonkit"
                 xmlns:local="clr-namespace:RibbonKit.Showcase"
                 Title="Crystal — RibbonKit material study"
                 Icon="Assets/RibbonKit.ico"
                 Width="1080" Height="720" MinWidth="680" MinHeight="480"
                 WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
                 Background="{DynamicResource RibbonKit.Brushes.Window.Background}">
    <rk:RibbonWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Window scope keeps this study independent of Showcase theme/accent preferences. -->
                <ResourceDictionary Source="/RibbonKit;component/Themes/Tokens.Office2024.xaml" />
                <ResourceDictionary Source="Themes/Crystal.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </rk:RibbonWindow.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,12" Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}">
            <TextBlock x:Name="StatusText" Text="Ready · Try the controls, open Arrange, or compare with Office 2024."
                       Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
        </Border>
        <rk:Ribbon x:Name="PreviewRibbon" DockPanel.Dock="Top" QuickAccessPosition="TabRow">
            <rk:Ribbon.Backstage>
                <rk:Backstage x:Name="CrystalBackstage" Design="Modern" SelectedIndex="0">
                    <rk:BackstageTabItem Header="Overview" Icon="{StaticResource Icon.Style}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,0,4,16">
                                <TextBlock Text="Space to think." FontSize="36" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                <TextBlock Text="Your document, with a little room to breathe." Margin="0,10,0,28" FontSize="15" TextWrapping="Wrap"
                                           Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                <Border Padding="28" CornerRadius="24"
                                        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1"
                                        Effect="{DynamicResource RibbonKit.Effects.ContentShadow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="CURRENT DOCUMENT" FontSize="11" Foreground="{DynamicResource RibbonKit.Brushes.Accent}" />
                                        <TextBlock x:Name="BackstageDocumentTitle" Margin="0,10,0,16" FontSize="26" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                        <TextBlock Text="Pick up where you left off."
                                                   TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                        <Button Content="Continue editing  →" Margin="0,24,0,0" HorizontalAlignment="Left"
                                                Style="{DynamicResource Crystal.Backstage.Action}" Click="OnReturnToDocument" />
                                    </StackPanel>
                                        <Border Grid.Column="1" Width="88" Height="120" VerticalAlignment="Center" CornerRadius="10"
                                                Background="{DynamicResource RibbonKit.Brushes.Tab.SelectedBackground}"
                                                BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" BorderThickness="1"
                                                IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><RotateTransform Angle="-5" /></Border.RenderTransform>
                                            <StackPanel Margin="16,24">
                                                <Border Height="5" Width="26" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource RibbonKit.Brushes.Accent}" Opacity="0.5" />
                                                <Border Height="3" Margin="0,14,0,0" Background="{DynamicResource RibbonKit.Brushes.Text.Secondary}" Opacity="0.18" />
                                                <Border Height="3" Margin="0,8,0,0" Background="{DynamicResource RibbonKit.Brushes.Text.Secondary}" Opacity="0.18" />
                                                <Border Height="3" Margin="0,8,16,0" Background="{DynamicResource RibbonKit.Brushes.Text.Secondary}" Opacity="0.18" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Margin="0,18,0,0" Padding="22,18" CornerRadius="18"
                                        Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1">
                                    <TextBlock Text="A space that feels like yours. Explore Appearance to change the glass tint."
                                               TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </rk:BackstageTabItem>
                    <rk:BackstageTabItem Header="Appearance" Icon="{StaticResource Icon.Palette}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,0,4,16">
                                <TextBlock Text="Make it yours." FontSize="36" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                <TextBlock Text="A little color, the same clear glass." Margin="0,10,0,28" FontSize="15"
                                           TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                <Border Padding="28" CornerRadius="24"
                                        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Glass tint" FontSize="20" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                        <TextBlock Text="Choose a tint for this preview. Picture and table tabs keep their own colors."
                                                   Margin="0,10,0,18" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                        <rk:RibbonDropDownButton x:Name="BackstageAccentSelector" Header="Choose tint" Size="Medium"
                                                                 HorizontalAlignment="Left" Icon="{StaticResource Icon.Palette}">
                                            <rk:RibbonMenuItem Header="Blue (original)" Tag="#397CA9" Click="OnAccentSelected" />
                                            <rk:RibbonMenuItem Header="Green" Tag="#287E78" Click="OnAccentSelected" />
                                            <rk:RibbonMenuItem Header="Purple" Tag="#8659A5" Click="OnAccentSelected" />
                                            <rk:RibbonMenuItem Header="Amber" Tag="#AC731C" Click="OnAccentSelected" />
                                        </rk:RibbonDropDownButton>
                                        <TextBlock x:Name="BackstageTintLabel" Text="Current tint: Blue (original)" Margin="0,12,0,0"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </rk:BackstageTabItem>
                    <rk:BackstageTabItem Header="About" Icon="{StaticResource Icon.Palette}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,0,4,16" MaxWidth="720" HorizontalAlignment="Left">
                                <TextBlock Text="Crystal" FontSize="36" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                <TextBlock Margin="0,16,0,0" FontSize="15" TextWrapping="Wrap"
                                           Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                           Text="A glass-inspired Office 2024 study, built around soft reflections, clear commands and a tint that feels like yours." />
                            </StackPanel>
                        </ScrollViewer>
                    </rk:BackstageTabItem>
                </rk:Backstage>
            </rk:Ribbon.Backstage>
            <rk:RibbonTab Header="Home">
                <rk:RibbonGroup Header="Clipboard" Icon="{StaticResource Icon.Paste}">
                    <rk:RibbonButton Header="Paste" Size="Large" Icon="{StaticResource Icon.Paste}" Click="OnPreviewCommand" />
                    <StackPanel x:Name="CompactClipboard">
                        <rk:RibbonButton Header="Cut" Size="Medium" Icon="{StaticResource Icon.Cut}" Click="OnPreviewCommand" />
                        <rk:RibbonButton Header="Copy" Size="Medium" Icon="{StaticResource Icon.Copy}" Click="OnPreviewCommand" />
                        <rk:RibbonButton Header="Unavailable" Size="Medium" Icon="{StaticResource Icon.Undo}" IsEnabled="False" />
                    </StackPanel>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Text" Icon="{StaticResource Icon.Bold}">
                    <StackPanel x:Name="CompactText">
                        <rk:RibbonToggleButton Header="Bold" Size="Medium" Icon="{StaticResource Icon.Bold}" IsChecked="True" />
                        <rk:RibbonToggleButton Header="Italic" Size="Medium" Icon="{StaticResource Icon.Italic}" />
                        <rk:RibbonToggleButton Header="Underline" Size="Medium" Icon="{StaticResource Icon.Underline}" />
                    </StackPanel>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Layout" Icon="{StaticResource Icon.Select}">
                    <rk:RibbonDropDownButton Header="Arrange" Size="Large" Icon="{StaticResource Icon.Select}">
                        <rk:RibbonMenuItem Header="Bring to front" Click="OnPreviewCommand" />
                        <rk:RibbonMenuItem Header="Send to back" Click="OnPreviewCommand" />
                        <rk:RibbonMenuItem Header="Align to page" Click="OnPreviewCommand" />
                        <rk:RibbonMenuItem Header="Group objects" IsEnabled="False" />
                    </rk:RibbonDropDownButton>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Appearance" Icon="{StaticResource Icon.Palette}">
                    <rk:RibbonToggleButton x:Name="CompareToggle" Header="Compare 2024" Size="Large"
                                           Icon="{StaticResource Icon.Palette}"
                                           Checked="OnCompare" Unchecked="OnCompare"
                                           ScreenTipTitle="Compare the original palette"
                                           ScreenTipText="Switch this window between Crystal and Office 2024." />
                    <rk:RibbonToggleButton x:Name="DisableInputsToggle" Header="Disable inputs" Size="Large"
                                           Icon="{StaticResource Icon.Select}"
                                           Checked="OnDisableInputs" Unchecked="OnDisableInputs" />
                    <rk:RibbonDropDownButton x:Name="AccentSelector" Header="Glass tint" Size="Large"
                                             Icon="{StaticResource Icon.Palette}">
                        <rk:RibbonMenuItem Header="Blue (original)" Tag="#397CA9" Click="OnAccentSelected" />
                        <rk:RibbonMenuItem Header="Green" Tag="#287E78" Click="OnAccentSelected" />
                        <rk:RibbonMenuItem Header="Purple" Tag="#8659A5" Click="OnAccentSelected" />
                        <rk:RibbonMenuItem Header="Amber" Tag="#AC731C" Click="OnAccentSelected" />
                    </rk:RibbonDropDownButton>
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="Inputs" Icon="{StaticResource Icon.Bold}">
                    <StackPanel>
                        <rk:RibbonComboBox x:Name="FontInput" Header="Font" InputWidth="150" Margin="0,1"
                                           SelectedIndex="0" SelectedValuePath="Content" AutomationProperties.Name="Preview font">
                            <ComboBoxItem Content="Segoe UI" />
                            <ComboBoxItem Content="Arial" />
                            <ComboBoxItem Content="Georgia" />
                            <ComboBoxItem Content="Times New Roman" />
                        </rk:RibbonComboBox>
                        <rk:RibbonComboBox x:Name="SizeInput" Header="Size" InputWidth="70" Margin="0,1"
                                           SelectedIndex="2" SelectedValuePath="Content" AutomationProperties.Name="Preview font size">
                            <ComboBoxItem Content="11" />
                            <ComboBoxItem Content="12" />
                            <ComboBoxItem Content="15" />
                            <ComboBoxItem Content="18" />
                            <ComboBoxItem Content="24" />
                        </rk:RibbonComboBox>
                        <rk:RibbonTextBox x:Name="TitleInput" Header="Title" InputWidth="150" Margin="0,1"
                                          Text="A calmer workspace" AutomationProperties.Name="Preview title" />
                    </StackPanel>
                </rk:RibbonGroup>
            </rk:RibbonTab>
            <rk:RibbonTab Header="Insert">
                <rk:RibbonGroup Header="Illustrations" Icon="{StaticResource Icon.Table}">
                    <rk:RibbonButton Header="Table" Size="Large" Icon="{StaticResource Icon.Table}" Click="OnPreviewCommand" />
                    <rk:RibbonButton Header="Select" Size="Large" Icon="{StaticResource Icon.Select}" Click="OnPreviewCommand" />
                </rk:RibbonGroup>
            </rk:RibbonTab>
            <local:CrystalContextualTab x:Name="PictureTab" Header="Picture Format" IsContextual="True" ContextualColor="#287E78">
                <rk:RibbonGroup Header="Picture" Icon="{StaticResource Icon.Select}">
                    <rk:RibbonButton Header="Select" Size="Large" Icon="{StaticResource Icon.Select}" Click="OnPreviewCommand" />
                    <rk:RibbonButton Header="Change tint" Size="Large" Icon="{StaticResource Icon.Palette}" Click="OnChangeContextTint" />
                </rk:RibbonGroup>
            </local:CrystalContextualTab>
            <local:CrystalContextualTab x:Name="TableTab" Header="Table Design" IsContextual="True" ContextualColor="#8659A5">
                <rk:RibbonGroup Header="Table" Icon="{StaticResource Icon.Table}">
                    <rk:RibbonButton Header="Table" Size="Large" Icon="{StaticResource Icon.Table}" Click="OnPreviewCommand" />
                    <rk:RibbonButton Header="Change tint" Size="Large" Icon="{StaticResource Icon.Palette}" Click="OnChangeContextTint" />
                </rk:RibbonGroup>
            </local:CrystalContextualTab>
        </rk:Ribbon>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,30,40,36" MaxWidth="920">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,24">
                    <TextBlock x:Name="PreviewLabel" Text="CRYSTAL / LIGHT STUDY" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource RibbonKit.Brushes.Accent}" />
                    <TextBlock Text="A little light. A little depth." FontSize="32" Margin="0,8,0,10"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                    <TextBlock Text="Soft edges and clear commands, with room for the work itself." FontSize="15"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                </StackPanel>
                <Border Grid.Row="1" Padding="32" CornerRadius="16"
                        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding Text, ElementName=TitleInput}" FontSize="24" Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                        <TextBlock Margin="0,14,0,24" FontSize="{Binding SelectedValue, ElementName=SizeInput, FallbackValue=15}"
                                   FontFamily="{Binding SelectedValue, ElementName=FontInput, FallbackValue=Segoe UI}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                   Text="The ribbon carries a cool, luminous surface. Subtle borders catch the light, while the document keeps a steady, readable background. Color appears where it helps you see what is selected." />
                        <Separator Background="{DynamicResource RibbonKit.Brushes.Group.Separator}" />
                        <TextBlock Margin="0,20,0,0" Text="01   Surfaces &amp; light" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                        <TextBlock Margin="0,8,0,0" Text="An early visual study using layered gradients. Live blur and refraction are not part of this preview."
                                   TextWrapping="Wrap" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</rk:RibbonWindow>
