<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rk="urn:ribbonkit">
    <!-- Scope compact rounding to menu rows; retain the shared default template
         and the larger radius on the dropdown's own button. -->
    <Style TargetType="{x:Type rk:RibbonMenuItem}">
        <Style.Resources>
            <CornerRadius x:Key="RibbonKit.Metrics.ControlCornerRadius">4</CornerRadius>
        </Style.Resources>
    </Style>
    <Style TargetType="{x:Type rk:RibbonComboBox}">
        <Style.Resources>
            <ResourceDictionary Source="Crystal.Inputs.xaml" />
        </Style.Resources>
    </Style>
    <Style TargetType="{x:Type rk:RibbonGalleryItem}">
        <Style.Resources>
            <CornerRadius x:Key="RibbonKit.Metrics.ControlCornerRadius">5</CornerRadius>
            <!-- The gallery template uses Group.Separator for its hover outline. -->
            <DrawingBrush x:Key="RibbonKit.Brushes.Group.Separator" Drawing="{DynamicResource Crystal.Drawing.GlassRim}"
                          Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" Opacity="0.6" />
        </Style.Resources>
    </Style>
    <Style TargetType="{x:Type rk:InRibbonGallery}">
        <Style.Resources>
            <DrawingBrush x:Key="RibbonKit.Brushes.ScreenTip.Border" Drawing="{DynamicResource Crystal.Drawing.GalleryRim}"
                          Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
            <DrawingBrush x:Key="RibbonKit.Brushes.Control.SurfaceBackground" Drawing="{DynamicResource Crystal.Drawing.GallerySpecularSurface}"
                          Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
            <DrawingBrush x:Key="RibbonKit.Brushes.Ribbon.ContentBackground" Drawing="{DynamicResource Crystal.Drawing.GallerySpecularSurface}"
                          Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
        </Style.Resources>
    </Style>
    <Style TargetType="{x:Type rk:RibbonCheckBox}">
        <Style.Resources><ResourceDictionary Source="Crystal.Options.xaml" /></Style.Resources>
        <Setter Property="Template" Value="{DynamicResource Crystal.Options.CheckBoxTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="{x:Type rk:RibbonRadioButton}">
        <Style.Resources><ResourceDictionary Source="Crystal.Options.xaml" /></Style.Resources>
        <Setter Property="Template" Value="{DynamicResource Crystal.Options.RadioButtonTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="{x:Type rk:RibbonTextBox}">
        <Style.Resources>
            <ResourceDictionary Source="Crystal.Inputs.xaml" />
        </Style.Resources>
    </Style>
    <Style TargetType="{x:Type rk:RibbonScreenTip}">
        <Setter Property="Background" Value="{DynamicResource Crystal.Brushes.ScreenTipSurface}" />
        <!-- Sample-only layer study: keep definition on the outer contour and
             reflections on a separate inner border, with concentric corners. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rk:RibbonScreenTip}">
                    <Border x:Name="OuterRim" Background="{TemplateBinding Background}" Margin="5,4,5,6"
                            BorderBrush="{DynamicResource Crystal.Brushes.ScreenTipBorder}"
                            BorderThickness="1" CornerRadius="8" MaxWidth="300">
                        <Border.Effect><DropShadowEffect Color="#304C60" BlurRadius="8" ShadowDepth="1" Opacity="0.14" /></Border.Effect>
                        <Grid>
                            <Border x:Name="InnerReflection" CornerRadius="7" BorderThickness="1" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#C0FFFFFF" Offset="0" />
                                        <GradientStop Color="#50FFFFFF" Offset="0.4" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.75" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <StackPanel Margin="10,8">
                                <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}"><Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" /></Trigger>
                        <Trigger Property="Description" Value="{x:Null}"><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
