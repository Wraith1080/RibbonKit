<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark material for the existing shared input templates. -->
    <DrawingBrush x:Key="RibbonKit.Brushes.Control.SurfaceBackground" Stretch="Fill"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing><DrawingGroup>
            <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                <GeometryDrawing.Brush><RadialGradientBrush Center="0.5,0.48" GradientOrigin="0.5,0.48" RadiusX="0.85" RadiusY="0.72">
                    <GradientStop Color="#2D4556" Offset="0" /><GradientStop Color="#283E50" Offset="0.68" />
                    <GradientStop Color="#213645" Offset="1" />
                </RadialGradientBrush></GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="#15BDDFF3" />
        </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Border" Color="#7596AC" />
    <DrawingBrush x:Key="RibbonKit.Brushes.Text.Secondary" Stretch="Fill"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#B5CAD9" Geometry="M0,0 H1 V1 H0 Z" />
            <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                <GeometryDrawing.Brush><RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.48" RadiusY="0.16">
                    <GradientStop Color="#80FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush></GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Accent" Color="#8BC9F0" />
</ResourceDictionary>
