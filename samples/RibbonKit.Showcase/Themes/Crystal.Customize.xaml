<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rk="urn:ribbonkit">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Crystal.Backstage.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="Crystal.Customize.Action" TargetType="Button" BasedOn="{StaticResource Crystal.Backstage.Action}">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="Crystal.Customize.CompactAction" TargetType="Button" BasedOn="{StaticResource Crystal.Customize.Action}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="Crystal.Customize.PrimaryAction" TargetType="Button" BasedOn="{StaticResource Crystal.Customize.Action}">
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <ControlTemplate x:Key="Crystal.Customize.Navigation" TargetType="{x:Type rk:RibbonOptionsPage}">
        <Grid Margin="8,2" Background="Transparent">
            <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="14,10,14,12">
                <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <Rectangle x:Name="CrystalMarker" Width="36" Height="3" RadiusX="1.5" RadiusY="1.5"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3"
                       Fill="{DynamicResource RibbonKit.Brushes.Tab.SelectedUnderline}" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Tab.HoverBackground}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Tab.HoverBorder}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Tab.SelectedBackground}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Tab.SelectedBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Tab.SelectedForeground}" />
                <Setter TargetName="CrystalMarker" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Accent}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Crystal.Customize.Row" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="Crystal.Customize.ListItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Style="{StaticResource Crystal.Customize.Row}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.CheckedBackground}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Crystal.Brushes.ScreenTipBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="Crystal.Customize.TreeItem" TargetType="TreeViewItem">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ToggleButton x:Name="Expander" Width="16" Height="20" Focusable="False"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8" StrokeThickness="1.3"
                                  Stroke="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Border x:Name="Row" Grid.Column="1" Style="{StaticResource Crystal.Customize.Row}" Padding="4,3" Margin="0,1,2,1">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger>
            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.CheckedBackground}" />
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Crystal.Brushes.ScreenTipBorder}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Accent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
