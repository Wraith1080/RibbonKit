<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rk="urn:ribbonkit">
    <!-- Showcase-owned page paint; reusable controls come from RibbonKit. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RibbonKit;component/Themes/Tokens.Crystal.Light.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- The preview page is Showcase content, so its palette stays outside RibbonKit. -->
    <SolidColorBrush x:Key="Showcase.Brushes.PrintPreview.Canvas" Color="#A7BECE" />
    <SolidColorBrush x:Key="Showcase.Brushes.PrintPreview.PageBorder" Color="#829FB3" />
    <SolidColorBrush x:Key="Showcase.Brushes.PrintPreview.TitleForeground" Color="#20364A" />
    <SolidColorBrush x:Key="Showcase.Brushes.PrintPreview.BodyForeground" Color="#4F6476" />
</ResourceDictionary>
