<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rk="urn:ribbonkit">
    <!-- Prototype overrides only. Merge after the complete Office 2024 token dictionary.
         No copied templates, system backdrop request, or public RibbonTheme value. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Window.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DCEAF4" Offset="0" />
        <GradientStop Color="#EBE8F5" Offset="0.48" />
        <GradientStop Color="#DDEEEB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TitleBar.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8F4FC" Offset="0" />
        <GradientStop Color="#EAEAF6" Offset="0.65" />
        <GradientStop Color="#E3F1F0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Ribbon.ContentBackground" StartPoint="0,0" EndPoint="0.25,1">
        <!-- Shared dropdown templates also consume this token. Keep it opaque until
             ribbon material and popup surfaces have separate runtime tokens. -->
        <GradientStop Color="#FAFDFF" Offset="0" />
        <GradientStop Color="#E9F2FB" Offset="0.48" />
        <GradientStop Color="#E7F1F9" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Ribbon.Border" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#A6FFFFFF" Offset="0.45" />
        <GradientStop Color="#8095AFC5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.SurfaceBackground" Color="#F6FBFD" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Primary" Color="#20364A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Secondary" Color="#4F6476" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TitleBar.Foreground" Color="#20364A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.Foreground" Color="#20364A" />
    <!-- User-preferred rim: steady blue-gray sides with localized top/bottom glints.
         The small inset impression is preferred to the full-height gradient's taper. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.HoverBackground" Color="#205885B1" />
    <DrawingGroup x:Key="Crystal.Drawing.GlassRim">
        <GeometryDrawing Brush="#8892ABC0" Geometry="M0,0 H1 V1 H0 Z" />
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
            <GeometryDrawing.Brush>
                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0"
                                     RadiusX="0.48" RadiusY="0.10">
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#CCFFFFFF" Offset="0.55" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
            <GeometryDrawing.Brush>
                <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1"
                                     RadiusX="0.48" RadiusY="0.10">
                    <GradientStop Color="#A66D88A0" Offset="0" />
                    <GradientStop Color="#006D88A0" Offset="1" />
                </RadialGradientBrush>
            </GeometryDrawing.Brush>
        </GeometryDrawing>
    </DrawingGroup>
    <DrawingBrush x:Key="RibbonKit.Brushes.Control.HoverBorder"
                  Drawing="{StaticResource Crystal.Drawing.GlassRim}"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
    <!-- Reflection lives inside the fill, so the darker outer border remains intact.
         Soft horizontal falloff avoids a hard white stripe at the rounded corners. -->
    <GeometryDrawing x:Key="Crystal.Drawing.InnerReflection" Geometry="M0,0 H1 V1 H0 Z">
        <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.5,0.91" GradientOrigin="0.5,0.91"
                                 RadiusX="0.46" RadiusY="0.075">
                <GradientStop Color="#D9FFFFFF" Offset="0" />
                <GradientStop Color="#70F4FCFF" Offset="0.45" />
                <GradientStop Color="#00F4FCFF" Offset="1" />
            </RadialGradientBrush>
        </GeometryDrawing.Brush>
    </GeometryDrawing>
    <DrawingBrush x:Key="RibbonKit.Brushes.Control.PressedBackground"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.85" RadiusY="0.85">
                            <GradientStop Color="#DFEFFA" Offset="0" />
                            <GradientStop Color="#C8DFEF" Offset="0.6" />
                            <GradientStop Color="#AFCBDF" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <StaticResource ResourceKey="Crystal.Drawing.InnerReflection" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Control.PressedBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#90678BAA" Offset="0" />
        <GradientStop Color="#60678BAA" Offset="0.55" />
        <GradientStop Color="#C07898B2" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.Control.CheckedBackground"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.85" RadiusY="0.85">
                            <GradientStop Color="#EAF5FC" Offset="0" />
                            <GradientStop Color="#D6E8F4" Offset="0.6" />
                            <GradientStop Color="#BED5E7" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <DrawingGroup Opacity="0.65">
                    <StaticResource ResourceKey="Crystal.Drawing.InnerReflection" />
                </DrawingGroup>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <RadialGradientBrush x:Key="RibbonKit.Brushes.Control.CheckedHoverBackground"
                         Center="0.5,0.72" GradientOrigin="0.5,0.72" RadiusX="0.85" RadiusY="0.9">
        <GradientStop Color="#DAEDF9" Offset="0" />
        <GradientStop Color="#BBD5EA" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Control.CheckedBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A67898B2" Offset="0" />
        <GradientStop Color="#707898B2" Offset="0.5" />
        <GradientStop Color="#A67898B2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.InnerGlow" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionBackground" Color="#105885B1" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionBorder" Color="#185D82A6" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionGlow" Color="Transparent" />
    <Thickness x:Key="RibbonKit.Metrics.ControlHighlightBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Separator" Color="#40819DB5" />
    <!-- Selection carries the stronger glass surface and an icy reflective marker.
         Hover borrows a quieter rim; its gray underline would compete with selection. -->
    <RadialGradientBrush x:Key="RibbonKit.Brushes.Tab.SelectedBackground"
                         Center="0.5,0.25" GradientOrigin="0.5,0.25" RadiusX="0.85" RadiusY="0.95">
        <GradientStop Color="#F5FBFF" Offset="0" />
        <GradientStop Color="#E1EFF9" Offset="0.55" />
        <GradientStop Color="#C7DEEF" Offset="1" />
    </RadialGradientBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.Tab.SelectedBorderBrush"
                  Drawing="{StaticResource Crystal.Drawing.GlassRim}"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.HoverBackground" Color="#187BA5C7" />
    <DrawingBrush x:Key="RibbonKit.Brushes.Tab.HoverBorder"
                  Drawing="{StaticResource Crystal.Drawing.GlassRim}" Opacity="0.6"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.HoverUnderline" Color="Transparent" />
    <!-- The existing rounded marker clips this brush into a pill. A darker upper/lower
         edge surrounds a luminous center, with a localized glint for a trapped-air look. -->
    <DrawingBrush x:Key="RibbonKit.Brushes.Tab.SelectedUnderline"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" Opacity="0.9">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#809FB5" Offset="0" />
                            <GradientStop Color="#BCD6E6" Offset="0.2" />
                            <GradientStop Color="#EBF8FF" Offset="0.48" />
                            <GradientStop Color="#D1EAF6" Offset="0.76" />
                            <GradientStop Color="#8CAFC5" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.3,0.42" GradientOrigin="0.3,0.42"
                                             RadiusX="0.28" RadiusY="0.48">
                            <GradientStop Color="#D9FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Reserve the same rim on every tab, so selecting or hovering never moves labels. -->
    <Thickness x:Key="RibbonKit.Metrics.TabSelectedBorderThickness">1,1,1,0</Thickness>
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.ControlHoverBackground" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.ControlPressedBackground" Color="#809EBBD2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.ScrollButtonBackground" Color="#EBF2F9" />
    <!-- Native WPF popups have no shared backdrop: use a readable opaque frosting. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ScreenTip.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFDFF" Offset="0" />
        <GradientStop Color="#E8F0F8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Border" Color="#A5BBCE" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.HoverBackground" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.PressedBackground" Color="#809EBBD2" />
    <CornerRadius x:Key="RibbonKit.Metrics.ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SmallControlCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.PopupCornerRadius">8</CornerRadius>
    <!-- Scope compact rounding to menu rows; retain the shared default template
         and the larger radius on the dropdown's own button. -->
    <Style TargetType="{x:Type rk:RibbonMenuItem}">
        <Style.Resources>
            <CornerRadius x:Key="RibbonKit.Metrics.ControlCornerRadius">4</CornerRadius>
        </Style.Resources>
    </Style>
    <Style TargetType="{x:Type rk:RibbonComboBox}">
        <Style.Resources>
            <ResourceDictionary Source="Crystal.Inputs.xaml" />
        </Style.Resources>
    </Style>
    <Style TargetType="{x:Type rk:RibbonTextBox}">
        <Style.Resources>
            <ResourceDictionary Source="Crystal.Inputs.xaml" />
        </Style.Resources>
    </Style>
    <CornerRadius x:Key="RibbonKit.Metrics.TabCornerRadius">8,8,0,0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ContentCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ContentCornerRadiusTop">14,14,0,0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitLeftCornerRadius">8,0,0,8</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitRightCornerRadius">0,8,8,0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitTopCornerRadius">8,8,0,0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitBottomCornerRadius">0,0,8,8</CornerRadius>
    <DropShadowEffect x:Key="RibbonKit.Effects.ContentShadow" Color="#466982"
                      BlurRadius="16" ShadowDepth="3" Opacity="0.18" RenderingBias="Performance" />
</ResourceDictionary>
