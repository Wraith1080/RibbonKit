<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:RibbonKit.Controls;assembly=RibbonKit">
<!-- Sample-only option templates separate glass fill, selected outline and indicator focus. Native wash parts and control interaction remain intact. -->
<ControlTemplate x:Key="Crystal.Options.CheckBoxTemplate" TargetType="{x:Type controls:RibbonCheckBox}">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="HoverWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <!-- Keep content spacing off Chrome: padding there would also inset the
                                 sibling hover/press washes from the full focus rectangle. -->
                            <Grid x:Name="ContentGrid" Margin="5,1,5,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="FocusRing" Width="18" Height="18" Margin="-2,0" VerticalAlignment="Center" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Crystal.Options.FocusBorder}" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="Indicator" Width="14" Height="14"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}">
                                    <Grid>
                                        <Path x:Name="CheckMark" Data="M 1,5 L 4,8 L 10,1"
                                              Stroke="{DynamicResource RibbonKit.Brushes.Input.Glyph}"
                                              StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stretch="Uniform" Margin="2.5" Visibility="Collapsed" />
                                        <Rectangle x:Name="IndeterminateMark" Width="7" Height="2"
                                                   RadiusX="1" RadiusY="1"
                                                   Fill="{DynamicResource RibbonKit.Brushes.Input.Glyph}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="HeaderPresenter" Grid.Column="1"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  Margin="6,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Content"
                                    Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                    Value="{DynamicResource Crystal.Options.SelectedBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Background"
                                    Value="{DynamicResource Crystal.Options.SelectedSurface}" />
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                    Value="{DynamicResource Crystal.Options.SelectedBorder}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Indicator" Property="Background"
                                    Value="{DynamicResource Crystal.Options.SelectedSurface}" />
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                    Value="{DynamicResource Crystal.Options.SelectedBorder}" />
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
<ControlTemplate x:Key="Crystal.Options.RadioButtonTemplate" TargetType="{x:Type controls:RibbonRadioButton}">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="HoverWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <!-- Same geometry contract as RibbonCheckBox: washes fill Chrome;
                                 only indicator/text content receives the inset. -->
                            <Grid x:Name="ContentGrid" Margin="5,1,5,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="FocusRing" Width="18" Height="18" Margin="-2,0" VerticalAlignment="Center" StrokeThickness="1" Stroke="{DynamicResource Crystal.Options.FocusBorder}" Opacity="0" IsHitTestVisible="False" />
                                <Ellipse x:Name="Indicator" Width="14" Height="14"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                                         Stroke="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                         StrokeThickness="1" />
                                <Ellipse x:Name="SelectionMark" Width="6" Height="6"
                                         Fill="{DynamicResource RibbonKit.Brushes.Input.Glyph}"
                                         VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter x:Name="HeaderPresenter" Grid.Column="1"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  Margin="6,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Content"
                                    Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Indicator" Property="Stroke"
                                    Value="{DynamicResource Crystal.Options.SelectedBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Fill"
                                    Value="{DynamicResource Crystal.Options.SelectedSurface}" />
                            <Setter TargetName="Indicator" Property="Stroke"
                                    Value="{DynamicResource Crystal.Options.SelectedBorder}" />
                            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
</ResourceDictionary>
