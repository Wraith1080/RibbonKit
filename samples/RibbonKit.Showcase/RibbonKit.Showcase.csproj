<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <!-- Intentional legacy compatibility target for Windows 7 validation. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RibbonKit.Showcase</RootNamespace>
    <IsPackable>false</IsPackable>
    <ApplicationIcon>..\..\assets\RibbonKit.ico</ApplicationIcon>
    <!-- Opts the process into PerMonitorV2 DPI awareness. Without it WPF is System-DPI
         aware and Windows bitmap-stretches the window (blurry until restart) when the
         display scale changes. See app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RibbonKit\RibbonKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\RibbonKit.ico" Link="Assets\RibbonKit.ico" />
  </ItemGroup>

</Project>
