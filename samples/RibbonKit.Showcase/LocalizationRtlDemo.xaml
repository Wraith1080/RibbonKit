<rk:RibbonWindow x:Class="RibbonKit.Showcase.LocalizationRtlDemo"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rk="urn:ribbonkit"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="RibbonKit Localization &amp; RTL Lab"
                 Width="1040"
                 Height="700"
                 MinWidth="720"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 UseLayoutRounding="True"
                 Background="{DynamicResource RibbonKit.Brushes.Window.Background}">
    <DockPanel>
        <rk:Ribbon x:Name="DemoRibbon"
                   DockPanel.Dock="Top"
                   QuickAccessPosition="TabRow"
                   QuickAccessCustomizeRequested="OnCustomizeQuickAccess"
                   RibbonCustomizeRequested="OnCustomizeRibbon">
            <rk:Ribbon.MessageBar>
                <rk:RibbonMessageBar x:Name="DemoMessageBar">
                    <rk:RibbonMessage x:Name="DemoProtectedViewMessage"
                                      IsOpen="False"
                                      Title="عرض محمي — PROTECTED VIEW"
                                      Message="قد تحتوي ملفات الإنترنت على فيروسات — files from the Internet can contain viruses."
                                      ActionContent="تمكين التحرير — Enable Editing"
                                      ActionClick="OnEnableEditingMessage" />
                    <rk:RibbonMessage x:Name="DemoSecurityNoticeMessage"
                                      IsOpen="False"
                                      Title="إشعار أمان — SECURITY NOTICE"
                                      Message="تم تعطيل وحدات الماكرو في هذا المستند — macros are disabled."
                                      ActionContent="مراجعة الإعدادات — Review Settings"
                                      ActionClick="OnReviewSecurityMessage" />
                </rk:RibbonMessageBar>
            </rk:Ribbon.MessageBar>

            <rk:Ribbon.Backstage>
                <rk:Backstage x:Name="DemoBackstage" Design="Modern" SelectedIndex="0">
                    <rk:BackstageTabItem Header="معلومات — Info">
                        <StackPanel Language="ar-SA">
                            <TextBlock Text="تقرير الإصدار — RibbonKit 2026"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14" />
                            <TextBlock Text="تقرير ربع سنوي — Quarterly report — ٢٠٢٦"
                                       FontSize="16"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="Report-2026-Q3.docx"
                                       FlowDirection="LeftToRight"
                                       TextAlignment="Left"
                                       FontFamily="Consolas" />
                        </StackPanel>
                    </rk:BackstageTabItem>
                    <rk:BackstageTabItem Header="Recent — الأخيرة" />
                    <rk:BackstageTabItem Header="خيارات — Options" />
                </rk:Backstage>
            </rk:Ribbon.Backstage>

            <!-- Parked by the window constructor until the main Showcase selects its 2007 Menu.
                 Keeping a distinct instance lets this lab exercise the same surface under local RTL. -->
            <rk:Ribbon.ApplicationMenu>
                <rk:RibbonApplicationMenu x:Name="DemoApplicationMenu">
                    <rk:RibbonApplicationMenu.DefaultContent>
                        <StackPanel Language="ar-SA">
                            <TextBlock Text="المستندات الأخيرة — Recent documents"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource RibbonKit.Brushes.ApplicationMenu.HeadingForeground}"
                                       Margin="0,0,0,8" />
                            <Rectangle Height="1"
                                       Fill="{DynamicResource RibbonKit.Brushes.ApplicationMenu.Separator}" />
                            <rk:RibbonApplicationMenuPaneItem Content="١  تقرير ربع سنوي — Quarterly report" />
                            <rk:RibbonApplicationMenuPaneItem Content="2  Report-2026-Q3.docx"
                                                              FlowDirection="LeftToRight" />
                        </StackPanel>
                    </rk:RibbonApplicationMenu.DefaultContent>

                    <rk:RibbonApplicationMenuItem Header="جديد — New" Icon="{StaticResource Icon.Picture}" />
                    <rk:RibbonApplicationMenuItem Header="فتح — Open" Icon="{StaticResource Icon.Table}" />
                    <rk:RibbonApplicationMenuItem Header="حفظ — Save" Icon="{StaticResource Icon.Save}" />
                    <rk:RibbonApplicationMenuItem Header="حفظ باسم — Save As"
                                                  Icon="{StaticResource Icon.Save}"
                                                  IsSplit="True">
                        <StackPanel>
                            <rk:RibbonApplicationMenuPaneItem Content="مستند Word — Word Document" />
                            <rk:RibbonApplicationMenuPaneItem Content="قالب — Template" />
                        </StackPanel>
                    </rk:RibbonApplicationMenuItem>

                    <rk:RibbonApplicationMenu.FooterContent>
                        <StackPanel Orientation="Horizontal">
                            <rk:RibbonApplicationMenuButton Content="{rk:RibbonString Key=Options}"
                                                            Icon="{StaticResource Icon.Gear}"
                                                            Click="OnOpenCustomizeRibbon" />
                            <rk:RibbonApplicationMenuButton Content="{rk:RibbonString Key=Exit}"
                                                            Icon="{StaticResource Icon.Exit}"
                                                            Click="OnCloseLab" />
                        </StackPanel>
                    </rk:RibbonApplicationMenu.FooterContent>
                </rk:RibbonApplicationMenu>
            </rk:Ribbon.ApplicationMenu>

            <rk:Ribbon.QuickAccessItems>
                <rk:RibbonButton Header="Save"
                                 rk:Ribbon.CommandId="loc.qat.save"
                                 Size="Small"
                                 Icon="{StaticResource Icon.Save}"
                                 ScreenTipTitle="Save" />
                <rk:RibbonButton Header="Undo"
                                 rk:Ribbon.CommandId="loc.qat.undo"
                                 Size="Small"
                                 Icon="{StaticResource Icon.Undo}"
                                 ScreenTipTitle="Undo" />
            </rk:Ribbon.QuickAccessItems>

            <rk:RibbonTab Header="Localization Lab" rk:Ribbon.CommandId="loc.tab.lab">
                <rk:RibbonGroup Header="Mode"
                                rk:Ribbon.CommandId="loc.group.mode"
                                Icon="{StaticResource Icon.Palette}">
                    <rk:RibbonButton Header="Add Message"
                                     Size="Large"
                                     LargeIcon="{StaticResource Icon.Backstage}"
                                     Icon="{StaticResource Icon.Backstage}"
                                     Click="OnAddMessage"
                                     ScreenTipTitle="Add RTL message"
                                     ScreenTipText="Show the next mixed Arabic/English message and exercise animated RTL presentation." />
                    <rk:RibbonToggleButton x:Name="PseudoLocalizationToggle"
                                           Header="Pseudo Localization"
                                           Size="Large"
                                           LargeIcon="{StaticResource Icon.Font}"
                                           Icon="{StaticResource Icon.Font}"
                                           Checked="OnTogglePseudoLocalization"
                                           Unchecked="OnTogglePseudoLocalization"
                                           ScreenTipTitle="Pseudo localization"
                                           ScreenTipText="Replace RibbonKit-owned strings with their resource keys. The previous provider is restored when this lab closes." />
                    <rk:RibbonToggleButton x:Name="RightToLeftToggle"
                                           Header="Right-to-Left"
                                           Size="Large"
                                           LargeIcon="{StaticResource Icon.Redo}"
                                           Icon="{StaticResource Icon.Redo}"
                                           Checked="OnToggleRightToLeft"
                                           Unchecked="OnToggleRightToLeft"
                                           ScreenTipTitle="Right-to-left layout"
                                           ScreenTipText="Mirror this lab window without changing the main Showcase window." />
                </rk:RibbonGroup>

                <rk:RibbonGroup Header="Customization"
                                rk:Ribbon.CommandId="loc.group.customization"
                                Icon="{StaticResource Icon.Gear}">
                    <rk:RibbonButton Header="Customize Ribbon"
                                     Size="Large"
                                     LargeIcon="{StaticResource Icon.Gear}"
                                     Icon="{StaticResource Icon.Gear}"
                                     Click="OnOpenCustomizeRibbon"
                                     ScreenTipTitle="Customize Ribbon"
                                     ScreenTipText="Open the built-in ribbon customization page using this lab's flow direction." />
                    <rk:RibbonButton Header="Quick Access"
                                     Size="Large"
                                     LargeIcon="{StaticResource Icon.Save}"
                                     Icon="{StaticResource Icon.Save}"
                                     Click="OnOpenQuickAccess"
                                     ScreenTipTitle="Quick Access Toolbar"
                                     ScreenTipText="Open the built-in QAT customization page using this lab's flow direction." />
                </rk:RibbonGroup>

                <rk:RibbonGroup Header="RTL Inputs"
                                rk:Ribbon.CommandId="loc.group.inputs"
                                Icon="{StaticResource Icon.Font}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <rk:RibbonCheckBox Header="إظهار المسطرة — Show ruler"
                                               IsChecked="True"
                                               rk:KeyTip.Keys="IR"
                                               ScreenTipTitle="RTL check box"
                                               ScreenTipText="The indicator should lead from the right when this lab is RTL." />
                            <rk:RibbonRadioButton Header="مضغوط — Compact"
                                                 GroupName="LabDensity"
                                                 IsChecked="True"
                                                 rk:KeyTip.Keys="IC"
                                                 ScreenTipTitle="RTL radio button"
                                                 ScreenTipText="The selected indicator and mixed label inherit the lab direction." />
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <rk:RibbonTextBox x:Name="RtlMixedTextBox"
                                              Header="بحث — Find"
                                              InputWidth="112"
                                              Text="RibbonKit 2026 — تقرير الإصدار"
                                              rk:KeyTip.Keys="IF"
                                              ScreenTipTitle="Mixed-direction input"
                                              ScreenTipText="The label and input mirror while mixed Arabic and Latin text uses Unicode bidirectional ordering." />
                            <rk:RibbonTextBox x:Name="RtlDocumentTextBox"
                                              Header="ملف — File"
                                              InputWidth="112"
                                              Text="Report-2026-Q3.docx"
                                              TextAlignment="Left"
                                              Language="en-US"
                                              rk:KeyTip.Keys="ID"
                                              ScreenTipTitle="LTR document identifier"
                                              ScreenTipText="The control remains mirrored, but this Latin document identifier stays left-aligned." />
                        </StackPanel>
                    </StackPanel>
                </rk:RibbonGroup>

                <rk:RibbonGroup Header="RTL Scrolling"
                                rk:Ribbon.CommandId="loc.group.scrolling"
                                Icon="{StaticResource Icon.Gear}"
                                CanResize="False">
                    <StackPanel Orientation="Horizontal"
                                Margin="6,0"
                                VerticalAlignment="Center">
                        <rk:RibbonScrollBar x:Name="RtlVerticalScrollBar"
                                            Height="68"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="30"
                                            ViewportSize="25"
                                            AutomationProperties.Name="RTL lab vertical scrollbar" />
                        <rk:RibbonScrollBar x:Name="RtlHorizontalScrollBar"
                                            Orientation="Horizontal"
                                            Width="132"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="40"
                                            ViewportSize="25"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="RTL lab horizontal scrollbar" />
                    </StackPanel>
                </rk:RibbonGroup>

                <rk:RibbonGroup Header="Popup Checks"
                                rk:Ribbon.CommandId="loc.group.popups"
                                Icon="{StaticResource Icon.Paste}">
                    <rk:RibbonSplitButton Header="Paste"
                                          rk:Ribbon.CommandId="loc.command.paste"
                                          Size="Large"
                                          LargeIcon="{StaticResource Icon.Paste}"
                                          Icon="{StaticResource Icon.Paste}"
                                          ScreenTipTitle="Paste"
                                          ScreenTipText="Open this menu and right-click the button to check popup and context-menu direction.">
                        <rk:RibbonMenuItem Header="Keep Source Formatting" Icon="{StaticResource Icon.Paste}" />
                        <rk:RibbonMenuItem Header="Merge Formatting" Icon="{StaticResource Icon.Copy}" />
                        <rk:RibbonMenuItem Header="Keep Text Only" />
                    </rk:RibbonSplitButton>
                    <rk:RibbonGroupSeparator x:Name="RtlPopupGroupSeparator" />
                    <rk:RibbonDropDownButton Header="Select"
                                             rk:Ribbon.CommandId="loc.command.select"
                                             Size="Large"
                                             LargeIcon="{StaticResource Icon.Select}"
                                             Icon="{StaticResource Icon.Select}"
                                             ScreenTipTitle="Select"
                                             ScreenTipText="Open this dropdown to check its RTL placement and item alignment.">
                        <rk:RibbonMenuItem Header="Select All" />
                        <rk:RibbonMenuItem Header="Select Objects" Icon="{StaticResource Icon.Select}" />
                        <rk:RibbonMenuItem Header="Selection Pane…" />
                    </rk:RibbonDropDownButton>
                </rk:RibbonGroup>
            </rk:RibbonTab>
        </rk:Ribbon>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="24"
                    Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Localization &amp; RTL test checklist"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                               Margin="0,0,0,12" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                               Margin="0,0,0,16">
                        Pseudo localization replaces only RibbonKit-owned text. App-authored tab,
                        group, command, page, and sample strings intentionally stay unchanged.
                    </TextBlock>

                    <Border Padding="12"
                            Margin="0,0,0,18"
                            Background="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock x:Name="StatusText"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                    </Border>

                    <TextBlock Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                               TextWrapping="Wrap"
                               LineHeight="25">
                        1. Toggle Pseudo Localization and confirm the default File button,
                        main-Showcase application-menu Options/Exit footer, and built-in
                        dialog/context-menu text become bracketed resource keys.&#x0a;
                        2. Toggle Right-to-Left and confirm the QAT, groups, popups, and window chrome
                        mirror while the main Showcase stays LTR. In RTL Inputs, option indicators
                        should lead from the right; labels should move right of their text fields;
                        the mixed field should start at the right while the document name stays
                        left-aligned inside a still-mirrored control. In Popup Checks, the separator
                        must remain between Paste and Select as their physical order mirrors. In RTL
                        Scrolling, the horizontal arrows/value direction should mirror while the
                        vertical scrollbar keeps its top-to-bottom direction.&#x0a;
                        3. Open both customization pages. Add points toward the target list; Remove
                        points back toward available commands.&#x0a;
                        4. Right-click Paste, Select, and both QAT buttons. Check submenu placement
                        and the localized built-in commands.&#x0a;
                        5. Create and edit a custom tab/group to exercise names, suffixes, choices,
                        tooltips, and OK/Cancel.&#x0a;
                        6. Change the main Showcase Backstage rail design, translucency, theme, and
                        2007 Menu toggle; this lab follows live. With RTL enabled, verify each
                        Backstage rail stays on the right and opens/closes toward that edge. Under
                        Office 2007, verify the File button becomes an orb and opens this lab's
                        bidirectional two-pane menu instead of its Backstage. The window title should
                        glide directly between its QAT/no-QAT positions without overshooting. Also
                        check Arabic shaping, mixed Arabic/Latin ordering, and the LTR document name.&#x0a;
                        7. Confirm both message rows attach directly below the ribbon, then toggle
                        RTL: icons/title/body should start at the right while action and Close move
                        to the left. Dismiss either row and confirm the other remains attached.&#x0a;
                        8. With pseudo localization enabled, hover chrome controls: caption buttons,
                        QAT overflow, Backstage Back, group launchers, and ribbon/window controls.
                        Their tooltips should show bracketed resource keys.
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="20"
                    Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Bidirectional text samples"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                               Margin="0,0,0,14" />

                    <TextBlock Text="English (forced LTR)"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                    <TextBlock Text="Quarterly report — 2026"
                               FlowDirection="LeftToRight"
                               FontSize="16"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                               Margin="0,3,0,16" />

                    <TextBlock Text="Arabic (forced RTL)"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                    <TextBlock Text="تقرير ربع سنوي — ٢٠٢٦"
                               FlowDirection="RightToLeft"
                               FontSize="16"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                               Margin="0,3,0,16" />

                    <TextBlock Text="Mixed content (inherits lab flow)"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                    <TextBlock Text="RibbonKit 2026 — تقرير الإصدار"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                               Margin="0,3,0,20" />

                    <Separator />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                               Margin="0,16,0,0">
                        The File Backstage repeats these cases inside a real RibbonKit surface.
                        The localization provider is application-wide by design. This lab restores
                        the provider that was active before pseudo localization when you turn it off
                        or close the window. RTL layout is local to this window and its dialogs.
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</rk:RibbonWindow>
