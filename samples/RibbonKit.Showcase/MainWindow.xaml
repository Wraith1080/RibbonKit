        </rk:Ribbon>

        <Grid x:Name="MainContentArea"
              Background="{DynamicResource RibbonKit.Brushes.Window.Background}">
            <!-- TAB MERGING demo. A RibbonMergeSource is a declarative bag of tabs belonging to
                 some child context — an embedded editor, an MDI document, a plug-in. It is not
                 part of the ribbon until the app calls Ribbon.Merge(source), and the tabs go away
                 again on Unmerge. It renders nothing itself (Collapsed), so it can sit anywhere in
                 the tree; living here means its DataContext comes from the window, and each merged
                 tab's DataContext is bound to it — which is what keeps an MVVM child's bindings
                 resolving against the CHILD's view model rather than the host's.
                 Order="0" places these after the host's own tabs; a negative Order would put them
                 before. -->
            <rk:RibbonMergeSource x:Name="ChartToolsSource"
                                  Order="0"
                                  Target="{Binding ElementName=MainRibbon}"
                                  IsActive="{Binding IsChecked, ElementName=MergeToggle}">
                <!-- Groups injected into the HOST's own tabs, addressed by the host tab's
                     CommandId — Office's other merge shape, where a tool context adds a group to
                     Home rather than contributing a whole tab. Order 0 appends after Home's own
                     groups; a negative Order would put it first. -->
                <rk:RibbonMergeSource.Groups>
                    <rk:RibbonGroupContribution TargetTabId="tab.home" Order="0">
                        <rk:RibbonGroup Header="Chart Data" Icon="{StaticResource Icon.Table}">
                            <rk:RibbonButton Header="Refresh"
                                             Size="Large"
                                             LargeIcon="{StaticResource Icon.Redo}"
                                             Icon="{StaticResource Icon.Redo}"
                                             ScreenTipTitle="Refresh Chart Data"
                                             ScreenTipText="Re-read the chart's source range. This group is injected into the HOST's Home tab by the merge source — right-click it to add it to the Quick Access Toolbar, then unmerge and watch the proxy grey out instead of vanishing." />
                        </rk:RibbonGroup>
                    </rk:RibbonGroupContribution>
                </rk:RibbonMergeSource.Groups>
                <rk:RibbonTab Header="Chart Design"
                              IsContextual="True"
                              ContextualColor="#1F7A4D">
                    <rk:RibbonGroup Header="Type" Icon="{StaticResource Icon.Style}">
                        <rk:RibbonButton Header="Change Type"
                                         Size="Large"
                                         LargeIcon="{StaticResource Icon.Style}"
                                         Icon="{StaticResource Icon.Style}"
                                         ScreenTipTitle="Change Chart Type"
                                         ScreenTipText="Switch between column, line, pie and the rest." />
                    </rk:RibbonGroup>
                    <rk:RibbonGroup Header="Data" Icon="{StaticResource Icon.Table}">
                        <rk:RibbonButton Header="Select Data"
                                         Size="Large"
                                         LargeIcon="{StaticResource Icon.Table}"
                                         Icon="{StaticResource Icon.Table}"
                                         ScreenTipTitle="Select Data"
                                         ScreenTipText="Choose the range the chart plots." />
                    </rk:RibbonGroup>
                </rk:RibbonTab>
                <rk:RibbonTab Header="Chart Format"
                              IsContextual="True"
                              ContextualColor="#1F7A4D">
                    <rk:RibbonGroup Header="Shape Styles" Icon="{StaticResource Icon.Palette}">
                        <rk:RibbonButton Header="Fill"
                                         Size="Large"
                                         LargeIcon="{StaticResource Icon.ColorDrop}"
                                         Icon="{StaticResource Icon.ColorDrop}"
                                         ScreenTipTitle="Shape Fill"
                                         ScreenTipText="Fill the selected series with a colour or gradient." />
                    </rk:RibbonGroup>
                </rk:RibbonTab>
            </rk:RibbonMergeSource>

            <DockPanel>
                <!-- Word-like status bar, docked at the very bottom. A DockPanel items panel
                     lets the left cluster and the right (zoom) cluster split to the edges. -->
                <StatusBar DockPanel.Dock="Bottom"
                           Background="{DynamicResource RibbonKit.Brushes.Window.Background}"
                           BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                           BorderThickness="0,1,0,0"
                           Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                           FontSize="12">
                    <StatusBar.ItemsPanel>
                        <ItemsPanelTemplate>
                            <DockPanel LastChildFill="False" />
                        </ItemsPanelTemplate>
                    </StatusBar.ItemsPanel>
                    <StatusBarItem DockPanel.Dock="Left" Content="Page 1 of 1" Margin="8,0,0,0" />
                    <Separator DockPanel.Dock="Left" />
                    <StatusBarItem DockPanel.Dock="Left" Content="Words: 111" />
                    <Separator DockPanel.Dock="Left" />
                    <StatusBarItem DockPanel.Dock="Left" Content="English (United States)" />
                    <StatusBarItem DockPanel.Dock="Right" Content="100%" Margin="0,0,10,0" />
                    <Separator DockPanel.Dock="Right" />
                    <StatusBarItem x:Name="StatusReady" DockPanel.Dock="Right" Content="Ready" />
                </StatusBar>

                <!-- Document panel: a card with rounded TOP corners whose square bottom meets
                     the status bar. Hosts an editable RichTextBox; the panel supplies the
                     background + rounded corners, so the RichTextBox itself is borderless and
                     transparent. Keeps an opaque white fill so the Mica backdrop shows only in
                     the surrounding margin, not through the document. -->
                <!-- Margin 8 (user-tuned): aligns the panel's edges with the ribbon card's
                     inner edge (7px card margin + 1px border). -->
                <!-- Document and the Print Preview surface share one cell, so the preview covers
                     the document but leaves the status bar alone. -->
                <Grid>
                <Border Margin="8,8,8,0"
                        Background="White"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8,8,0,0">
                    <RichTextBox x:Name="DocumentEditor"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="28,22"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 VerticalScrollBarVisibility="Auto"
                                 IsInactiveSelectionHighlightEnabled="True">
                        <FlowDocument PagePadding="0" TextAlignment="Left">
                            <Paragraph FontSize="18" Foreground="#6B6B6B" Margin="0,0,0,12">RibbonKit — Phase 1: core ribbon skeleton</Paragraph>
                            <Paragraph FontSize="13" Foreground="#9A9A9A" Margin="0,0,0,6">Make the window narrower: groups collapse to flyout buttons by priority — Styles (10) → Editing (5) → Clipboard (default, resizes first) — Font never reduces (CanResize=False).</Paragraph>
                            <Paragraph FontSize="13" Foreground="#9A9A9A" Margin="0,0,0,6">Click a collapsed group button to open its flyout with the full group content.</Paragraph>
                            <Paragraph FontSize="13" Foreground="#9A9A9A" Margin="0,0,0,6">New: click the File button for the backstage view (Esc or the back arrow returns). Paste is a split button, Select is a dropdown, B/I/U are toggles, Font has combos and a ↘ launcher.</Paragraph>
                            <Paragraph FontSize="13" Foreground="#9A9A9A" Margin="0,0,0,18">Hover any button for its ScreenTip. Hover the Styles gallery for LIVE PREVIEW of the sentence below — click to commit, move away to revert.</Paragraph>
                            <Paragraph><Run x:Name="StylePreviewText" FontSize="14" Text="The quick brown fox jumps over the lazy dog." /></Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </Border>

                <!-- Print Preview surface. Shown only while the Print Preview MODAL TAB is active
                     (the ribbon's ModalEntered / ModalExited handlers toggle it), so the demo shows
                     a real mode change rather than just another tab. -->
                <Border x:Name="PrintPreviewSurface"
                        Margin="8,8,8,0"
                        Background="#6E6E6E"
                        Visibility="Collapsed">
                    <Border Width="420"
                            Margin="0,24"
                            VerticalAlignment="Stretch"
                            Background="White"
                            BorderBrush="#3F3F3F"
                            BorderThickness="1">
                        <StackPanel Margin="36,44" VerticalAlignment="Top">
                            <TextBlock Text="RibbonKit"
                                       FontSize="22"
                                       Foreground="#3F3F3F"
                                       Margin="0,0,0,14" />
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="#6B6B6B"
                                       Text="Page 1 of 1 — this is a modal tab. Every other tab and the File button are hidden, the ribbon cannot be minimized (try double-clicking a tab header, or Ctrl+F1), and the backstage is blocked. The Quick Access Toolbar stays, exactly like Word's Print Preview." />
                        </StackPanel>
                    </Border>
                </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</rk:RibbonWindow>
