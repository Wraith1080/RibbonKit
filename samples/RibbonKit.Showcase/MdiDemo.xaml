<rk:RibbonWindow x:Class="RibbonKit.Showcase.MdiDemo"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rk="urn:ribbonkit"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="RibbonKit MDI Demo"
                 Width="1100"
                 Height="720"
                 MinWidth="480"
                 WindowStartupLocation="CenterScreen"
                 UseLayoutRounding="True"
                 Background="White">
    <DockPanel>
        <rk:Ribbon x:Name="DemoRibbon" DockPanel.Dock="Top">
            <rk:RibbonTab Header="Window" rk:Ribbon.CommandId="tab.window">
                <rk:RibbonGroup Header="Documents">
                    <rk:RibbonButton Header="New Document"
                                     Size="Large"
                                     LargeIcon="{StaticResource Icon.Copy}"
                                     Icon="{StaticResource Icon.Copy}"
                                     Click="OnNewDocument"
                                     ScreenTipTitle="New document"
                                     ScreenTipText="Open a new child window in the MDI area (a UserControl wrapped in themed chrome)." />
                    <rk:RibbonButton Header="Close Active"
                                     Size="Large"
                                     LargeIcon="{StaticResource Icon.Exit}"
                                     Icon="{StaticResource Icon.Exit}"
                                     Click="OnCloseActive"
                                     ScreenTipTitle="Close active document"
                                     ScreenTipText="Close the currently active child window." />
                </rk:RibbonGroup>
                <rk:RibbonGroup Header="State">
                    <rk:RibbonButton Header="Maximize"
                                     Click="OnMaximizeActive"
                                     SizeDefinition="Large, Medium, Small"
                                     Icon="{StaticResource Icon.Copy}"
                                     ScreenTipText="Maximize the active child to fill the MDI area." Size="Large" />
                    <rk:RibbonButton Header="Minimize"
                                     Click="OnMinimizeActive"
                                     SizeDefinition="Large, Medium, Small"
                                     Icon="{StaticResource Icon.Copy}"
                                     ScreenTipText="Minimize the active child to a caption strip along the bottom." Size="Large" />
                    <rk:RibbonButton Header="Restore"
                                     Click="OnRestoreActive"
                                     SizeDefinition="Large, Medium, Small"
                                     Icon="{StaticResource Icon.Copy}"
                                     ScreenTipText="Restore the active child to its normal floating bounds." Size="Large" />
                </rk:RibbonGroup>
            </rk:RibbonTab>
        </rk:Ribbon>

        <!-- Ribbon integration (MDI M4). Pointing the container at the ribbon turns on BOTH
             halves of classic MDI's ribbon behaviour:
               • tab merge — the active document's MergeSource joins the ribbon and leaves when
                 another document takes over (this is Phase 7's feature, wired here, not
                 reimplemented);
               • caption merge — a MAXIMIZED active child's icon and window buttons move into the
                 ribbon row and its own title bar disappears.
             Set IsCaptionMergeEnabled="False" to keep the child's title bar and get tab merge
             only; leave Ribbon unset and the container behaves as it did before. -->
        <rk:MdiContainer x:Name="Mdi"
                         Ribbon="{Binding ElementName=DemoRibbon}"
                         DocumentClosing="OnDocumentClosing" />
    </DockPanel>
</rk:RibbonWindow>
