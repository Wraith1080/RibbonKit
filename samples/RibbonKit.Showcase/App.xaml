<Application x:Class="RibbonKit.Showcase.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Token dictionary in app scope: the shared templates resolve their
                     colors/metrics from here via DynamicResource. Swap at runtime with
                     RibbonKit.Theming.ThemeManager.Apply(...). -->
                <ResourceDictionary Source="/RibbonKit;component/Themes/Tokens.Office2024.xaml" />
                <ResourceDictionary Source="Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Host-owned Print Preview paint. Crystal overrides these in its
                 window-scoped palette; Office themes retain this baseline. -->
            <SolidColorBrush x:Key="Showcase.Brushes.PrintPreview.Canvas" Color="#6E6E6E" />
            <SolidColorBrush x:Key="Showcase.Brushes.PrintPreview.PageBorder" Color="#3F3F3F" />
            <SolidColorBrush x:Key="Showcase.Brushes.PrintPreview.TitleForeground" Color="#3F3F3F" />
            <SolidColorBrush x:Key="Showcase.Brushes.PrintPreview.BodyForeground" Color="#6B6B6B" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
