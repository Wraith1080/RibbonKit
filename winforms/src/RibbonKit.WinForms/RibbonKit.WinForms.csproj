<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>RibbonKit.WinForms</PackageId>
    <Description>Native Windows Forms ribbon controls. Foundation preview.</Description>
    <Authors>RibbonKit contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <InternalsVisibleTo Include="RibbonKit.WinForms.Tests" />
    <InternalsVisibleTo Include="RibbonKit.WinForms.NativeTests" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <!-- Match NuGet's canonical moniker for the net10.0-windows alias. -->
    <None Include="../RibbonKit.WinForms.Design/bin/$(Configuration)/$(TargetFramework)/RibbonKit.WinForms.Design.dll" Pack="true" PackagePath="lib/net10.0-windows7.0/Design/WinForms/Server/" />
  </ItemGroup>
  <Target Name="VerifyDesignBuildForPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('../RibbonKit.WinForms.Design/bin/$(Configuration)/$(TargetFramework)/RibbonKit.WinForms.Design.dll')" Text="Build RibbonKit.WinForms.sln in the same configuration before packing the runtime with its design support." />
  </Target>
</Project>
