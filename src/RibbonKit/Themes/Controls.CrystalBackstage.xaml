<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rk="clr-namespace:RibbonKit.Controls"
                    xmlns:localization="clr-namespace:RibbonKit.Localization">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Actions.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Crystal layouts share Backstage's selection, keyboard, automation and back handling. -->
    <ItemsPanelTemplate x:Key="Crystal.Backstage.FloatingItemsPanel"><WrapPanel /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Crystal.Backstage.SidebarItemsPanel"><rk:BackstageNavPanel /></ItemsPanelTemplate>

    <Style x:Key="Crystal.Backstage.Tab" TargetType="{x:Type rk:BackstageTabItem}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource RibbonKit.KeyboardFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource RibbonKit.Metrics.Backstage.NavigationFontSize}" />
        <Setter Property="Padding" Value="{DynamicResource RibbonKit.Metrics.Backstage.NavigationPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rk:BackstageTabItem}">
                    <Border x:Name="Chrome" CornerRadius="{DynamicResource RibbonKit.Metrics.Backstage.NavigationCornerRadius}" Margin="{DynamicResource RibbonKit.Metrics.Backstage.NavigationMargin}" Padding="{TemplateBinding Padding}"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <Image x:Name="NavIcon" Source="{TemplateBinding Icon}" Width="{DynamicResource RibbonKit.Metrics.Backstage.NavigationIconSize}" Height="{DynamicResource RibbonKit.Metrics.Backstage.NavigationIconSize}" Margin="{DynamicResource RibbonKit.Metrics.Backstage.NavigationIconMargin}" Visibility="Collapsed" />
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HorizontalContentAlignment" Value="Left">
                            <Setter TargetName="NavIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="NavIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Tab.HoverBackground}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Tab.HoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.CheckedBackground}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Crystal.Backstage.BackGlyph" TargetType="TextBlock">
        <Setter Property="Text" Value="←" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                         Value="RightToLeft">
                <Setter Property="Text" Value="→" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="Crystal.Backstage.FloatingTemplate" TargetType="{x:Type rk:Backstage}">
                    <Grid x:Name="RootGrid" Background="{DynamicResource RibbonKit.Brushes.Window.Background}"
                          KeyboardNavigation.TabNavigation="Cycle">
                        <Grid Margin="{DynamicResource RibbonKit.Metrics.Backstage.FloatingMargin}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <Button x:Name="PART_BackButton" DockPanel.Dock="Left"
                                        Style="{StaticResource Crystal.Backstage.Action}"
                                        AutomationProperties.Name="{localization:RibbonString Key=Back}"
                                        ToolTip="{localization:RibbonString Key=Back}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Crystal.Backstage.BackGlyph}" />
                                        <TextBlock Text="{localization:RibbonString Key=Back}" Margin="{DynamicResource RibbonKit.Metrics.Backstage.BackLabelMargin}" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <Border x:Name="NavSurface" Grid.Row="1" HorizontalAlignment="Left" Margin="{DynamicResource RibbonKit.Metrics.Backstage.FloatingNavigationMargin}" Padding="{DynamicResource RibbonKit.Metrics.Backstage.FloatingNavigationPadding}" CornerRadius="{DynamicResource RibbonKit.Metrics.Backstage.FloatingNavigationCornerRadius}"
                                    Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}" BorderThickness="1"
                                    Effect="{DynamicResource RibbonKit.Effects.ContentShadow}">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                            </Border>
                            <Grid x:Name="ContentArea" Grid.Row="2">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Translucent" Value="True">
                            <Setter TargetName="RootGrid" Property="Background" Value="Transparent" />
                            <Setter TargetName="NavSurface" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Backstage.Modern.NavBackgroundTranslucent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
    <Style x:Key="Crystal.Backstage.Style" TargetType="{x:Type rk:Backstage}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Crystal.Backstage.Tab}" />
        <Setter Property="ItemsPanel" Value="{StaticResource Crystal.Backstage.FloatingItemsPanel}" />
        <Setter Property="Template" Value="{StaticResource Crystal.Backstage.FloatingTemplate}" />
    </Style>
    <Style x:Key="Crystal.Backstage.SidebarTab" TargetType="{x:Type rk:BackstageTabItem}" BasedOn="{StaticResource Crystal.Backstage.Tab}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="{DynamicResource RibbonKit.Metrics.Backstage.SidebarNavigationPadding}" />
    </Style>
    <!-- Familiar full-height navigation and page area, with Crystal material and
         shallow separation at their edges. The floating layout remains independent. -->
    <ControlTemplate x:Key="Crystal.Backstage.SidebarTemplate" TargetType="{x:Type rk:Backstage}">
                    <Grid x:Name="RootGrid" Background="{DynamicResource RibbonKit.Brushes.Window.Background}"
                          KeyboardNavigation.TabNavigation="Cycle">
                        <Grid Margin="{DynamicResource RibbonKit.Metrics.Backstage.SidebarMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{DynamicResource RibbonKit.Metrics.Backstage.SidebarWidth}" />
                                <ColumnDefinition Width="{DynamicResource RibbonKit.Metrics.Backstage.SidebarGap}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="NavColumn" CornerRadius="{DynamicResource RibbonKit.Metrics.Backstage.SidebarCornerRadius}" BorderThickness="1"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                                    Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}">
                                <DockPanel Margin="{DynamicResource RibbonKit.Metrics.Backstage.SidebarInnerMargin}">
                                    <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource RibbonKit.Metrics.Backstage.SidebarHeaderMargin}">
                                        <Button x:Name="PART_BackButton" HorizontalAlignment="Left"
                                                Style="{StaticResource Crystal.Backstage.Action}" Padding="{DynamicResource RibbonKit.Metrics.Backstage.SidebarBackPadding}"
                                                AutomationProperties.Name="{localization:RibbonString Key=Back}"
                                                ToolTip="{localization:RibbonString Key=Back}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Crystal.Backstage.BackGlyph}" />
                                                <TextBlock Text="{localization:RibbonString Key=Back}" Margin="{DynamicResource RibbonKit.Metrics.Backstage.BackLabelMargin}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="CrystalFileHeading" Text="{localization:RibbonString Key=File}"
                                                   FontSize="{DynamicResource RibbonKit.Metrics.Backstage.SidebarHeadingFontSize}" Margin="{DynamicResource RibbonKit.Metrics.Backstage.SidebarHeadingMargin}"
                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                    </StackPanel>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </DockPanel>
                            </Border>
                            <Border x:Name="ContentArea" Grid.Column="2" CornerRadius="{DynamicResource RibbonKit.Metrics.Backstage.SidebarContentCornerRadius}" Padding="{DynamicResource RibbonKit.Metrics.Backstage.SidebarContentPadding}"
                                    BorderThickness="1" BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                                    Background="{DynamicResource RibbonKit.Brushes.Backstage.ContentBackground}"
                                    Effect="{DynamicResource RibbonKit.Effects.ContentShadow}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Translucent" Value="True">
                            <Setter TargetName="RootGrid" Property="Background" Value="Transparent" />
                            <Setter TargetName="NavColumn" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Backstage.Modern.NavBackgroundTranslucent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
    <Style x:Key="Crystal.Backstage.Sidebar" TargetType="{x:Type rk:Backstage}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Crystal.Backstage.SidebarTab}" />
        <Setter Property="ItemsPanel" Value="{StaticResource Crystal.Backstage.SidebarItemsPanel}" />
        <Setter Property="Template" Value="{StaticResource Crystal.Backstage.SidebarTemplate}" />
    </Style>
</ResourceDictionary>
