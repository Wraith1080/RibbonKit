<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- Office 2019 dark variant. Its flat square geometry still comes from the base
         Office 2019 dictionary; this overlay changes surfaces and interaction colors only. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Window.Background" Color="#171717" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.Background" Color="#252525" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.ContentBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.QatExtender.Background" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.BodyBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.SurfaceBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.Border" Color="#454545" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.QatExtender.Border" Color="#454545" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Primary" Color="#F2F2F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Secondary" Color="#B8B8B8" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScrollBar.Track" Color="#252525" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScrollBar.ButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScrollBar.ButtonBorder" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Dialog.ActionBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Dialog.ActionBorder" Color="#666666" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScrollBar.Thumb" Color="#686868" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScrollBar.ThumbHover" Color="#858585" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScrollBar.ThumbPressed" Color="#A0A0A0" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScrollBar.ThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScrollBar.Glyph" Color="#B8B8B8" />
    <system:Double x:Key="RibbonKit.Metrics.ScrollBar.Thickness">16</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ScrollBar.MinThumbLength">20</system:Double>
    <CornerRadius x:Key="RibbonKit.Metrics.ScrollBar.ButtonCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ScrollBar.ThumbCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ScrollBar.RailCornerRadius">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.ScrollBar.ThumbBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Input.Glyph" Color="#FFFFFF" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.HoverBackground" Color="#333333" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.SplitActiveHover" Color="#333333" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.PressedBackground" Color="#404040" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CheckedBackground" Color="#233F59" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CheckedHoverBackground" Color="#2B4D6C" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionBackground" Color="#2A2A2A" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ContextualBackground" Color="#294968" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ContextualHoverBackground" Color="#335878" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.Foreground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.ControlHoverBackground" Color="#343434" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.ControlPressedBackground" Color="#424242" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.ScrollButtonBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.HoverBackground" Color="#343434" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedForeground" Color="#F2F2F2" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Separator" Color="#454545" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Background" Color="#2B2B2B" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Border" Color="#585858" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemHoverBackground" Color="#333333" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedBackground" Color="#3A3A3A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Classic.NavBackground" Color="#252525" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedBorder" Color="#686868" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.NavBackground" Color="#252525" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#5A5A5A" />
        <GradientStop Offset="1" Color="#3E3E3E" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Classic2007.Foreground" Color="#F2F2F2" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Backstage.Classic2007.ShellGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D5967" />
        <GradientStop Offset="0.12" Color="#43505E" />
        <GradientStop Offset="0.45" Color="#34414F" />
        <GradientStop Offset="0.45" Color="#2D3946" />
        <GradientStop Offset="0.82" Color="#354351" />
        <GradientStop Offset="1" Color="#25303C" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ContentBackground" Color="#1E1E1E" />
    <DropShadowEffect x:Key="RibbonKit.Effects.Backstage.ContentShadow"
                      Opacity="0" BlurRadius="0" ShadowDepth="0" />
    <DropShadowEffect x:Key="RibbonKit.Effects.Backstage.ContentLeftShadow"
                      Opacity="0" BlurRadius="0" ShadowDepth="0" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.NavBackground" Color="#262626" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.Foreground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemHover" Color="#333333" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemSelected" Color="#3A3A3A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemHoverTranslucent" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemSelectedTranslucent" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.NavBackgroundTranslucent" Color="#00181818" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.OptionsDialog.RailBackground" Color="#262626" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.HoverBackground" Color="#343434" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.PressedBackground" Color="#424242" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Background" Color="#383838" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Border" Color="#707070" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Foreground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TitleBar.Background" Color="#252525" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TitleBar.Foreground" Color="#F2F2F2" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.Foreground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.HoverBackground" Color="#343434" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.PressedBackground" Color="#424242" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionBackground" Color="#292929" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionForeground" Color="#B8B8B8" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveBorder" Color="#4A4A4A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiClient.Background" Color="#141414" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.CaptionButtonHoverBackground" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.CaptionButtonPressedBackground" Color="#40FFFFFF" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.Foreground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.SecondaryForeground" Color="#D0D0D0" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.HeadingForeground" Color="#8CC8FF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameBorder" Color="#555555" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameRim" Color="#3A3A3A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameBand" Color="#262626" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.TopBandBackground" Color="#262626" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FooterBackground" Color="#262626" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.NavBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneBackground" Color="#262626" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneSurface" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneBorder" Color="#454545" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.HeaderBackground" Color="#303030" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.Separator" Color="#454545" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.SeparatorHighlight" Color="#303030" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.ButtonBackground" Color="#303030" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.ButtonBorder" Color="#5A5A5A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.MenuOpenBottom" Color="#2B579A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.InnerGlow" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.Background" Color="#433A19" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.Border" Color="#7A681F" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.Foreground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.IconForeground" Color="#75BFFF" />
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderMarginMessageBar">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.QatExtenderCornerRadiusMessageBar">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.MessageBar.Margin">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.MessageBar.LastCornerRadius">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.MessageBar.BorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.MessageBar.ExposedTopBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.CloseHoverBorder" Color="#707070" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Input.SurfaceBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Input.Border" Color="#585858" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Input.HoverBorder" Color="#B8B8B8" />
    <!-- Gallery values keep the Office visuals while allowing Crystal-specific materials. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.GalleryItem.HoverBorder" Color="#454545" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.InRibbonGallery.Border" Color="#585858" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.InRibbonGallery.SurfaceBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.InRibbonGallery.PopupBackground" Color="#1E1E1E" />
    <!-- Separate option resources preserve the Office indicator and focus appearance. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Option.IdleSurface" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Option.IdleBorder" Color="#B8B8B8" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Option.Glyph" Color="#FFFFFF" />
    <!-- ScreenTip decoration; Office geometry and paint match the prior shared template. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Surface" Color="#2B2B2B" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.OuterBorder" Color="#585858" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.OptionsDialog.NavigationHoverBackground" Color="#333333" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.OptionsDialog.NavigationSelectedBackground" Color="#233F59" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.OptionsDialog.ActionHoverBackground" Color="#333333" />

    <!-- Shared application-menu geometry; Office retains its original compact surfaces. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.InnerOutline" Color="#555555" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.ShadowCaster" Color="Black" />
    <Visibility x:Key="RibbonKit.Visibilities.ApplicationMenuOutsideShadow">Collapsed</Visibility>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuContentRimCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuContentOutlineCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuItemClipCornerRadius">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.ApplicationMenuItemMargin">0</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.ApplicationMenuSeparatorMargin">0</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.ApplicationMenuActivePageBorderThickness">1</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.ApplicationMenuActivePageMargin">0,0,2,2</Thickness>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuPaneMinimumWidth">0</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuPaneViewportInset">0</system:Double>

    <!-- Utility and scrollbar material. -->
    <system:Double x:Key="RibbonKit.Metrics.UtilityRimActiveOpacity">0</system:Double>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScrollBar.WashAccent" Color="Transparent" />
    <system:Boolean x:Key="RibbonKit.Metrics.UseUtilityScrollMaterial">False</system:Boolean>
    <system:Boolean x:Key="RibbonKit.Metrics.ContextualUseCrystalMaterial">False</system:Boolean>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ContextualForeground" Color="Transparent" />
    <!-- Contrasting keyboard outlines for accent-filled ribbon and Backstage surfaces. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyboardFocus.Light" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyboardFocus.Dark" Color="#000000" />
</ResourceDictionary>
