<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         Office 2010 ("Blue") token palette. Same keys as the other
         themes, but this is the FIRST non-flat theme: its identity is
         GRADIENTS. Where the flat themes (2013/2019) use solid fills,
         2010 uses vertical LinearGradientBrushes — a light silver-blue
         window frame, a subtly graded ribbon body, and the iconic
         amber/gold glossy highlight on hovered/pressed/toggled controls.
         The token keys are Brushes, so a gradient brush drops in wherever
         a solid one did; the shared templates never notice (they bind the
         key as a Brush via DynamicResource). Defining traits: gradient
         blue-grey chrome, dark-blue tab labels, a connected (outlined)
         selected tab, a solid blue gradient File button, amber button
         highlights, and gently rounded (2-3px) corners.
         ============================================================ -->

    <!-- Tab-strip band: the light silver-blue window-frame glass the tabs sit on.
         Its TOP stop exactly matches TitleBar.Background's BOTTOM stop so the two
         separately templated bands read as one continuous ramp. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Ribbon.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D8E5F3" />
        <GradientStop Offset="1" Color="#CBDAEC" />
    </LinearGradientBrush>
    <!-- The ribbon body (groups area): the signature 2010 gradient — lighter at the top,
         a touch darker blue-grey toward the bottom. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Ribbon.ContentBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F6F9FC" />
        <GradientStop Offset="1" Color="#DAE5F1" />
    </LinearGradientBrush>
    <!-- Solid well used by inputs and the in-ribbon gallery; do not reuse the body gradient. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.SurfaceBackground" Color="#FFFFFF" />
    <!-- Medium blue-grey outline around the ribbon body and the connected active tab. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Window.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.Border" Color="#8DA5C4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Primary" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Secondary" Color="#5C6B7F" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Input.Glyph" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Accent" Color="#1E5A9C" />

    <!-- The Office 2010 amber highlight. Unlike Office 2007's aggressive glossy gel (a hard
         crease splitting the button in two), 2010's highlight is a SMOOTH, subtle warm
         gradient — a pale-cream top easing to a soft amber bottom — paired with a thin gold
         BORDER (see Control.*Border below), which is what actually reads as the "hot" state.
         Hover glows softly, pressed is a touch deeper, and the toggled fills stay gold. -->
    <!-- Each gradient is a smooth "valley": a light top (the inner top glow), a matte
         darker middle, then a LIGHTER bottom — the small specular reflection of a real 2010
         glass button. Paired with the thin gold outer border and the semi-white inner rim
         (Control.InnerGlow, drawn as a nested border in the templates). -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Control.HoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF7CE" />
        <GradientStop Offset="0.5" Color="#FFDC8C" />
        <GradientStop Offset="0.9" Color="#FFEFB6" />
        <GradientStop Offset="1" Color="#FFFFFB" />
    </LinearGradientBrush>
    <!-- Pressed: deeper amber, pushed-in, a subtler specular. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Control.PressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F3C258" />
        <GradientStop Offset="0.5" Color="#F8CC6A" />
        <GradientStop Offset="1" Color="#FCDA86" />
    </LinearGradientBrush>
    <!-- Toggled (checked): a soft gold that stays visibly "on", same glass profile. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Control.CheckedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFEFB2" />
        <GradientStop Offset="0.5" Color="#FFD880" />
        <GradientStop Offset="0.9" Color="#FFE8A4" />
        <GradientStop Offset="1" Color="#FFF7D8" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Control.CheckedHoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFEAA2" />
        <GradientStop Offset="0.5" Color="#FFD074" />
        <GradientStop Offset="0.9" Color="#FFE196" />
        <GradientStop Offset="1" Color="#FFF2C6" />
    </LinearGradientBrush>
    <!-- Thin gold OUTER border + a semi-white INNER rim (drawn as a nested border, inset by the
         outer border) — together the defining beveled edge of a 2010 hot button. -->
    <!-- Split button "companion" state: hovering or pressing ONE half also marks the OTHER, so
         the two read as a single control rather than as two buttons that happen to touch.
         A flat theme has no highlight border, so it shows a LIGHTER version of its hover fill
         and leaves the companion border Transparent; the gradient themes (2007/2010) draw the
         amber outline plus a pale wash inside it. One pair of tokens, one pair of setters in
         Controls.DropDowns.xaml, every generation. See 04-DESIGN-NOTES §3.43. -->
    <!-- Transparent on purpose: a companion half is NOT filled. Washing the whole button made a
         merely-adjacent half look almost as hot as the hovered one. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionBackground" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionBorder" Color="#E9C25E" />
    <!-- The glow: a 1px rim drawn just inside the outline, the same trick as InnerGlow. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionGlow" Color="#CCFFF0CB" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.HoverBorder" Color="#E9C25E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.PressedBorder" Color="#CB9A34" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CheckedBorder" Color="#E0B24E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.InnerGlow" Color="#88FFFFFF" />
    <Thickness x:Key="RibbonKit.Metrics.ControlHighlightBorderThickness">1</Thickness>

    <!-- Contextual-tab band tint (a light blue wash; the per-tab ContextualColor overrides it). -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ContextualBackground" Color="#DCE8F5" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ContextualHoverBackground" Color="#CBDDF0" />

    <!-- Dark-blue tab labels — a strong 2010 identity marker. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.Foreground" Color="#15428B" />
    <!-- Hover fill for chrome buttons sitting on the tab strip (File button, minimize toggle):
         a light glass highlight. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TabStrip.ControlHoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F0F6FC" />
        <GradientStop Offset="1" Color="#DDE9F6" />
    </LinearGradientBrush>
    <!-- Held (mouse-down): the same glass INVERTED — dark at the top, light at the foot — which
         is how 2010 draws a pressed surface (the light stops hitting the top face). -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TabStrip.ControlPressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#BFD6EF" />
        <GradientStop Offset="1" Color="#DCE9F7" />
    </LinearGradientBrush>
    <!-- Fill of the tab-strip scroll chevrons. The same glass the strip itself uses, restated as
         its own token: the chevrons used to read Ribbon.Background directly, which 2024 sets
         Transparent for Mica and ThemeManager repaints with the accent on a coloured 2019 strip.
         Keep in step with Ribbon.Background above — the 2010 chevron is meant to sink into the
         band and be found by its outline. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TabStrip.ScrollButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D8E5F3" />
        <GradientStop Offset="1" Color="#CBDAEC" />
    </LinearGradientBrush>
    <!-- Unselected tab hover: a soft amber glow, like the buttons but lighter. 2010 uses
         fills (never underlines), so both underline tokens stay Transparent. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Tab.HoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF7DF" />
        <GradientStop Offset="1" Color="#FBE9B0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.HoverUnderline" Color="Transparent" />
    <!-- The active tab is a light "connected" tab that merges into the ribbon body top,
         outlined on top and sides so it reads as one piece with the body below. Its bottom
         stop is the body's own top color (#F6F9FC) so the 1px overlap (TabStripMargin bottom
         = -1) hides the body's top border seamlessly under the tab. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Tab.SelectedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FCFDFF" />
        <GradientStop Offset="1" Color="#F6F9FC" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedUnderline" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedForeground" Color="#15428B" />
    <!-- Connected-tab outline (top + sides) that cuts into the ribbon body. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedBorderBrush" Color="#8DA5C4" />
    <Thickness x:Key="RibbonKit.Metrics.TabSelectedBorderThickness">1,1,1,0</Thickness>
    <!-- Retained for token parity; the connect is now driven render-only by TabConnect (below),
         not by a layout margin (a negative margin re-measured the strip and jittered on hover). -->
    <Thickness x:Key="RibbonKit.Metrics.TabSelectedMargin">0</Thickness>
    <!-- Render-only connect: the 1px ConnectFoot at the tab bottom is shifted 1px INTO the body
         (tab-strip ZIndex covers the body's top border) so the tab merges — WITHOUT moving the
         tab itself, so its top edge and label stay on the File-button line. A RenderTransform, so
         it never re-measures the TabPanel — no hover jitter. Flat themes use identity (Y=0). -->
    <TranslateTransform x:Key="RibbonKit.Transforms.TabConnect" Y="1" />
    <!-- ConnectFoot colours = the tab's bottom fill colour, so the 1px sliver continues the tab
         over the body border seamlessly. Hover = the amber hover gradient's low stop; selected =
         the body top colour (which is also the selected tab's bottom stop). -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectFootHover" Color="#FBE9B0" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectFootSelected" Color="#F6F9FC" />
    <!-- Body-border notch (PART_ConnectNotch, in the tab control's BODY row): the ConnectFoot
         is clipped at the strip's bottom edge by PART_TabScroll, so cutting the body's #8DA5C4
         top border under the active tab is done body-side by this notch. Its colour = the body
         gradient's TOP stop (also the selected tab's bottom stop), so foot → notch → body read
         as one continuous surface. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectNotch" Color="#F6F9FC" />
    <!-- Contextual tabs: like the other pre-2024 themes, only the header text is tinted
         (no selection underline, no mute) — selection stays the connected active tab. -->
    <system:Double x:Key="RibbonKit.Metrics.ContextualUnderlineHeight">0</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ContextualUnselectedOpacity">1</system:Double>
    <!-- The File button is a tab-row button (small inset), aligned with the tab tops. -->
    <Thickness x:Key="RibbonKit.Metrics.ApplicationButtonMargin">2,2,2,0</Thickness>
    <!-- Wider than the 2024 default so the blue File tab reads as a broad block. -->
    <Thickness x:Key="RibbonKit.Metrics.ApplicationButtonPadding">22,7,22,9</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.TabStripMargin">2,2,4,0</Thickness>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Separator" Color="#B9C8DC" />
    <!-- 1 = the separator is drawn, as it always has been in this theme. -->
    <system:Double x:Key="RibbonKit.Metrics.GroupSeparatorOpacity">1</system:Double>

    <!-- Group box (Office 2007 only). This generation draws each group as a bordered, rounded box
         with a light inner rim and a shaded label band; every later generation uses a bare surface
         with a 1px separator between groups. The shared template carries both, so the flat themes
         zero these keys and the box collapses to nothing. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Background" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Border" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.InnerHighlight" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.LabelBackground" Color="Transparent" />
    <Thickness x:Key="RibbonKit.Metrics.GroupBorderThickness">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.GroupCornerRadius">0</CornerRadius>
        <!-- Group outer gap / inner content inset. These reproduce the historic hard-coded
         Margin="4,2,4,0" exactly, so this theme is unchanged. -->
    <!-- Groups-row inset / collapsed-group button margin. These reproduce the previous
         hard-coded values (Margin="6,2" on the content scroller, Margin="1" on the collapsed
         button) exactly, so this theme is unchanged. -->
    <Thickness x:Key="RibbonKit.Metrics.GroupsRowMargin">6,2</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.GroupCollapsedMargin">1</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.GroupMargin">4,2,4,0</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.GroupPadding">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.GroupLabelCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Background" Color="#FBFDFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Border" Color="#8DA5C4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemHoverBackground" Color="#2E6DB4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedBackground" Color="#17457E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Classic.NavBackground" Color="#1E5A9C" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedBorder" Color="#17578F" />
    <!-- Backstage nav column for the glass (Classic2010) design; the theme's own strip gradient,
         which is what this design used before the key existed. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Backstage.NavBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E4EDF7" />
        <GradientStop Offset="1" Color="#CBDAEC" />
    </LinearGradientBrush>
    <system:Double x:Key="RibbonKit.Metrics.BackstageBackButtonSize">36</system:Double>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ContentBackground" Color="#FFFFFF" />
    <DropShadowEffect x:Key="RibbonKit.Effects.Backstage.ContentShadow"
                      BlurRadius="9" ShadowDepth="3" Direction="180"
                      Opacity="0.24" Color="#000000" RenderingBias="Performance" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.NavBackground" Color="#F5F4F3" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.Foreground" Color="#201F1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemHover" Color="#EDEBE9" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemSelected" Color="#E1DFDD" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemHoverTranslucent" Color="#12000000" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemSelectedTranslucent" Color="#1F000000" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.NavBackgroundTranslucent" Color="#00F5F4F3" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.OptionsDialog.RailBackground" Color="#F5F4F3" />
    <!-- Classic2010 selected-item "glass" marker (glossy blue) and the dialog primary (OK)
         button glass, borrowed from the File button. -->
    <RadialGradientBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedGlass"
                         Center="0.43,0.78"
                         GradientOrigin="0.43,0.78"
                         RadiusX="0.78"
                         RadiusY="1.05">
        <GradientStop Offset="0" Color="#62A9F6" />
        <GradientStop Offset="0.45" Color="#3D86E5" />
        <GradientStop Offset="0.78" Color="#1C6ACA" />
        <GradientStop Offset="1" Color="#0F58AA" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Dialog.PrimaryBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4E97CE" />
        <GradientStop Offset="0.5" Color="#2470B2" />
        <GradientStop Offset="1" Color="#3D86C4" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Dialog.PrimaryBorder" Color="#17578F" />
    <!-- Caption buttons sit on the silver-blue GLASS title bar, so a flat wash under them read
         as a sticker on glass. Both states are gradients now, matching the band: hover is lit
         from above, pressed inverts (dark top face, specular foot) exactly like the tab-strip
         chrome buttons. An accented title bar (ThemeManager.SetAccentedTitleBar) overrides both
         keys with flat accent mixes — that mode paints a solid caption, so glass is wrong there. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.CaptionButton.HoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E4EFFA" />
        <GradientStop Offset="1" Color="#B9D2EE" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.CaptionButton.PressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#96B8DF" />
        <GradientStop Offset="1" Color="#C3D9F0" />
    </LinearGradientBrush>
    <!-- Safety-net defaults for the QAT-on-colored-band hover/pressed wash. The Ribbon
         overrides both keys per-button with the live caption/tab band brushes
         (Ribbon.UpdateQatButtonContext); these only surface if a trigger fires first. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Qat.ColoredHoverBackground" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Qat.ColoredPressedBackground" Color="#4DFFFFFF" />
    <!-- Close: the same glass treatment in red, so it reads as one family with its neighbours
         instead of a flat modern block dropped onto a glossy caption. Pressed stays LIGHTER
         than hover — the convention every other generation here follows. (Also used by the MDI
         child close button, which wants the identical look.) -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.CaptionButton.CloseHoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F06A74" />
        <GradientStop Offset="0.5" Color="#DA1526" />
        <GradientStop Offset="1" Color="#EC4C58" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.CaptionButton.ClosePressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F79FA6" />
        <GradientStop Offset="0.5" Color="#EE5F6B" />
        <GradientStop Offset="1" Color="#F58A93" />
    </LinearGradientBrush>

    <!-- KeyTip badges: the small gradient chip of the 2007/2010 era — a light glassy box
         with a blue-grey border and dark text. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.KeyTip.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FDFEFF" />
        <GradientStop Offset="1" Color="#E1E8F0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Border" Color="#8DA5C4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Foreground" Color="#1E1E1E" />

    <!-- Title bar: the light silver-blue Aero-style glass gradient of the 2010 Blue scheme.
         Its bottom stop is the tab-strip band's top stop, avoiding a bright reset at the seam.
         The Colored Title Bar option (ThemeManager.SetAccentedTitleBar) swaps this to an
         accent-derived caption ramp with white text. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#EAF1F9" />
        <GradientStop Offset="1" Color="#D8E5F3" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.TitleBar.Foreground" Color="#1E1E1E" />

    <!-- Office 2010 File button: a SMOOTH blue block with white text and a thin blue border
         (no hard crease — that was the wrong, 2007 look), a brighter blue on hover, no
         underline. A custom accent re-tints it to a gradient (see ThemeManager's Office2010 case). -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationButton.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4E97CE" />
        <GradientStop Offset="0.5" Color="#2470B2" />
        <GradientStop Offset="1" Color="#3D86C4" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.Foreground" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationButton.HoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#63A9DD" />
        <GradientStop Offset="0.5" Color="#3382C2" />
        <GradientStop Offset="1" Color="#4E96CE" />
    </LinearGradientBrush>
    <!-- Mouse-DOWN (pressed) glass: a deeper, recessed blue gel shown while the button is held. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationButton.PressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2C71AC" />
        <GradientStop Offset="0.5" Color="#175792" />
        <GradientStop Offset="1" Color="#276CA4" />
    </LinearGradientBrush>
    <!-- Open Backstage: retain the same dimensional blue glass as the other File states instead
         of flattening to a solid block. The scoped radial rim below supplies the lower bloom. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationButton.MenuOpenBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3E8BC5" />
        <GradientStop Offset="0.5" Color="#1E62A1" />
        <GradientStop Offset="1" Color="#3277B4" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.MenuOpenForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.HoverUnderline" Color="Transparent" />
    <!-- Thin blue edge around the File button. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.Border" Color="#17578F" />
    <!-- A faint inner rim whose strongest point sits below the lower center. This avoids the
         uniform white foot that made the File button look fluorescent instead of glassy. -->
    <RadialGradientBrush x:Key="RibbonKit.Brushes.ApplicationButton.InnerGlow"
                         Center="0.5,1.12"
                         GradientOrigin="0.5,1.12"
                         RadiusX="0.78"
                         RadiusY="1.12">
        <GradientStop Offset="0" Color="#58FFFFFF" />
        <GradientStop Offset="0.55" Color="#2CFFFFFF" />
        <GradientStop Offset="1" Color="#14FFFFFF" />
    </RadialGradientBrush>
    <!-- Orb tokens. This theme uses the rectangular File tab, so these only matter if an app opts
         into Ribbon.ApplicationButtonShape = Orb anyway. Kept at the 2007 geometry minus the
         overhang, so an orb here sits neatly inside the tab strip. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationOrb.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FBFCFD" />
        <GradientStop Offset="0.5" Color="#DDE4EC" />
        <GradientStop Offset="1" Color="#FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationOrb.HoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFEFC" />
        <GradientStop Offset="0.5" Color="#F7C93E" />
        <GradientStop Offset="1" Color="#FDFAB7" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationOrb.PressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F5D98A" />
        <GradientStop Offset="0.5" Color="#D8931A" />
        <GradientStop Offset="1" Color="#F7D06A" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationOrb.Ring" Color="#F0F4F9" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationOrb.HoverRing" Color="#FFEA37" />
    <DropShadowEffect x:Key="RibbonKit.Effects.ApplicationOrbShadow"
                      BlurRadius="5" ShadowDepth="1" Direction="270"
                      Opacity="0.5" Color="#2E4257" RenderingBias="Quality" />
    <!-- Left inset of the title-bar QAT; reproduces the previous hard-coded 2,0,6,0. -->
    <Thickness x:Key="RibbonKit.Metrics.TitleBarQatMargin">2,0,6,0</Thickness>
    <system:Double x:Key="RibbonKit.Metrics.WindowFrame.CaptionHeight">34</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.WindowFrame.InactiveTitleBarOpacity">1</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationOrbSize">46</system:Double>
    <Thickness x:Key="RibbonKit.Metrics.ApplicationOrbMargin">2,0,6,0</Thickness>

    <Thickness x:Key="RibbonKit.Metrics.ApplicationButtonBorderThickness">1</Thickness>

    <system:Double x:Key="RibbonKit.Metrics.GroupsRowHeight">104</system:Double>

    <!-- Gently rounded (2-3px) corners — softer than the flat themes, subtler than 2024. -->
    <CornerRadius x:Key="RibbonKit.Metrics.ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SmallControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.PopupCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.TabCornerRadius">3,3,0,0</CornerRadius>
    <!-- Top-only, same as a tab: the 2010 File button is physically connected to the
         ribbon body, so a rounded foot would open a gap under it. -->
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationButtonCornerRadius">3,3,0,0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitLeftCornerRadius">3,0,0,3</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitRightCornerRadius">0,3,3,0</CornerRadius>
    <!-- Vertical split button (Large only): the same rounding rotated a quarter turn. -->
    <CornerRadius x:Key="RibbonKit.Metrics.SplitTopCornerRadius">3,3,0,0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitBottomCornerRadius">0,0,3,3</CornerRadius>

    <!-- Ribbon body: a full outline, square corners. The connect is done by moving the SELECTED
         TAB down 1px into the body (TabSelectedMargin, below) — the mechanism that actually works
         — rather than moving the body up, so ContentMargin stays at 0. -->
    <Thickness x:Key="RibbonKit.Metrics.ContentBorderThickness">1</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.ContentMargin">0</Thickness>
    <!-- Minimized: stands in for the vanished body outline's top edge — see the 2007 token. -->
    <system:Double x:Key="RibbonKit.Metrics.MinimizedDividerHeight">1</system:Double>
    <CornerRadius x:Key="RibbonKit.Metrics.ContentCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ContentCornerRadiusTop">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.ContentMarginQatBelow">0</Thickness>

    <!-- A faint shadow under the ribbon body, separating it from the document (2010's ribbon
         is connected to the chrome, so this is subtle — not the floating card of 2024). -->
    <DropShadowEffect x:Key="RibbonKit.Effects.ContentShadow"
                      BlurRadius="6" ShadowDepth="1" Direction="270"
                      Opacity="0.12" Color="#000000" RenderingBias="Performance" />

    <!-- Flat below-ribbon QAT: a plain full-width strip with a bottom border. -->
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderMargin">0</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderBorderThickness">0,0,0,1</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.QatExtenderCornerRadius">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderMarginMessageBar">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.QatExtenderCornerRadiusMessageBar">0</CornerRadius>

    <!-- The minimized QAT keeps the same full-width, bottom-bordered strip (no floating card). -->
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderMarginMinimized">0</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderBorderThicknessMinimized">0,0,0,1</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.QatExtenderCornerRadiusMinimized">0</CornerRadius>

    <!-- MDI child-window chrome. 2010: glass-gradient captions on the blue-grey
         workspace, gently rounded like the rest of the chrome. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.MdiChild.ActiveCaptionBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#6B9BD2" />
        <GradientStop Offset="0.5" Color="#4477B3" />
        <GradientStop Offset="1" Color="#2E5E9E" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.ActiveCaptionForeground" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F0F4FA" />
        <GradientStop Offset="1" Color="#D9E2EF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionForeground" Color="#3B5A82" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.ActiveBorder" Color="#2E5E9E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveBorder" Color="#A8BED8" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiClient.Background" Color="#AEC3DE" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.CaptionButtonHoverBackground" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.CaptionButtonPressedBackground" Color="#66FFFFFF" />
    <system:Double x:Key="RibbonKit.Metrics.MdiChild.CaptionHeight">30</system:Double>
    <CornerRadius x:Key="RibbonKit.Metrics.MdiChild.CornerRadius">3</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.MdiChild.CaptionCornerRadius">2,2,0,0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.MdiChild.CloseButtonCornerRadius">0,2,0,0</CornerRadius>

    <!-- ============================================================
         APPLICATION MENU (Office 2007's two-pane orb drop-down).
         2010 has no application menu of its own (it shipped the backstage), so these are a
         soft-glass translation of the 2007 geometry into this generation's blue-grey palette —
         there if an app asks for the menu under this theme, invisible otherwise.
         ============================================================ -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.Foreground" Color="#202020" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.SecondaryForeground" Color="#474747" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.HeadingForeground" Color="#174F90" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameBorder" Color="#8DA5C4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameRim" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameBand" Color="#D6E2F0" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationMenu.TopBandBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#EDF3FA" />
        <GradientStop Offset="1" Color="#D9E5F2" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FooterBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E4EDF7" />
        <GradientStop Offset="1" Color="#CBDAEC" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.NavBackground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneBackground" Color="#ECEFF4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneBorder" Color="#A7B8CE" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.HeaderBackground" Color="#DCE6F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.Separator" Color="#C3CFDF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.SeparatorHighlight" Color="#F5F8FC" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationMenu.ButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F6FAFE" />
        <GradientStop Offset="1" Color="#DCE9F8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.ButtonBorder" Color="#8DA5C4" />

    <DropShadowEffect x:Key="RibbonKit.Effects.ApplicationMenuShadow"
                      BlurRadius="10"
                      ShadowDepth="3"
                      Direction="270"
                      Opacity="0.3"
                      Color="#000000" />
    <DropShadowEffect x:Key="RibbonKit.Effects.ApplicationButtonMenuOpenShadow"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.24"
                      Color="#000000" />

    <system:Boolean x:Key="RibbonKit.Behaviors.ApplicationMenuAnchorBelowButton">True</system:Boolean>
    <Thickness x:Key="RibbonKit.Metrics.ApplicationMenuMargin">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuInnerCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuTopBandCornerRadius">1,1,0,0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuFooterCornerRadius">0,0,1,1</CornerRadius>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuNavWidth">140</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuPaneWidth">330</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuItemHeight">48</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuArrowWidth">28</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuTopBandHeight">10</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuFooterHeight">32</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuDimOpacity">0.35</system:Double>

    <LinearGradientBrush x:Key="RibbonKit.Brushes.MessageBar.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFE4" />
        <GradientStop Offset="0.38" Color="#FFF8D0" />
        <GradientStop Offset="0.72" Color="#FFF0B5" />
        <GradientStop Offset="1" Color="#FFF7D2" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.Border" Color="#D9B451" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.Foreground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.IconForeground" Color="#1E5A9C" />
    <Thickness x:Key="RibbonKit.Metrics.MessageBar.Margin">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.MessageBar.LastCornerRadius">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.MessageBar.BorderThickness">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.CloseHoverBorder" Color="#A67924" />
</ResourceDictionary>
