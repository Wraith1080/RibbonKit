<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls"
    xmlns:localization="clr-namespace:RibbonKit.Localization"
    xmlns:layout="clr-namespace:RibbonKit.Layout">

    <!-- Part of the shared RibbonKit control-template dictionary; merged by Office2024.xaml.
         Ribbon root + RibbonTabControl.
         Colours/metrics come from Tokens.Office20XX.xaml via {DynamicResource}. -->

    <!-- MUST merge Controls.Shared.xaml locally: a StaticResource inside a merged
         dictionary does NOT resolve against SIBLING dictionaries merged by the same
         parent, only against this dictionary and the ones IT merges. RibbonKit.BoolToVis, RibbonKit.ScrollLeftButton/ScrollRightButton and
         RibbonKit.MergedCaptionButton are used by StaticResource below.
         (Also listed in Office2024.xaml; WPF caches dictionaries by Source URI.) -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Shared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         Ribbon
         ============================================================ -->
    <Style TargetType="{x:Type controls:Ribbon}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.Ribbon.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <!-- A ribbon sits at the TOP of its space and never stretches to fill. Without this, a
             ribbon that becomes a DockPanel's last child (LastChildFill) or lands in a * Grid row
             stretches vertically and the body drifts down. Consumers can still override. -->
        <Setter Property="VerticalAlignment" Value="Top" />
        <!-- Paint ABOVE the app's content. The 2007/2010/2024 bodies cast a downward drop shadow
             (Effects.ContentShadow), and an Effect renders OUTSIDE the element's layout bounds —
             straight into whatever sits below. Panel siblings paint in declaration order, and the
             content area is declared after the ribbon, so its opaque background covered the shadow
             and erased it. Nothing clips the shadow; it only ever needed to be drawn last.
             (The bug hid itself under Mica/Acrylic, where hosts make that background transparent
             and the shadow reappears — which made it look like a backdrop feature rather than a
             paint-order bug.) Consumers can still override. -->
        <Setter Property="Panel.ZIndex" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Ribbon}">
                    <!-- The backstage overlay is hosted in the window's adorner layer
                         by the Ribbon class itself (see BackstageAdorner), not here. -->
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:RibbonTabControl
                                x:Name="TabControlHost"
                                Grid.Row="0"
                                ItemsSource="{TemplateBinding Tabs}"
                                SelectedItem="{Binding SelectedTab, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <!-- Quick access row shown when QuickAccessPosition=BelowRibbon.
                                 Styled as an extender chip that tucks under the ribbon
                                 card (Office 2024); flat themes render a plain strip. -->
                            <Border x:Name="QatBelowHost"
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    Margin="{DynamicResource RibbonKit.Metrics.QatExtenderMargin}"
                                    Padding="8,2"
                                    Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.QatExtenderBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.QatExtenderCornerRadius}"
                                    Effect="{DynamicResource RibbonKit.Effects.ContentShadow}"
                                    Visibility="Collapsed">
                                <!-- ItemsSource bound only by the BelowRibbon trigger. -->
                                <ItemsControl x:Name="QatBelowItems"
                                              Focusable="False"
                                              Margin="4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>

                            <!-- A message bar hosted through Ribbon.MessageBar is part of the
                                 ribbon surface, not an unrelated document sibling. Its own
                                 HasOpenMessages state drives the continuation geometry above. -->
                            <ContentPresenter x:Name="MessageBarHost"
                                              Grid.Row="2"
                                              Content="{TemplateBinding MessageBar}"
                                              Focusable="False" />

                            <!-- Application menus are direct ribbon-template siblings. This lets
                                 the menu cover the QAT/messages without promoting the
                                 RibbonTabControl body (and its shadow) with it. Ribbon assigns and
                                 positions the menu in code because a UIElement can have only one
                                 visual parent. The small host below temporarily receives the real
                                 historical orb while its menu is open; the nested presenter remains
                                 a compatibility fallback for custom templates that omit this outer
                                 layer. -->
                            <Canvas x:Name="ApplicationMenuOverlayLayer"
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Panel.ZIndex="2"
                                    Width="0"
                                    Height="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <ContentPresenter x:Name="PART_ApplicationMenuOverlayPresenter"
                                                  Margin="{DynamicResource RibbonKit.Metrics.ApplicationMenuMargin}"
                                                  Visibility="Collapsed" />
                                <Border x:Name="PART_ApplicationButtonOverlay"
                                        Panel.ZIndex="1"
                                        Visibility="Collapsed" />
                            </Canvas>

                            <!-- Design-time-only backstage preview surface. At runtime the
                                 backstage is hosted in the WINDOW's adorner layer (see
                                 Ribbon.UpdateBackstageOverlay); that path needs a real Window,
                                 which the XAML designer doesn't provide, so the Ribbon routes the
                                 backstage into this in-template host instead while in design mode.
                                 Stays Collapsed and empty at runtime — the code only fills it under
                                 DesignerProperties.GetIsInDesignMode. MinHeight just gives the
                                 preview room on the surface; it has no effect while Collapsed. -->
                            <Border x:Name="PART_DesignBackstageHost"
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Visibility="Collapsed"
                                    MinHeight="440"
                                    Background="{DynamicResource RibbonKit.Brushes.Backstage.ContentBackground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="QuickAccessPosition" Value="BelowRibbon">
                            <Setter TargetName="QatBelowHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="QatBelowItems" Property="ItemsSource">
                                <Setter.Value>
                                    <Binding Path="QuickAccessItems"
                                             RelativeSource="{RelativeSource AncestorType={x:Type controls:Ribbon}}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Minimized + QAT below: the ribbon body card is collapsed, so the
                             QAT bar is left standing alone under the tab strip. Make it a
                             self-contained floating card — round ALL corners (not just the
                             bottom), border it all the way around, and give it the small top
                             gap the card used to occupy — matching Office. It reverts to the
                             flush-connected strip automatically when the ribbon is restored.
                             Flat themes (2019/2013) point these tokens at their strip values,
                             so nothing changes shape for them. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="QuickAccessPosition" Value="BelowRibbon" />
                                <Condition Property="IsMinimized" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="QatBelowHost" Property="CornerRadius"
                                    Value="{DynamicResource RibbonKit.Metrics.QatExtenderCornerRadiusMinimized}" />
                            <Setter TargetName="QatBelowHost" Property="BorderThickness"
                                    Value="{DynamicResource RibbonKit.Metrics.QatExtenderBorderThicknessMinimized}" />
                            <Setter TargetName="QatBelowHost" Property="Margin"
                                    Value="{DynamicResource RibbonKit.Metrics.QatExtenderMarginMinimized}" />
                        </MultiTrigger>
                        <!-- An open message continues the ribbon downward. Remove only the lower
                             card gap/rounding from a below-ribbon QAT so the first notification
                             begins at the very next pixel. Keep the QAT shadow: the connected
                             ribbon and message stack intentionally retain their own depth layers. -->
                        <Trigger Property="HasOpenMessages" Value="True">
                            <Setter TargetName="QatBelowHost" Property="CornerRadius"
                                    Value="{DynamicResource RibbonKit.Metrics.QatExtenderCornerRadiusMessageBar}" />
                            <Setter TargetName="QatBelowHost" Property="Margin"
                                    Value="{DynamicResource RibbonKit.Metrics.QatExtenderMarginMessageBar}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonTabControl — tab strip on top, groups row below
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonTabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonTabControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- ZIndex above the ribbon body (Row 1): where a theme overlaps the
                             selected tab into the body (Office 2010's TabStripMargin bottom = -1),
                             the tab must paint OVER the body's top border to connect into it. -->
                        <Grid Grid.Row="0" Panel.ZIndex="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Compatibility fallback for custom Ribbon templates that omit the
                                 outer application-menu layer. The shipping template leaves this
                                 presenter empty so the Ribbon body never has to be promoted above
                                 the QAT/message rows. -->
                            <Canvas x:Name="ApplicationMenuLayer"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Panel.ZIndex="1"
                                    Width="0"
                                    Height="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <ContentPresenter x:Name="PART_ApplicationMenuPresenter"
                                                  Margin="{DynamicResource RibbonKit.Metrics.ApplicationMenuMargin}"
                                                  Visibility="Collapsed" />
                            </Canvas>

                            <!-- Left end of the tab strip row: the merged-caption icon (only while
                                 a caption is docked — classic MDI puts a maximized child's system
                                 icon here) followed by the application button. Grouped in a stack
                                 so the icon needs no column of its own. -->
                            <!-- Stretch, NOT Center: the application button has no VerticalAlignment
                                 of its own, so it fills whatever height its parent gives it. Office
                                 2013 draws it as a solid accent block that must run to the bottom
                                 edge of the row to meet the body — centering this stack left a thin
                                 gap under it. The caption icon inside centres itself explicitly. -->
                            <StackPanel x:Name="ApplicationButtonLayer"
                                        Grid.Column="0"
                                        Panel.ZIndex="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Stretch">
                            <Image x:Name="PART_MergedCaptionIcon"
                                   Width="16"
                                   Height="16"
                                   Margin="8,4,2,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   Source="{Binding MergedCaptionIcon, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                   Visibility="{Binding HasMergedCaption, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}, Converter={StaticResource RibbonKit.BoolToVis}}" />
                            <!-- Application (File) button: opens the backstage, or the application
                                 menu when the ribbon has one; hidden when it has neither. -->
                            <!-- WindowChrome.IsHitTestVisibleInChrome: the orb overhangs UP into the
                                 caption region, and the caption swallows input as a window drag, so
                                 only the part below the caption line was clickable. This opts the
                                 button back into normal hit testing. No-op for the rectangular File
                                 tab, which never reaches the caption. -->
                            <!-- PART_ prefixed because RibbonApplicationMenu's click-outside
                                 dismissal recognises this button BY NAME and stands down for it —
                                 see Ribbon.ApplicationButtonPartName. Renaming it here breaks the
                                 orb's close-on-second-click. -->
                            <ToggleButton x:Name="PART_ApplicationButton"
                                          WindowChrome.IsHitTestVisibleInChrome="True"
                                          AutomationProperties.Name="{Binding EffectiveApplicationButtonHeader, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                          ToolTip="{Binding EffectiveApplicationButtonHeader, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                          Margin="{DynamicResource RibbonKit.Metrics.ApplicationButtonMargin}"
                                          Content="{Binding EffectiveApplicationButtonHeader, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                          IsChecked="{Binding IsBackstageOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="{x:Type ToggleButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.ApplicationButton.Foreground}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                    <!-- The File tab hovers exactly like the other tabs:
                                                         same Tab.HoverBackground + Tab.HoverUnderline tokens,
                                                         so its hover style tracks the theme automatically. -->
                                                    <Grid>
                                                        <!-- Its OWN corner radius, not TabCornerRadius: 2010/2007/2013
                                                             keep the tab's top-only rounding because their File button
                                                             is physically connected to the ribbon, but 2024's is a
                                                             free-standing pill sitting ABOVE the card — reusing the
                                                             tab radius there left the pressed/backstage-open fill with
                                                             square bottom corners. -->
                                                        <Border x:Name="Chrome"
                                                                Background="{DynamicResource RibbonKit.Brushes.ApplicationButton.Background}"
                                                                BorderBrush="{DynamicResource RibbonKit.Brushes.ApplicationButton.Border}"
                                                                BorderThickness="{DynamicResource RibbonKit.Metrics.ApplicationButtonBorderThickness}"
                                                                CornerRadius="{DynamicResource RibbonKit.Metrics.ApplicationButtonCornerRadius}"
                                                                SnapsToDevicePixels="True">
                                                            <Grid>
                                                                <!-- File-specific inner rim. Office 2010 supplies a faint
                                                                     radial brush with a lower-center bloom; flat generations
                                                                     supply Transparent. It is suppressed while pressed below. -->
                                                                <Border x:Name="InnerRim"
                                                                        BorderBrush="{DynamicResource RibbonKit.Brushes.ApplicationButton.InnerGlow}"
                                                                        BorderThickness="{DynamicResource RibbonKit.Metrics.ApplicationButtonBorderThickness}"
                                                                        CornerRadius="{DynamicResource RibbonKit.Metrics.ApplicationButtonCornerRadius}"
                                                                        IsHitTestVisible="False" />
                                                                <ContentPresenter Margin="{DynamicResource RibbonKit.Metrics.ApplicationButtonPadding}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Rectangle x:Name="HoverUnderline"
                                                                   Height="2.5"
                                                                   RadiusX="1.25"
                                                                   RadiusY="1.25"
                                                                   Margin="10,0"
                                                                   VerticalAlignment="Bottom"
                                                                   Fill="{DynamicResource RibbonKit.Brushes.ApplicationButton.HoverUnderline}"
                                                                   Visibility="Collapsed" />
                                                        <!-- Office 2007 ORB, shown instead of Chrome when
                                                             Ribbon.ApplicationButtonShape is Orb. Top-aligned
                                                             with a negative top margin so it straddles the
                                                             tab-strip / title-bar boundary like the real one.
                                                             The glyph is built in because
                                                             ApplicationButtonHeader is a string and cannot
                                                             render inside a 37px circle; the header becomes
                                                             the accessible name instead. -->
                                                        <Grid x:Name="Orb"
                                                              Visibility="Collapsed"
                                                              VerticalAlignment="Top"
                                                              Width="{DynamicResource RibbonKit.Metrics.ApplicationOrbSize}"
                                                              Height="{DynamicResource RibbonKit.Metrics.ApplicationOrbSize}"
                                                              Margin="{DynamicResource RibbonKit.Metrics.ApplicationOrbMargin}">
                                                            <!-- The dark edge of a real orb is a soft
                                                                 SHADOW plus a light rim, not a dark
                                                                 stroke. No inset highlight ring: a full
                                                                 circle reads as a hard band, and the
                                                                 sphere gradient already carries the
                                                                 top-arc highlight. -->
                                                            <Ellipse x:Name="OrbFill"
                                                                     Fill="{DynamicResource RibbonKit.Brushes.ApplicationOrb.Background}"
                                                                     Stroke="{DynamicResource RibbonKit.Brushes.ApplicationOrb.Ring}"
                                                                     StrokeThickness="1.5"
                                                                     Effect="{DynamicResource RibbonKit.Effects.ApplicationOrbShadow}" />
                                                            <!-- Rotate this glyph host during the Classic 2007
                                                                 Backstage transition. The spherical fill, rim, and
                                                                 drop shadow remain stationary. -->
                                                            <Viewbox x:Name="OrbGlyph" Margin="13" Stretch="Uniform">
                                                                <Grid Width="16" Height="16">
                                                                    <Rectangle Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                                                               HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#E8762C" />
                                                                    <Rectangle Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                                                               HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#5FA92C" />
                                                                    <Rectangle Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#2C7FD1" />
                                                                    <Rectangle Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                                                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#F2B705" />
                                                                </Grid>
                                                            </Viewbox>
                                                        </Grid>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationButton.HoverBackground}" />
                                                            <Setter TargetName="HoverUnderline" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <!-- Mouse-DOWN (held, before release): a distinct pressed glass, so
                                                             the click reads immediately, not only once the backstage opens. -->
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationButton.PressedBackground}" />
                                                            <Setter TargetName="InnerRim" Property="Opacity" Value="0" />
                                                            <Setter TargetName="HoverUnderline" Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                        <!-- Backstage open: File highlights in accent, like Office -->
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.Accent}" />
                                                            <Setter TargetName="HoverUnderline" Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                        <!-- A menu-open File tab is the visual anchor for a
                                                             floating surface. Its fill/foreground get their own
                                                             tokens so a colored tab band can connect the button
                                                             to the neutral menu without changing the backstage's
                                                             accent-open state. The effect is independently tokenized
                                                             from the menu shadow: connected themes use a compact
                                                             downward lift, while 2024 lets it breathe across the gap.
                                                             The hidden orb ignores all three setters. -->
                                                        <DataTrigger Binding="{Binding IsApplicationMenuOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                                                     Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationButton.MenuOpenBackground}" />
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationButton.MenuOpenForeground}" />
                                                            <Setter TargetName="Chrome" Property="Effect"
                                                                    Value="{DynamicResource RibbonKit.Effects.ApplicationButtonMenuOpenShadow}" />
                                                        </DataTrigger>
                                                        <!-- Orb mode. LAST in the list on purpose: the
                                                             hover/pressed/checked triggers above re-show
                                                             HoverUnderline, and the last matching setter for
                                                             a property wins, so this must follow them. -->
                                                        <DataTrigger Binding="{Binding ApplicationButtonShape, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                                                     Value="Orb">
                                                            <Setter TargetName="Chrome" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="HoverUnderline" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="Orb" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ApplicationButtonShape, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}" Value="Orb" />
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="OrbFill" Property="Fill"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.HoverBackground}" />
                                                            <Setter TargetName="OrbFill" Property="Stroke"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.HoverRing}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ApplicationButtonShape, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}" Value="Orb" />
                                                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="OrbFill" Property="Fill"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.PressedBackground}" />
                                                            <Setter TargetName="OrbFill" Property="Stroke"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.HoverRing}" />
                                                        </MultiDataTrigger>
                                                        <!-- Ordinary Backstage leaves this orb in the original ribbon
                                                             layer. RibbonWindow clips that subtree at the content-row
                                                             boundary while the Backstage adorner covers the remainder,
                                                             so the opening surface naturally unfurls above the orb.
                                                             Application-menu layering remains unchanged. -->
                                                        <!-- Classic2007 moves this exact ToggleButton into the window
                                                             adorner. Its stable Ribbon owner is stored in Tag immediately
                                                             before the move, so these final setters preserve the real orb
                                                             after normal ancestor-based template bindings lose their path. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag.Backstage.Design, RelativeSource={RelativeSource TemplatedParent}}" Value="Classic2007" />
                                                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Chrome" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="HoverUnderline" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="Orb" Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag.Backstage.Design, RelativeSource={RelativeSource TemplatedParent}}" Value="Classic2007" />
                                                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="OrbFill" Property="Fill"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.HoverBackground}" />
                                                            <Setter TargetName="OrbFill" Property="Stroke"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.HoverRing}" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Tag.Backstage.Design, RelativeSource={RelativeSource TemplatedParent}}" Value="Classic2007" />
                                                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="OrbFill" Property="Fill"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.PressedBackground}" />
                                                            <Setter TargetName="OrbFill" Property="Stroke"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.HoverRing}" />
                                                        </MultiDataTrigger>
                                                        <!-- Application menu open: the orb stays put and
                                                             holds a lit "pressed" gel, so it reads as the
                                                             thing the open menu belongs to. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ApplicationButtonShape, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}" Value="Orb" />
                                                                <Condition Binding="{Binding IsApplicationMenuOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Orb" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="OrbFill" Property="Fill"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.PressedBackground}" />
                                                            <Setter TargetName="OrbFill" Property="Stroke"
                                                                    Value="{DynamicResource RibbonKit.Brushes.ApplicationOrb.HoverRing}" />
                                                        </MultiDataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- Hidden only when there is NOTHING to open. A ribbon
                                                 may carry an application menu without a backstage
                                                 (Office 2007) or the other way round, and either one
                                                 is reason enough to show the button. -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Backstage, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}" Value="{x:Null}" />
                                                    <Condition Binding="{Binding ApplicationMenu, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                            <!-- A modal tab (Print Preview) hides File entirely, like
                                                 Word: the backstage is blocked in that mode, so leaving
                                                 the button visible would offer a dead affordance. -->
                                             <DataTrigger Binding="{Binding IsModal, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                                          Value="True">
                                                 <Setter Property="Visibility" Value="Collapsed" />
                                             </DataTrigger>
                                             <MultiDataTrigger>
                                                 <MultiDataTrigger.Conditions>
                                                     <Condition Binding="{Binding Tag.Backstage.Design, RelativeSource={RelativeSource Self}}" Value="Classic2007" />
                                                     <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                                 </MultiDataTrigger.Conditions>
                                                 <Setter Property="Visibility" Value="Visible" />
                                             </MultiDataTrigger>
                                         </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            </StackPanel>
                            <!-- Quick access strip in the tab row (QuickAccessPosition=TabRow).
                                 ItemsSource is bound ONLY by the TabRow trigger below, never
                                 by default — the same live QAT UIElements can have only one
                                 parent, so exactly one host (tab-row or below-ribbon) may
                                 bind at a time. -->
                            <controls:RibbonQuickAccessToolBar
                                x:Name="QatTabRowHost"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Margin="2,4,4,0"
                                MaxWidth="{Binding QuickAccessMaxWidth, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}" />
                            <Grid Grid.Column="2">
                                <!-- Tab strip in a horizontal scroller: when there are more tabs than
                                     fit, chevron buttons appear and scroll the strip. The gliding
                                     PART_TabMarker lives INSIDE the scroller with the TabPanel so it
                                     scrolls in lockstep and stays under its tab. -->
                                <layout:RibbonScrollContentHost x:Name="PART_TabScroll" ConstrainChildWidth="False">
                                    <Grid>
                                        <TabPanel IsItemsHost="True"
                                                  Margin="{DynamicResource RibbonKit.Metrics.TabStripMargin}"
                                                  Background="Transparent" />
                                        <!-- Shared selection underline that GLIDES between tabs
                                             (RibbonTabControl positions/animates it). Replaces the
                                             per-tab SelectionIndicator/ContextualSelectionIndicator for
                                             the accent underline; flat themes (2019/2013) leave
                                             Tab.SelectedUnderline Transparent, so it's invisible there
                                             and those themes keep their pill/fill selection. Width +
                                             TranslateTransform.X are animated (X glide + width) — a lone
                                             marker in its own cell, so animating Width re-arranges only
                                             itself and never cascades a ribbon re-layout. -->
                                        <Rectangle x:Name="PART_TabMarker"
                                                   Height="3" Width="0"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   IsHitTestVisible="False"
                                                   Opacity="0"
                                                   Fill="{DynamicResource RibbonKit.Brushes.Tab.SelectedUnderline}">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="PART_TabMarkerTranslate" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                </layout:RibbonScrollContentHost>
                                <!-- These two overlay the strip's edges, so they need the SAME top
                                     inset as the strip itself: the tabs live inside PART_TabScroll
                                     and are pushed down by TabStripMargin, while the chevrons are
                                     its siblings and stretch to the full row. Binding the margin
                                     to the very same token makes them sit level with the tabs in
                                     every generation instead of floating above them — and it
                                     explains why only 2013 ever looked right, its TabStripMargin
                                     being the one with a top of 0.

                                     Background is its OWN token, not Ribbon.Background: that one
                                     is Transparent in 2024 (for Mica), which left the chevron a
                                     bare outline, and ThemeManager repaints it with the accent on
                                     a coloured 2019 strip, which turned the chevron accent-on-dark
                                     instead of reading like the selected tab. -->
                                <RepeatButton Style="{StaticResource RibbonKit.ScrollLeftButton}"
                                              HorizontalAlignment="Left"
                                              Margin="{DynamicResource RibbonKit.Metrics.TabStripMargin}"
                                              Background="{DynamicResource RibbonKit.Brushes.TabStrip.ScrollButtonBackground}"
                                              Command="{Binding ScrollLeftCommand, ElementName=PART_TabScroll}"
                                              Visibility="{Binding CanScrollLeft, ElementName=PART_TabScroll, Converter={StaticResource RibbonKit.BoolToVis}}" />
                                <RepeatButton Style="{StaticResource RibbonKit.ScrollRightButton}"
                                              HorizontalAlignment="Right"
                                              Margin="{DynamicResource RibbonKit.Metrics.TabStripMargin}"
                                              Background="{DynamicResource RibbonKit.Brushes.TabStrip.ScrollButtonBackground}"
                                              Command="{Binding ScrollRightCommand, ElementName=PART_TabScroll}"
                                              Visibility="{Binding CanScrollRight, ElementName=PART_TabScroll, Converter={StaticResource RibbonKit.BoolToVis}}" />
                            </Grid>
                            <!-- Right end of the tab strip row: the modal-tab close affordance
                                 (only while a modal tab is active) followed by the minimize
                                 chevron. Grouped in a stack so neither needs its own column. -->
                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                            <!-- Modal tab (Print Preview) close: leaves modal mode via the
                                 ribbon's ExitModalCommand. Shows the tab's CloseButtonText when
                                 set ("Close Print Preview"), otherwise a bare × glyph. Chrome
                                 deliberately reuses the minimize chevron's TabStrip tokens, so
                                 it themes correctly across every generation for free. -->
                            <!-- Right margin matches the minimize chevron's: the two are mutually
                                 exclusive (the chevron hides in modal mode), so without it the
                                 close button would sit flush against the window edge. -->
                            <Button x:Name="PART_ModalClose"
                                    Height="22"
                                    Margin="0,6,8,0"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{localization:RibbonString Key=Close}"
                                    Content="{Binding ModalTab.CloseButtonText, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                    Command="{Binding ExitModalCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                    Visibility="{Binding CanCloseModal, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}, Converter={StaticResource RibbonKit.BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.TabStrip.Foreground}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="Chrome"
                                                            Background="Transparent"
                                                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                                            SnapsToDevicePixels="True">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="{TemplateBinding Padding}">
                                                            <Path x:Name="Glyph"
                                                                  Data="M0,0 L8,8 M8,0 L0,8"
                                                                  Stroke="{TemplateBinding Foreground}"
                                                                  StrokeThickness="1.4"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  VerticalAlignment="Center" />
                                                            <ContentPresenter x:Name="Label"
                                                                              Margin="6,0,0,0"
                                                                              VerticalAlignment="Center"
                                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.TabStrip.ControlHoverBackground}" />
                                                        </Trigger>
                                                        <!-- Pressed comes AFTER hover on purpose: the
                                                             pointer is always over the button while it
                                                             is held, so the later trigger must be the
                                                             darker one or the press would never show. -->
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.TabStrip.ControlPressedBackground}" />
                                                        </Trigger>
                                                        <!-- No CloseButtonText: icon-only, so the
                                                             label must not reserve its margin. -->
                                                        <Trigger Property="Content" Value="{x:Null}">
                                                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Minimize chevron: toggles Ribbon.IsMinimized -->
                            <ToggleButton x:Name="MinimizeToggle"
                                          Width="24" Height="22"
                                          Margin="0,6,8,0"
                                          VerticalAlignment="Center"
                                          ToolTip="{localization:RibbonString Key=MinimizeRibbon}"
                                          IsChecked="{Binding IsMinimized, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="{x:Type ToggleButton}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                    <Border x:Name="Chrome"
                                                            Background="Transparent"
                                                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                                            SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <Path x:Name="ChevronUp"
                                                                  Data="M0,3.5 L3.5,0 L7,3.5"
                                                                  Stroke="{DynamicResource RibbonKit.Brushes.TabStrip.Foreground}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                            <Path x:Name="ChevronDown"
                                                                  Data="M0,0 L3.5,3.5 L7,0"
                                                                  Stroke="{DynamicResource RibbonKit.Brushes.TabStrip.Foreground}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Visibility="Collapsed" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.TabStrip.ControlHoverBackground}" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="ChevronUp" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="ChevronDown" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <!-- LAST so it outranks hover: the pointer is
                                                             always over the button while it is held. -->
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.TabStrip.ControlPressedBackground}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <!-- Triggers come AFTER every setter: a Style.Triggers
                                             block sitting between setters is a MC3088 build error. -->
                                        <Style.Triggers>
                                            <!-- Minimizing is blocked while a modal tab owns the
                                                 ribbon, so the chevron goes away with it. -->
                                            <DataTrigger Binding="{Binding IsModal, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <!-- Merged-caption window buttons (classic MDI's maximized child).
                                 Visible only while a caption is docked; the ribbon reports the
                                 press and the host decides what it means. Placed AFTER the
                                 minimize chevron so they sit at the very end of the row, where
                                 window buttons belong. -->
                            <Button x:Name="PART_MergedCaptionMinimize"
                                    Style="{StaticResource RibbonKit.MergedCaptionButton}"
                                    ToolTip="{localization:RibbonString Key=MinimizeWindow}"
                                    CommandParameter="{x:Static controls:RibbonMergedCaptionAction.Minimize}"
                                    Visibility="{Binding HasMergedCaption, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}, Converter={StaticResource RibbonKit.BoolToVis}}">
                                <Rectangle Width="9" Height="1"
                                           Fill="{DynamicResource RibbonKit.Brushes.TabStrip.Foreground}" />
                            </Button>
                            <Button x:Name="PART_MergedCaptionRestore"
                                    Style="{StaticResource RibbonKit.MergedCaptionButton}"
                                    ToolTip="{localization:RibbonString Key=RestoreWindow}"
                                    CommandParameter="{x:Static controls:RibbonMergedCaptionAction.Restore}"
                                    Visibility="{Binding HasMergedCaption, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}, Converter={StaticResource RibbonKit.BoolToVis}}">
                                <!-- Two offset outlines: the classic "restore down" glyph. -->
                                <Grid Width="10" Height="10">
                                    <Rectangle Width="7" Height="7"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Stroke="{DynamicResource RibbonKit.Brushes.TabStrip.Foreground}"
                                               StrokeThickness="1" />
                                    <Rectangle Width="7" Height="7"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                               Fill="{DynamicResource RibbonKit.Brushes.Ribbon.Background}"
                                               Stroke="{DynamicResource RibbonKit.Brushes.TabStrip.Foreground}"
                                               StrokeThickness="1" />
                                </Grid>
                            </Button>
                            <Button x:Name="PART_MergedCaptionClose"
                                    Style="{StaticResource RibbonKit.MergedCaptionButton}"
                                    Margin="0,6,8,0"
                                    ToolTip="{localization:RibbonString Key=CloseWindow}"
                                    CommandParameter="{x:Static controls:RibbonMergedCaptionAction.Close}"
                                    Visibility="{Binding MergedCaptionCanClose, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}, Converter={StaticResource RibbonKit.BoolToVis}}">
                                <Path Data="M0,0 L8,8 M8,0 L0,8"
                                      Stroke="{DynamicResource RibbonKit.Brushes.TabStrip.Foreground}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Ribbon body. Office 2024/365 renders it as a floating rounded
                             "card" (inset margin, rounded on all corners, bordered all
                             around) over the light ribbon band. Flat themes (2019/2013)
                             zero the margin and radius and use a top/bottom-only border,
                             collapsing it back to a full-width strip — all via tokens. -->
                        <Border x:Name="ContentHost"
                                Grid.Row="1"
                                Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                                BorderThickness="{DynamicResource RibbonKit.Metrics.ContentBorderThickness}"
                                CornerRadius="{DynamicResource RibbonKit.Metrics.ContentCornerRadius}"
                                Margin="{DynamicResource RibbonKit.Metrics.ContentMargin}"
                                Effect="{DynamicResource RibbonKit.Effects.ContentShadow}"
                                SnapsToDevicePixels="True">
                            <!-- Groups row in a horizontal scroller. ConstrainChildWidth lets the
                                 adaptive panel reduce groups to fit FIRST; only when even the fully
                                 reduced row overflows do the chevrons appear and scroll it (Office). -->
                            <Grid>
                                <layout:RibbonScrollContentHost x:Name="PART_ContentScroll"
                                                                ConstrainChildWidth="True"
                                                                Margin="{DynamicResource RibbonKit.Metrics.GroupsRowMargin}">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </layout:RibbonScrollContentHost>
                                <RepeatButton Style="{StaticResource RibbonKit.ScrollLeftButton}"
                                              HorizontalAlignment="Left"
                                              Command="{Binding ScrollLeftCommand, ElementName=PART_ContentScroll}"
                                              Visibility="{Binding CanScrollLeft, ElementName=PART_ContentScroll, Converter={StaticResource RibbonKit.BoolToVis}}" />
                                <RepeatButton Style="{StaticResource RibbonKit.ScrollRightButton}"
                                              HorizontalAlignment="Right"
                                              Command="{Binding ScrollRightCommand, ElementName=PART_ContentScroll}"
                                              Visibility="{Binding CanScrollRight, ElementName=PART_ContentScroll, Converter={StaticResource RibbonKit.BoolToVis}}" />
                            </Grid>
                        </Border>
                        <!-- MINIMIZED divider. With the body collapsed its outline goes with it,
                             and in the bordered generations (2007/2010/2013) the tab strip then
                             butts straight into the app's content with no boundary at all. This
                             hairline stands in for the outline's top edge, in the same
                             Ribbon.Border colour, so a minimized ribbon still terminates.

                             Height is a per-theme token rather than a trigger: 2019 (tinted band)
                             and 2024 (floating card) set it to 0, which also costs them no layout
                             height, exactly as ContextualUnderlineHeight is zeroed to switch off
                             the contextual underline. Full width by design, including 2007, whose
                             body is inset 2px a side — a rule that stops short of the window edge
                             reads as a mistake rather than a boundary.

                             Never visible at the same time as PART_ConnectNotch below (that one
                             mirrors ContentHost), so their declaration order does not matter. -->
                        <Border x:Name="MinimizedDivider"
                                Grid.Row="1"
                                Height="{DynamicResource RibbonKit.Metrics.MinimizedDividerHeight}"
                                VerticalAlignment="Top"
                                Background="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                        <!-- Body-border NOTCH: a 1px body-coloured sliver lying OVER the body's
                             top border, directly under the selected tab, cutting a tab-wide gap
                             into the border so the active tab opens seamlessly into the body
                             (the Office 2010/2013 connected-tab look). It must live HERE in the
                             body row: nothing inside the tab strip can paint over the body's
                             border because PART_TabScroll clips its subtree (ClipToBounds), and
                             ZIndex can't reorder across the strip/body branch boundary — ZIndex
                             only orders SIBLINGS of the same panel. As a sibling of ContentHost,
                             declared after it, the notch paints above the border by plain
                             declaration order. RibbonTabControl.UpdateConnectNotch drives
                             Width + PART_ConnectNotchTranslate.X to track the selected tab
                             (clamped to the strip's viewport when the strip scrolls). The 1px
                             side borders continue the selected tab's outline down through the
                             cut, closing the corners (SelectedBorderBrush — Transparent in
                             non-connecting themes). Themes without a connected tab (2019/2024)
                             set Tab.ConnectNotch Transparent and the code keeps Width at 0.
                             Visibility mirrors ContentHost so the notch vanishes with the body
                             when the ribbon is minimized. Render-only: hit-transparent, fixed
                             1px height, top-aligned — it never affects layout. -->
                        <Border x:Name="PART_ConnectNotch"
                                Grid.Row="1"
                                Width="0"
                                Height="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{DynamicResource RibbonKit.Brushes.Tab.ConnectNotch}"
                                BorderBrush="{DynamicResource RibbonKit.Brushes.Tab.SelectedBorderBrush}"
                                BorderThickness="1,0,1,0"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding Visibility, ElementName=ContentHost}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PART_ConnectNotchTranslate" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- The ribbon body's Visibility while minimized is managed in code
                             (Ribbon.OnIsMinimizedChanged) so it can slide up + fade out before
                             collapsing, and slide back in on restore. The divider keys off
                             IsMinimized rather than the body's Visibility, so it is already in
                             place under the body as that slides up and away — appearing only
                             after the collapse would pop a line in a frame late. -->
                        <DataTrigger Binding="{Binding IsMinimized, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                     Value="True">
                            <Setter TargetName="MinimizedDivider" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding QuickAccessPosition, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                     Value="TabRow">
                            <Setter TargetName="QatTabRowHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="QatTabRowHost" Property="ItemsSource">
                                <Setter.Value>
                                    <Binding Path="QuickAccessItems"
                                             RelativeSource="{RelativeSource AncestorType={x:Type controls:Ribbon}}" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!-- When the QAT sits below the ribbon, the card squares its bottom
                             corners and drops its bottom margin so the full-width QAT bar
                             connects flush underneath. -->
                        <DataTrigger Binding="{Binding QuickAccessPosition, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                     Value="BelowRibbon">
                            <Setter TargetName="ContentHost" Property="CornerRadius"
                                    Value="{DynamicResource RibbonKit.Metrics.ContentCornerRadiusTop}" />
                            <Setter TargetName="ContentHost" Property="Margin"
                                    Value="{DynamicResource RibbonKit.Metrics.ContentMarginQatBelow}" />
                        </DataTrigger>
                        <!-- The message row is another continuation surface, just like a
                             below-ribbon QAT. Square the body foot and consume its lower gap, but
                             keep the ribbon shadow as a deliberate depth boundary above the
                             independently shadowed message stack. -->
                        <DataTrigger Binding="{Binding HasOpenMessages, RelativeSource={RelativeSource AncestorType={x:Type controls:Ribbon}}}"
                                     Value="True">
                            <Setter TargetName="ContentHost" Property="CornerRadius"
                                    Value="{DynamicResource RibbonKit.Metrics.ContentCornerRadiusTop}" />
                            <Setter TargetName="ContentHost" Property="Margin"
                                    Value="{DynamicResource RibbonKit.Metrics.ContentMarginQatBelow}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
