<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Office 2010 Black is a hybrid palette: dark window/tab chrome around a
         silver-gray ribbon with dark command text. The base theme still supplies
         its smooth amber interaction gels and every geometry/metric token. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Window.Background" Color="#B8B8B8" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Ribbon.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#686868" />
        <GradientStop Offset="1" Color="#585858" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Ribbon.ContentBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D5D7D8" />
        <GradientStop Offset="1" Color="#B5B8BA" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.SurfaceBackground" Color="#F4F4F4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.Border" Color="#565656" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Primary" Color="#202020" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Secondary" Color="#474747" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Input.Glyph" Color="#FFFFFF" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.Foreground" Color="#F2F2F2" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TabStrip.ControlHoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#919191" />
        <GradientStop Offset="1" Color="#777777" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TabStrip.ControlPressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#565656" />
        <GradientStop Offset="1" Color="#737373" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TabStrip.ScrollButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#686868" />
        <GradientStop Offset="1" Color="#585858" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Tab.HoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#929292" />
        <GradientStop Offset="1" Color="#797979" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Tab.SelectedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F2F2F2" />
        <GradientStop Offset="1" Color="#D5D7D8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedForeground" Color="#202020" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedBorderBrush" Color="#565656" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectFootHover" Color="#929292" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectFootSelected" Color="#D5D7D8" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectNotch" Color="#D5D7D8" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Separator" Color="#858585" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Background" Color="#F5F5F5" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Border" Color="#686868" />

    <LinearGradientBrush x:Key="RibbonKit.Brushes.CaptionButton.HoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#8D8D8D" />
        <GradientStop Offset="1" Color="#696969" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.CaptionButton.PressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4D4D4D" />
        <GradientStop Offset="1" Color="#696969" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#777777" />
        <GradientStop Offset="1" Color="#686868" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.TitleBar.Foreground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Background" Color="#F5F5F5" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Border" Color="#686868" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Foreground" Color="#202020" />

    <LinearGradientBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#8B8B8B" />
        <GradientStop Offset="1" Color="#646464" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionForeground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveBorder" Color="#5E5E5E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiClient.Background" Color="#3A3A3A" />

    <!-- Classic2010 Backstage stays light, but the optional two-pane application menu is a
         complete dark flyout. It uses scoped text tokens so the silver ribbon remains hybrid. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemHoverBackground" Color="#737373" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedBackground" Color="#565656" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Backstage.Classic.NavBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#686868" />
        <GradientStop Offset="1" Color="#585858" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedBorder" Color="#4A4A4A" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Backstage.NavBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E2E2E2" />
        <GradientStop Offset="1" Color="#C6C6C6" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedGlass"
                         Center="0.43,0.78" GradientOrigin="0.43,0.78"
                         RadiusX="0.78" RadiusY="1.05">
        <GradientStop Offset="0" Color="#888888" />
        <GradientStop Offset="0.45" Color="#707070" />
        <GradientStop Offset="0.78" Color="#555555" />
        <GradientStop Offset="1" Color="#444444" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Classic2007.Foreground" Color="#202020" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Backstage.Classic2007.ShellGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F6F6F6" />
        <GradientStop Offset="0.12" Color="#E6E6E6" />
        <GradientStop Offset="0.45" Color="#CFCFCF" />
        <GradientStop Offset="0.45" Color="#C3C3C3" />
        <GradientStop Offset="0.82" Color="#D0D0D0" />
        <GradientStop Offset="1" Color="#A8A8A8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ContentBackground" Color="#F0F0F0" />
    <DropShadowEffect x:Key="RibbonKit.Effects.Backstage.ContentShadow"
                      BlurRadius="9" ShadowDepth="3" Direction="180"
                      Opacity="0.24" Color="#000000" RenderingBias="Performance" />
    <DropShadowEffect x:Key="RibbonKit.Effects.Backstage.ContentLeftShadow"
                      BlurRadius="9" ShadowDepth="3" Direction="180"
                      Opacity="0.32" Color="#000000" RenderingBias="Performance" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.Foreground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.SecondaryForeground" Color="#D0D0D0" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.HeadingForeground" Color="#8CC8FF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameBorder" Color="#484848" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameRim" Color="#777777" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameBand" Color="#595959" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationMenu.TopBandBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#777777" />
        <GradientStop Offset="1" Color="#5B5B5B" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FooterBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#686868" />
        <GradientStop Offset="1" Color="#4F4F4F" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.NavBackground" Color="#303030" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneBackground" Color="#3B3B3B" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneSurface" Color="#303030" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneBorder" Color="#666666" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.HeaderBackground" Color="#464646" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.Separator" Color="#565656" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.SeparatorHighlight" Color="#3B3B3B" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationMenu.ButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#686868" />
        <GradientStop Offset="1" Color="#4C4C4C" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.ButtonBorder" Color="#747474" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.MenuOpenBottom" Color="#3277B4" />
    <RadialGradientBrush x:Key="RibbonKit.Brushes.ApplicationButton.InnerGlow"
                         Center="0.5,1.12"
                         GradientOrigin="0.5,1.12"
                         RadiusX="0.78"
                         RadiusY="1.12">
        <GradientStop Offset="0" Color="#58FFFFFF" />
        <GradientStop Offset="0.55" Color="#2CFFFFFF" />
        <GradientStop Offset="1" Color="#14FFFFFF" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.MessageBar.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF2C5" />
        <GradientStop Offset="0.38" Color="#F3DFA0" />
        <GradientStop Offset="0.72" Color="#E5C979" />
        <GradientStop Offset="1" Color="#EED996" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.Border" Color="#B89535" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.Foreground" Color="#202020" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.IconForeground" Color="#245A8D" />
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderMarginMessageBar">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.QatExtenderCornerRadiusMessageBar">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.MessageBar.Margin">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.MessageBar.LastCornerRadius">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.MessageBar.BorderThickness">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MessageBar.CloseHoverBorder" Color="#8E6D2A" />
</ResourceDictionary>
