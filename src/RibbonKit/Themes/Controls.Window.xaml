<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls"
    xmlns:localization="clr-namespace:RibbonKit.Localization"
    xmlns:layout="clr-namespace:RibbonKit.Layout">

    <!-- Part of the shared RibbonKit control-template dictionary; merged by Office2024.xaml.
         RibbonWindow chrome.
         Colours/metrics come from Tokens.Office20XX.xaml via {DynamicResource}. -->

    <!-- ============================================================
         RibbonWindow — Office-style chrome: custom title bar with
         TitleBarContent slot + themed caption buttons, native
         drag/resize/maximize via WindowChrome
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonWindow}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.Window.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <!-- No GlassFrameThickness="-1": extending the DWM glass across the whole
                     window breaks WindowChrome's maximize/work-area handling (the window
                     then overhangs the screen when maximized). Default glass + the
                     WM_GETMINMAXINFO hook in RibbonWindow keep maximize correct. -->
                <WindowChrome CaptionHeight="{DynamicResource RibbonKit.Metrics.WindowFrame.CaptionHeight}"
                              GlassFrameThickness="-1"
                              ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonWindow}">
                    <!-- Keep the physical frame LTR. Applying RTL to the direct Window template
                         root makes WPF arrange maximize compensation against the bottom/left
                         edges, losing the top/right inset. Logical content is mirrored one layer
                         farther in so caption buttons, title content and the ribbon still follow
                         the window's FlowDirection. -->
                    <Grid x:Name="PhysicalWindowFrameHost"
                          FlowDirection="LeftToRight"
                          SnapsToDevicePixels="True">
                    <!-- Keep PART_WindowRoot flush with the physical host. The restored non-Aero
                         Word reference carries no app-painted band around the complete window:
                         its title and status bars run directly to the native one-pixel edge. The
                         wider blue beside the ribbon/document is client-area padding, not chrome.
                         AeroFrameHost stays at zero thickness for that default; the explicit
                         Office2007Aero appearance alone gives it a restored material frame. -->
                    <Border x:Name="AeroFrameHost"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroFallback}"
                            BorderThickness="0"
                            FlowDirection="LeftToRight">
                    <Border x:Name="PART_WindowRoot"
                            Background="{TemplateBinding Background}"
                            FlowDirection="LeftToRight">
                        <!-- Window-wide layer for overlays anchored outside the content row. In
                             particular, title-bar QAT KeyTips can extend into the tab strip and
                             must paint above it. Keeping the title visuals inside the decorated
                             child preserves the Office 2007 orb's intentional upward overlap. -->
                        <AdornerDecorator x:Name="WindowAdornerHost"
                                          FlowDirection="{TemplateBinding FlowDirection}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Title bar (its own band token, separate from the tab strip:
                                 Office 2019/2013 use a colored title bar over a light strip) -->
                            <Grid x:Name="TitleBarBand"
                                  Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Keep the opaque title fill separate from title content so the
                                     accepted Acrylic state can fade only the background away. -->
                                <Border x:Name="TitleBarBackgroundLayer"
                                        Grid.ColumnSpan="3"
                                        Background="{DynamicResource RibbonKit.Brushes.TitleBar.Background}" />

                                <!-- Deterministic Office 2007-authored tint, reflection and grain.
                                     These remain useful over the opaque fallback and, when Acrylic
                                     is active, tint the material without covering it. -->
                                <Grid x:Name="AeroTitleVisual"
                                      Grid.ColumnSpan="3"
                                      IsHitTestVisible="False"
                                      Visibility="Collapsed">
                                    <Border Background="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroTint}" />
                                    <Border Background="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroReflection}"
                                            Opacity="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroReflectionOpacity}" />
                                    <Border Background="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroGrain}"
                                            Opacity="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroGrainOpacity}" />
                                    <Border BorderBrush="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroInnerHighlight}"
                                            BorderThickness="0,0,0,1" />
                                </Grid>

                                <!-- Window identity plus quick-access slot. The icon remains in
                                     the caption when Backstage hides only TitleBarContent. -->
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">
                                    <Image x:Name="PART_WindowIcon"
                                           Width="16"
                                           Height="16"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           Source="{TemplateBinding Icon}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <ContentPresenter x:Name="TitleBarContentHost"
                                                      Content="{TemplateBinding TitleBarContent}"
                                                      VerticalAlignment="Center"
                                                      Margin="6,0,6,0"
                                                      WindowChrome.IsHitTestVisibleInChrome="True" />
                                </StackPanel>

                                <!-- Named part: the title sits in the star column between the
                                     quick-access slot and the caption buttons, so collapsing that
                                     slot moves its centre by half the slot's width. RibbonWindow
                                     measures the position either side of the change and glides
                                     the difference away instead of letting it teleport. -->
                                <TextBlock x:Name="PART_Title"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Title}"
                                           FontSize="12"
                                           Foreground="{DynamicResource RibbonKit.Brushes.TitleBar.Foreground}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0" />

                                <!-- Caption buttons -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                    <StackPanel.Resources>
                                        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
                                            <Setter Property="Width" Value="46" />
                                            <Setter Property="Height" Value="34" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource RibbonKit.Brushes.TitleBar.Foreground}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background"
                                                                        Value="{DynamicResource RibbonKit.Brushes.CaptionButton.HoverBackground}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background"
                                                                        Value="{DynamicResource RibbonKit.Brushes.CaptionButton.PressedBackground}" />
                                                            </Trigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding FrameAppearance, RelativeSource={RelativeSource AncestorType={x:Type controls:RibbonWindow}}}"
                                                                               Value="Office2007Aero" />
                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                                                               Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="Chrome"
                                                                        Property="Background"
                                                                        Value="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroCaptionHover}" />
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding FrameAppearance, RelativeSource={RelativeSource AncestorType={x:Type controls:RibbonWindow}}}"
                                                                               Value="Office2007Aero" />
                                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}"
                                                                               Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="Chrome"
                                                                        Property="Background"
                                                                        Value="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroCaptionPressed}" />
                                                            </MultiDataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}">
                                            <Setter Property="Width" Value="46" />
                                            <Setter Property="Height" Value="34" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource RibbonKit.Brushes.TitleBar.Foreground}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <Border x:Name="Chrome" Background="Transparent">
                                                            <Path x:Name="Glyph"
                                                                  Data="M0,0 L9,9 M9,0 L0,9"
                                                                  Stroke="{TemplateBinding Foreground}"
                                                                  StrokeThickness="1"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background"
                                                                        Value="{DynamicResource RibbonKit.Brushes.CaptionButton.CloseHoverBackground}" />
                                                                <Setter TargetName="Glyph" Property="Stroke" Value="#FFFFFF" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background"
                                                                        Value="{DynamicResource RibbonKit.Brushes.CaptionButton.ClosePressedBackground}" />
                                                                <Setter TargetName="Glyph" Property="Stroke" Value="#FFFFFF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button x:Name="PART_MinimizeButton"
                                            Style="{StaticResource CaptionButtonStyle}"
                                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                            ToolTip="{localization:RibbonString Key=Minimize}">
                                        <Path Data="M0,0 H10"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              StrokeThickness="1" />
                                    </Button>
                                    <Button x:Name="PART_MaximizeButton"
                                            Style="{StaticResource CaptionButtonStyle}"
                                            Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                            ToolTip="{localization:RibbonString Key=Maximize}">
                                        <Path Data="M0,0 H9 V9 H0 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              StrokeThickness="1" />
                                    </Button>
                                    <Button x:Name="PART_RestoreButton"
                                            Style="{StaticResource CaptionButtonStyle}"
                                            Command="{x:Static SystemCommands.RestoreWindowCommand}"
                                            ToolTip="{localization:RibbonString Key=RestoreDown}"
                                            Visibility="Collapsed">
                                        <Path Data="M0,2 H7 V9 H0 Z M2,2 V0 H9 V7 H7"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              StrokeThickness="1" />
                                    </Button>
                                    <Button x:Name="PART_CloseButton"
                                            Style="{StaticResource CloseCaptionButtonStyle}"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                                            ToolTip="{localization:RibbonString Key=Close}" />
                                </StackPanel>
                            </Grid>

                            <!-- Window content. The AdornerDecorator is REQUIRED: without
                                 it adorner-hosted overlays (the backstage) cannot render. -->
                            <AdornerDecorator x:Name="ContentAdornerHost" Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                        </AdornerDecorator>
                    </Border>
                    </Border>

                    <!-- Frame-only overlays are drawn after the content but never receive input.
                         Their BorderThickness follows the same physical-LTR frame inset. -->
                    <Grid x:Name="AeroFrameOverlay"
                          FlowDirection="LeftToRight"
                          IsHitTestVisible="False"
                          Visibility="Collapsed">
                        <Border x:Name="AeroFrameTint"
                                BorderBrush="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroTint}"
                                BorderThickness="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroThickness}">
                            <!-- The frame and title are one glass surface. Begin the vertical
                                 inner bevel below the title instead of drawing two bright seams
                                 beside the orb and Close button. -->
                            <Border x:Name="AeroFrameInnerHighlight"
                                    Margin="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroInnerHighlightMargin}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroInnerHighlight}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroInnerHighlightThickness}" />
                        </Border>
                        <Border BorderBrush="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroReflection}"
                                BorderThickness="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroThickness}"
                                Opacity="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroReflectionOpacity}" />
                        <Border BorderBrush="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroGrain}"
                                BorderThickness="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroThickness}"
                                Opacity="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroGrainOpacity}" />
                    </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="FrameAppearance" Value="Office2007Aero">
                            <Setter TargetName="AeroFrameHost"
                                    Property="BorderThickness"
                                    Value="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroThickness}" />
                            <Setter TargetName="AeroFrameOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="AeroTitleVisual" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Title"
                                    Property="Foreground"
                                    Value="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroTitleForeground}" />
                            <Setter TargetName="PART_MinimizeButton"
                                    Property="Foreground"
                                    Value="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroTitleForeground}" />
                            <Setter TargetName="PART_MaximizeButton"
                                    Property="Foreground"
                                    Value="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroTitleForeground}" />
                            <Setter TargetName="PART_RestoreButton"
                                    Property="Foreground"
                                    Value="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroTitleForeground}" />
                            <Setter TargetName="PART_CloseButton"
                                    Property="Foreground"
                                    Value="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroTitleForeground}" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="AeroFrameHost"
                                    Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.WindowFrame.AeroInactiveFallback}" />
                            <Setter TargetName="AeroFrameOverlay"
                                    Property="Opacity"
                                    Value="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroInactiveOverlayOpacity}" />
                            <Setter TargetName="TitleBarBand"
                                    Property="Opacity"
                                    Value="{DynamicResource RibbonKit.Metrics.WindowFrame.InactiveTitleBarOpacity}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="FrameAppearance" Value="Office2007Aero" />
                                <Condition Property="ActiveBackdrop" Value="Acrylic" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="AeroFrameHost" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="TitleBarBackgroundLayer"
                                    Property="Opacity"
                                    Value="{DynamicResource RibbonKit.Metrics.WindowFrame.AeroMaterialTitleBackgroundOpacity}" />
                        </MultiTrigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <!-- The maximize overhang (a WindowChrome window is placed to
                                 hang past every screen edge) is compensated in code:
                                 RibbonWindow measures how far the window spills past the
                                 monitor work area and insets PART_WindowRoot by exactly
                                 that, so the caption buttons stay on-screen and the ribbon
                                 card keeps its side margin. Here we only swap the caption
                                 glyph from Maximize to Restore. -->
                            <Setter TargetName="AeroFrameHost" Property="BorderThickness" Value="0" />
                            <Setter TargetName="AeroFrameOverlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RestoreButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsTitleBarContentVisible" Value="False">
                            <Setter TargetName="TitleBarContentHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="PART_WindowIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleBarContentHost" Property="Margin" Value="10,0,6,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
