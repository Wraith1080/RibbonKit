<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls"
    xmlns:layout="clr-namespace:RibbonKit.Layout">

    <!-- ============================================================
         SHARED CONTROL TEMPLATES for every Office generation.

         Despite the name this file is NOT a theme: colours and metrics come from the
         token layer via {DynamicResource}, so a theme (Themes/Tokens.Office20XX.xaml)
         merged in App.xaml re-colours every control at runtime without duplicating a
         single template.

         Split into Controls.*.xaml parts on 2026-07-27 purely for editability; the
         merged result is byte-identical to the previous monolith. ORDER MATTERS:
         Controls.Shared.xaml must stay FIRST — it defines RibbonKit.BoolToVis, the two
         scroll buttons and RibbonKit.MergedCaptionButton, which later parts reference
         by StaticResource. Within a part, a StaticResource must still be defined above
         its first use, so keep BasedOn chains inside a single part.
         ============================================================ -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Shared.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.RibbonChrome.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.MessageBar.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Groups.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Buttons.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.DropDowns.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Backstage.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.ApplicationMenu.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Galleries.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Window.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.OptionsDialog.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Customize.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
