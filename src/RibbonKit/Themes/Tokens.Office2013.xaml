<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         Office 2013 ("White") token palette. Same keys as the other
         themes. Defining traits: very flat and white, a colored (blue)
         title bar over a WHITE tab strip (unlike 2019's blue strip),
         a SOLID accent File button, and blue-tinted hovers.
         ============================================================ -->
    <!-- Tab strip is white in the 2013 White theme (title bar is the only colored band). -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.ContentBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.SurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Window.Background" Color="#FFFFFF" />
    <!-- Prominent medium-gray outline around the ribbon body and the active tab. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.Border" Color="#919191" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Primary" Color="#444444" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Text.Secondary" Color="#777777" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Accent" Color="#2B579A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.HoverBackground" Color="#E8EEF7" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.PressedBackground" Color="#D0E0F5" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CheckedBackground" Color="#D4E4F7" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CheckedHoverBackground" Color="#C4D8F0" />
    <!-- Split button "companion" state: hovering or pressing ONE half also marks the OTHER, so
         the two read as a single control rather than as two buttons that happen to touch.
         A flat theme has no highlight border, so it shows a LIGHTER version of its hover fill
         and leaves the companion border Transparent; the gradient themes (2007/2010) draw the
         amber outline plus a pale wash inside it. One pair of tokens, one pair of setters in
         Controls.DropDowns.xaml, every generation. See 04-DESIGN-NOTES §3.43. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionBackground" Color="#F4F7FC" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionBorder" Color="Transparent" />
    <!-- No border to glow just inside of, so nothing to draw. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionGlow" Color="Transparent" />

    <!-- No highlight border (Office 2010 uses a gold one; other themes don't). -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.HoverBorder" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.PressedBorder" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CheckedBorder" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.InnerGlow" Color="Transparent" />
    <Thickness x:Key="RibbonKit.Metrics.ControlHighlightBorderThickness">0</Thickness>
    <!-- Flat theme: fills, not underlines. Tabs on the white strip: dark text, light-blue
         hover box, white connected active tab with an accent (blue) label. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ContextualBackground" Color="#E8EEF7" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ContextualHoverBackground" Color="#D4E4F7" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.Foreground" Color="#444444" />
    <!-- Hover fill for chrome buttons on the tab strip (File button, minimize toggle). -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.ControlHoverBackground" Color="#E5E5E5" />
    <!-- Held (mouse-down) fill for those same buttons, one step darker than the hover. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.ControlPressedBackground" Color="#D6D6D6" />
    <!-- Fill of the tab-strip scroll chevrons. Its own token rather than Ribbon.Background so it
         survives the two things that broke it there: 2024 makes that Transparent for Mica, and an
         accented 2019 strip repaints it with the accent. Matching Tab.SelectedBackground makes the
         chevron read as a tab sitting on the strip, which is what it is. Same value this theme
         already used, so nothing changes here. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.TabStrip.ScrollButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.HoverBackground" Color="#E8EEF7" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.HoverUnderline" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedUnderline" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedForeground" Color="#2B579A" />
    <!-- Metro trait: the active tab is outlined (top + sides) and cuts into the ribbon body. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.SelectedBorderBrush" Color="#919191" />
    <Thickness x:Key="RibbonKit.Metrics.TabSelectedBorderThickness">1,1,1,0</Thickness>
    <!-- Retained for token parity; the connect is now driven render-only by TabConnect (below),
         not by a layout margin (a negative margin re-measured the strip and jittered on hover). -->
    <Thickness x:Key="RibbonKit.Metrics.TabSelectedMargin">0</Thickness>
    <!-- Render-only connect: the 1px ConnectFoot at the tab bottom is shifted 1px into the body
         (tab-strip ZIndex covers the body's top border) so the tab merges WITHOUT moving the tab,
         keeping its top edge/label aligned with the File button. RenderTransform = no re-measure. -->
    <TranslateTransform x:Key="RibbonKit.Transforms.TabConnect" Y="1" />
    <!-- ConnectFoot colours = the tab's bottom fill colour so the 1px sliver continues over the
         body border. Hover = the flat hover fill; selected = the white body/tab colour. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectFootHover" Color="#E8EEF7" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectFootSelected" Color="#FFFFFF" />
    <!-- Body-border notch (PART_ConnectNotch, in the tab control's BODY row): the ConnectFoot
         is clipped at the strip's bottom edge by PART_TabScroll, so cutting the body's #919191
         top border under the active tab is done body-side by this notch — white, matching the
         body and the selected tab, so the outlined tab opens straight into the body (Metro). -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectNotch" Color="#FFFFFF" />
    <!-- Contextual tabs: this flat theme only tints the header text (no underline, no
         mute) — selection stays the outlined active tab. -->
    <system:Double x:Key="RibbonKit.Metrics.ContextualUnderlineHeight">0</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ContextualUnselectedOpacity">1</system:Double>
    <!-- The File button hits the window's left edge, flush and full-height. -->
    <Thickness x:Key="RibbonKit.Metrics.ApplicationButtonMargin">0</Thickness>
    <!-- Wide solid accent block — the prominent 2013 File button. -->
    <Thickness x:Key="RibbonKit.Metrics.ApplicationButtonPadding">24,7,24,9</Thickness>
    <!-- Tabs sit flush to the top (no top inset) so they line up with the full-height
         File button and meet the title bar's lower edge — the colored title bar then
         connects straight into the tab row. -->
    <Thickness x:Key="RibbonKit.Metrics.TabStripMargin">2,0,4,0</Thickness>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Separator" Color="#D4D4D4" />
    <!-- 1 = the separator is drawn, as it always has been in this theme. -->
    <system:Double x:Key="RibbonKit.Metrics.GroupSeparatorOpacity">1</system:Double>

    <!-- Group box (Office 2007 only). This generation draws each group as a bordered, rounded box
         with a light inner rim and a shaded label band; every later generation uses a bare surface
         with a 1px separator between groups. The shared template carries both, so the flat themes
         zero these keys and the box collapses to nothing. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Background" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Border" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.InnerHighlight" Color="Transparent" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.LabelBackground" Color="Transparent" />
    <Thickness x:Key="RibbonKit.Metrics.GroupBorderThickness">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.GroupCornerRadius">0</CornerRadius>
        <!-- Group outer gap / inner content inset. These reproduce the historic hard-coded
         Margin="4,2,4,0" exactly, so this theme is unchanged. -->
    <!-- Groups-row inset / collapsed-group button margin. These reproduce the previous
         hard-coded values (Margin="6,2" on the content scroller, Margin="1" on the collapsed
         button) exactly, so this theme is unchanged. -->
    <Thickness x:Key="RibbonKit.Metrics.GroupsRowMargin">6,2</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.GroupCollapsedMargin">1</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.GroupMargin">4,2,4,0</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.GroupPadding">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.GroupLabelCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Border" Color="#D4D4D4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemHoverBackground" Color="#3D66A8" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedBackground" Color="#1F3F72" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.NavBackground" Color="#FFFFFF" />
    <system:Double x:Key="RibbonKit.Metrics.BackstageBackButtonSize">36</system:Double>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.ContentBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.NavBackground" Color="#F5F4F3" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.Foreground" Color="#201F1E" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemHover" Color="#EDEBE9" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemSelected" Color="#E1DFDD" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemHoverTranslucent" Color="#12000000" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemSelectedTranslucent" Color="#1F000000" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.NavBackgroundTranslucent" Color="#00F5F4F3" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.OptionsDialog.RailBackground" Color="#F5F4F3" />
    <!-- Classic2010 selected-item glass marker + dialog primary (OK) button fill (flat accent). -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Backstage.ItemSelectedGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#4E7CC0" />
        <GradientStop Offset="0.5" Color="#33619E" />
        <GradientStop Offset="1" Color="#234C86" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Dialog.PrimaryBackground" Color="#2B579A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Dialog.PrimaryBorder" Color="#2B579A" />
    <!-- Caption buttons sit on the WHITE title bar: light-gray hover, dark glyphs. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.HoverBackground" Color="#E5E5E5" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.PressedBackground" Color="#D6D6D6" />
    <!-- Safety-net defaults for the QAT-on-colored-band hover/pressed wash. The Ribbon
         overrides both keys per-button with the live caption/tab band brushes
         (Ribbon.UpdateQatButtonContext); these only surface if a trigger fires first. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Qat.ColoredHoverBackground" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Qat.ColoredPressedBackground" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.CloseHoverBackground" Color="#E81123" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.ClosePressedBackground" Color="#F1707A" />

    <!-- KeyTip badges: a white chip with a gray border and dark text, matching the flat
         Metro look. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Border" Color="#7A7A7A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Foreground" Color="#444444" />

    <!-- Office 2013 White: the title bar is NOT colored — it's white, matching the
         area behind the ribbon. Only the File button and accents carry the blue. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.TitleBar.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.TitleBar.Foreground" Color="#444444" />

    <!-- Office 2013: the File button IS a solid accent block with white text
         (a darker-accent fill on hover, no underline). -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.Background" Color="#2B579A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.HoverBackground" Color="#1F3F72" />
    <!-- Mouse-down (pressed) fill for the File button (deeper than the hover). -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.PressedBackground" Color="#16305A" />
    <!-- Application-menu open defaults to the historical checked File-tab treatment. Colored
         tab bands may override these independently without changing Backstage. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.MenuOpenBackground" Color="#2B579A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.MenuOpenForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.HoverUnderline" Color="Transparent" />
    <!-- No File-button border (Office 2010 uses one). -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.Border" Color="Transparent" />
    <!-- Orb tokens. This theme uses the rectangular File tab, so these only matter if an app opts
         into Ribbon.ApplicationButtonShape = Orb anyway. Kept at the 2007 geometry minus the
         overhang, so an orb here sits neatly inside the tab strip. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationOrb.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FBFCFD" />
        <GradientStop Offset="0.5" Color="#DDE4EC" />
        <GradientStop Offset="1" Color="#FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationOrb.HoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFEFC" />
        <GradientStop Offset="0.5" Color="#F7C93E" />
        <GradientStop Offset="1" Color="#FDFAB7" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ApplicationOrb.PressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F5D98A" />
        <GradientStop Offset="0.5" Color="#D8931A" />
        <GradientStop Offset="1" Color="#F7D06A" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationOrb.Ring" Color="#F0F4F9" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationOrb.HoverRing" Color="#FFEA37" />
    <DropShadowEffect x:Key="RibbonKit.Effects.ApplicationOrbShadow"
                      BlurRadius="5" ShadowDepth="1" Direction="270"
                      Opacity="0.5" Color="#2E4257" RenderingBias="Quality" />
    <!-- Left inset of the title-bar QAT; reproduces the previous hard-coded 2,0,6,0. -->
    <Thickness x:Key="RibbonKit.Metrics.TitleBarQatMargin">2,0,6,0</Thickness>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationOrbSize">46</system:Double>
    <Thickness x:Key="RibbonKit.Metrics.ApplicationOrbMargin">2,0,6,0</Thickness>

    <Thickness x:Key="RibbonKit.Metrics.ApplicationButtonBorderThickness">0</Thickness>

    <system:Double x:Key="RibbonKit.Metrics.GroupsRowHeight">104</system:Double>

    <!-- Fully flat: every corner radius is zero. -->
    <CornerRadius x:Key="RibbonKit.Metrics.ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SmallControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.PopupCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.TabCornerRadius">0</CornerRadius>
    <!-- Square: the 2013 File button is a flat accent block flush with the strip. -->
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationButtonCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitLeftCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitRightCornerRadius">0</CornerRadius>
    <!-- Vertical split button (Large only). Square, like everything else in 2013. -->
    <CornerRadius x:Key="RibbonKit.Metrics.SplitTopCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SplitBottomCornerRadius">0</CornerRadius>

    <!-- Prominent outline all around the ribbon body (Metro look). -->
    <Thickness x:Key="RibbonKit.Metrics.ContentBorderThickness">1</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.ContentMargin">0</Thickness>
    <!-- Minimized: stands in for the vanished body outline's top edge — see the 2007 token. -->
    <system:Double x:Key="RibbonKit.Metrics.MinimizedDividerHeight">1</system:Double>
    <CornerRadius x:Key="RibbonKit.Metrics.ContentCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ContentCornerRadiusTop">0</CornerRadius>
    <Thickness x:Key="RibbonKit.Metrics.ContentMarginQatBelow">0</Thickness>

    <!-- Flat theme: no ribbon shadow. -->
    <DropShadowEffect x:Key="RibbonKit.Effects.ContentShadow"
                      Opacity="0" BlurRadius="0" ShadowDepth="0" />

    <!-- Flat below-ribbon QAT: a plain full-width strip with a bottom border. -->
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderMargin">0</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderBorderThickness">0,0,0,1</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.QatExtenderCornerRadius">0</CornerRadius>

    <!-- Flat theme: the minimized QAT keeps the same full-width, bottom-bordered strip
         (no floating card), so these match the normal values above. -->
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderMarginMinimized">0</Thickness>
    <Thickness x:Key="RibbonKit.Metrics.QatExtenderBorderThicknessMinimized">0,0,0,1</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.QatExtenderCornerRadiusMinimized">0</CornerRadius>

    <!-- MDI child-window chrome. 2013: flat white generation, square corners. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.ActiveCaptionBackground" Color="#2B579A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.ActiveCaptionForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionForeground" Color="#666666" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.ActiveBorder" Color="#2B579A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveBorder" Color="#ABABAB" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiClient.Background" Color="#E6E6E6" />

    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.CaptionButtonHoverBackground" Color="#26000000" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.CaptionButtonPressedBackground" Color="#40000000" />
    <system:Double x:Key="RibbonKit.Metrics.MdiChild.CaptionHeight">30</system:Double>
    <CornerRadius x:Key="RibbonKit.Metrics.MdiChild.CornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.MdiChild.CaptionCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.MdiChild.CloseButtonCornerRadius">0</CornerRadius>

    <!-- ============================================================
         APPLICATION MENU (Office 2007's two-pane orb drop-down).
         A flat translation for a generation that never shipped this control — assigning
         Ribbon.ApplicationMenu under this theme is legal and gets a sane, on-palette menu rather
         than 2007's glass. The top band is nearly nothing here because there is no orb to tuck
         under it.
         ============================================================ -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameBorder" Color="#919191" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameRim" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FrameBand" Color="#F3F3F3" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.TopBandBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.FooterBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.NavBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.PaneBorder" Color="#D4D4D4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.HeaderBackground" Color="#EAEAEA" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.Separator" Color="#D4D4D4" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.SeparatorHighlight" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationMenu.ButtonBorder" Color="#ACACAC" />

    <DropShadowEffect x:Key="RibbonKit.Effects.ApplicationMenuShadow"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.22"
                      Color="#000000" />
    <DropShadowEffect x:Key="RibbonKit.Effects.ApplicationButtonMenuOpenShadow"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Opacity="0.2"
                      Color="#000000" />

    <system:Boolean x:Key="RibbonKit.Behaviors.ApplicationMenuAnchorBelowButton">True</system:Boolean>
    <Thickness x:Key="RibbonKit.Metrics.ApplicationMenuMargin">0</Thickness>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuInnerCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuTopBandCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.ApplicationMenuFooterCornerRadius">0</CornerRadius>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuNavWidth">150</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuPaneWidth">340</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuItemHeight">40</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuArrowWidth">26</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuTopBandHeight">4</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuFooterHeight">34</system:Double>
    <system:Double x:Key="RibbonKit.Metrics.ApplicationMenuDimOpacity">0.4</system:Double>

</ResourceDictionary>
