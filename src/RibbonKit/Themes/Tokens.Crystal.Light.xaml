<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:RibbonKit.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Crystal Light tokens for the shared RibbonKit templates. Office 2024 supplies
         the unchanged keys; hosts may merge this dictionary as an opt-in preview. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RibbonKit;component/Themes/Tokens.Office2024.xaml" />
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.ScrollBars.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Ribbon.TabStripBackground" Color="Transparent" />
    <sys:Double x:Key="RibbonKit.Metrics.Ribbon.TabStripGlassOpacity">0.88</sys:Double>
    <sys:Double x:Key="RibbonKit.Metrics.Ribbon.BodyGlassOpacity">0.44</sys:Double>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Window.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DCEAF4" Offset="0" />
        <GradientStop Color="#EBE8F5" Offset="0.48" />
        <GradientStop Color="#DDEEEB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.TitleBar.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8F4FC" Offset="0" />
        <GradientStop Color="#EAEAF6" Offset="0.65" />
        <GradientStop Color="#E3F1F0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Ribbon.ContentBackground" StartPoint="0,0" EndPoint="0.25,1">
