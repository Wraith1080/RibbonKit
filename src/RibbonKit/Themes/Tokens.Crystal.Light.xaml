                         Center="0.5,0.15" GradientOrigin="0.5,0.15" RadiusX="0.9" RadiusY="1.1">
        <GradientStop Color="#F7FCFF" Offset="0" />
        <GradientStop Color="#DFEEF9" Offset="0.58" />
        <GradientStop Color="#C6DFF0" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.ActiveCaptionForeground" Color="#20364A" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F9FCFE" Offset="0" />
        <GradientStop Color="#E9F2F8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveCaptionForeground" Color="#52697B" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.ActiveBorder" Color="#709BBC" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.InactiveBorder" Color="#A9C5D8" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.MdiClient.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6F1F8" Offset="0" />
        <GradientStop Color="#DCEAF4" Offset="0.55" />
        <GradientStop Color="#E8EDF7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.CaptionButtonHoverBackground" Color="#385885B1" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.MdiChild.CaptionButtonPressedBackground" Color="#605885B1" />
    <CornerRadius x:Key="RibbonKit.Metrics.MdiChild.CornerRadius">10</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.MdiChild.CaptionCornerRadius">9,9,0,0</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.MdiChild.CloseButtonCornerRadius">0,9,0,0</CornerRadius>
    <!-- User-preferred rim: steady blue-gray sides with localized top/bottom glints.
         The small inset impression is preferred to the full-height gradient's taper. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.HoverBackground" Color="#205885B1" />
    <DrawingGroup x:Key="Crystal.Drawing.GlassRim">
        <GeometryDrawing Brush="#8892ABC0" Geometry="M0,0 H1 V1 H0 Z" />
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
            <GeometryDrawing.Brush>
                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0"
                                     RadiusX="0.48" RadiusY="0.10">
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#CCFFFFFF" Offset="0.55" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
            <GeometryDrawing.Brush>
                <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1"
                                     RadiusX="0.48" RadiusY="0.10">
                    <GradientStop Color="#A66D88A0" Offset="0" />
                    <GradientStop Color="#006D88A0" Offset="1" />
                </RadialGradientBrush>
            </GeometryDrawing.Brush>
        </GeometryDrawing>
    </DrawingGroup>
    <DrawingBrush x:Key="RibbonKit.Brushes.Control.HoverBorder"
                  Drawing="{StaticResource Crystal.Drawing.GlassRim}"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
    <!-- Reflection lives inside the fill, so the darker outer border remains intact.
         Soft horizontal falloff avoids a hard white stripe at the rounded corners. -->
    <GeometryDrawing x:Key="Crystal.Drawing.InnerReflection" Geometry="M0,0 H1 V1 H0 Z">
        <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.5,0.91" GradientOrigin="0.5,0.91"
                                 RadiusX="0.46" RadiusY="0.075">
                <GradientStop Color="#D9FFFFFF" Offset="0" />
                <GradientStop Color="#70F4FCFF" Offset="0.45" />
                <GradientStop Color="#00F4FCFF" Offset="1" />
            </RadialGradientBrush>
        </GeometryDrawing.Brush>
    </GeometryDrawing>
    <DrawingBrush x:Key="RibbonKit.Brushes.Control.PressedBackground"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.85" RadiusY="0.85">
                            <GradientStop Color="#DFEFFA" Offset="0" />
                            <GradientStop Color="#C8DFEF" Offset="0.6" />
                            <GradientStop Color="#AFCBDF" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <StaticResource ResourceKey="Crystal.Drawing.InnerReflection" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Control.PressedBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#90678BAA" Offset="0" />
        <GradientStop Color="#60678BAA" Offset="0.55" />
        <GradientStop Color="#C07898B2" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.Control.CheckedBackground"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.85" RadiusY="0.85">
                            <GradientStop Color="#EAF5FC" Offset="0" />
                            <GradientStop Color="#D6E8F4" Offset="0.6" />
                            <GradientStop Color="#BED5E7" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <DrawingGroup Opacity="0.65">
                    <StaticResource ResourceKey="Crystal.Drawing.InnerReflection" />
                </DrawingGroup>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <RadialGradientBrush x:Key="RibbonKit.Brushes.Control.CheckedHoverBackground"
                         Center="0.5,0.72" GradientOrigin="0.5,0.72" RadiusX="0.85" RadiusY="0.9">
        <GradientStop Color="#DAEDF9" Offset="0" />
        <GradientStop Color="#BBD5EA" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Control.CheckedBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A67898B2" Offset="0" />
        <GradientStop Color="#707898B2" Offset="0.5" />
        <GradientStop Color="#A67898B2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.InnerGlow" Color="Transparent" />
    <!-- Both halves light when one is hovered; the active half gets a stronger wash. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionBackground" Color="#205885B1" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.SplitActiveHover" Color="#405885B1" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionBorder" Color="#805D82A6" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Control.CompanionGlow" Color="Transparent" />
    <Thickness x:Key="RibbonKit.Metrics.ControlHighlightBorderThickness">1</Thickness>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Group.Separator" Color="#40819DB5" />
    <!-- Selection carries the stronger glass surface and an icy reflective marker.
         Hover borrows a quieter rim; its gray underline would compete with selection. -->
    <RadialGradientBrush x:Key="RibbonKit.Brushes.Tab.SelectedBackground" controls:ContextualMaterial.Enabled="True"
                         Center="0.5,0.25" GradientOrigin="0.5,0.25" RadiusX="0.85" RadiusY="0.95">
        <GradientStop Color="#F5FBFF" Offset="0" />
        <GradientStop Color="#E1EFF9" Offset="0.55" />
        <GradientStop Color="#C7DEEF" Offset="1" />
    </RadialGradientBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.Tab.SelectedBorderBrush" controls:ContextualMaterial.Enabled="True"
                  Drawing="{StaticResource Crystal.Drawing.GlassRim}"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
    <!-- The 2024 base disables its tab-to-body bridge. Crystal's outlined tab needs both
         the strip-side foot and body-side notch to cover the two seam pixels. -->
    <TranslateTransform x:Key="RibbonKit.Transforms.TabConnect" Y="1" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectFootSelected" Color="#C7DEEF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.ConnectNotch" Color="#C7DEEF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.HoverBackground" controls:ContextualMaterial.Enabled="True" Color="#187BA5C7" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.QatExtender.Background" Color="#187BA5C7" />
    <DrawingBrush x:Key="RibbonKit.Brushes.Tab.HoverBorder" controls:ContextualMaterial.Enabled="True"
                  Drawing="{StaticResource Crystal.Drawing.GlassRim}" Opacity="0.6"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
    <DropShadowEffect x:Key="RibbonKit.Effects.QatExtenderShadow" Color="#34485A"
                      BlurRadius="10" ShadowDepth="0" Opacity="0.3" />
    <DrawingBrush x:Key="RibbonKit.Brushes.QatExtender.Border"
                  Drawing="{StaticResource Crystal.Drawing.GlassRim}" Opacity="0.6"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5" />
        </DrawingBrush.RelativeTransform>
    </DrawingBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.Tab.HoverUnderline" Color="Transparent" />
    <!-- The existing rounded marker clips this brush into a pill. A darker upper/lower
         edge surrounds a luminous center, with a localized glint for a trapped-air look. -->
    <DrawingBrush x:Key="RibbonKit.Brushes.Tab.SelectedUnderline" controls:ContextualMaterial.Enabled="True"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" Opacity="0.9">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#809FB5" Offset="0" />
                            <GradientStop Color="#BCD6E6" Offset="0.2" />
                            <GradientStop Color="#EBF8FF" Offset="0.48" />
                            <GradientStop Color="#D1EAF6" Offset="0.76" />
                            <GradientStop Color="#8CAFC5" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush Center="0.3,0.42" GradientOrigin="0.3,0.42"
                                             RadiusX="0.28" RadiusY="0.48">
                            <GradientStop Color="#D9FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Modern File panel: opaque readable sheet, softly tinted rail, and the same
         reflective selection material as the ribbon. Accent variants recolor these too. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Backstage.Modern.NavBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F3FAFE" Offset="0" />
        <GradientStop Color="#E4EFF8" Offset="0.65" />
        <GradientStop Color="#DCEAF4" Offset="1" />
    </LinearGradientBrush>
    <!-- Shared translucent-rail token; Crystal also uses it for its two Backstage layouts. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.NavBackgroundTranslucent" Color="#88E4EFF8" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.Backstage.Modern.Foreground" Color="#20364A" />
    <LinearGradientBrush x:Key="RibbonKit.Brushes.Backstage.ContentBackground" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Color="#FCFEFF" Offset="0" />
        <GradientStop Color="#F4F9FD" Offset="0.7" />
        <GradientStop Color="#ECF4FA" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemHover" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="{StaticResource RibbonKit.Brushes.Tab.SelectedBackground}" /></DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemSelected" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="{StaticResource RibbonKit.Brushes.Control.CheckedBackground}" /></DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemHoverTranslucent" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="{StaticResource RibbonKit.Brushes.Tab.SelectedBackground}" /></DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.Backstage.Modern.ItemSelectedTranslucent" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="{StaticResource RibbonKit.Brushes.Control.CheckedBackground}" /></DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- File shares the ordinary tab wash; its existing overlay supplies the tab rim. -->
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.HoverBackground" Color="#187BA5C7" />
    <DrawingBrush x:Key="RibbonKit.Brushes.ApplicationButton.PressedBackground" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="{StaticResource RibbonKit.Brushes.Control.PressedBackground}" /></DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.ApplicationButton.MenuOpenBackground" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="{StaticResource RibbonKit.Brushes.Control.CheckedBackground}" /></DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.ApplicationButton.MenuOpenBottom" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,0 H1 V1 H0 Z" Brush="{StaticResource RibbonKit.Brushes.Control.CheckedBackground}" /></DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.Foreground" Color="#20364A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.MenuOpenForeground" Color="#20364A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.ApplicationButton.HoverUnderline" Color="Transparent" />
    <DrawingBrush x:Key="RibbonKit.Brushes.ApplicationButton.InnerGlow"
                  Drawing="{StaticResource Crystal.Drawing.GlassRim}" Opacity="0.6"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
    <Thickness x:Key="RibbonKit.Metrics.ApplicationButtonInnerRimBorderThickness">1</Thickness>
    <sys:Double x:Key="RibbonKit.Metrics.ApplicationButtonInnerRimIdleOpacity">0</sys:Double>
    <!-- Reserve the same rim on every tab, so selecting or hovering never moves labels. -->
    <Thickness x:Key="RibbonKit.Metrics.TabSelectedBorderThickness">1,1,1,0</Thickness>
    <!-- The translucent hover is painted once by HeaderChrome; no overlapping foot. -->
    <sys:Double x:Key="RibbonKit.Metrics.TabHoverConnectFootOpacity">0</sys:Double>
    <Thickness x:Key="RibbonKit.Metrics.TabMinimizedSelectedBorderThickness">1</Thickness>
    <!-- Shared utility chrome: collapse, pin, scroll arrows and QAT overflow.
         Reuse the accepted command shading at a quieter hover strength. -->
    <DrawingBrush x:Key="RibbonKit.Brushes.TabStrip.ControlHoverBackground"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" Opacity="0.8">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z"
                             Brush="{StaticResource RibbonKit.Brushes.Control.CheckedBackground}" />
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.TabStrip.ControlPressedBackground"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z"
                             Brush="{StaticResource RibbonKit.Brushes.Control.PressedBackground}" />
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="RibbonKit.Brushes.TabStrip.ScrollButtonBackground"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z"
                             Brush="{StaticResource RibbonKit.Brushes.Ribbon.ContentBackground}" />
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Native WPF popups have no shared backdrop: use a readable opaque frosting. -->
    <LinearGradientBrush x:Key="RibbonKit.Brushes.ScreenTip.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFDFF" Offset="0" />
        <GradientStop Color="#E8F0F8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.ScreenTip.Border" Color="#A5BBCE" />
    <!-- Small opaque lenses keep keyboard labels readable over ribbon content. -->
    <DrawingBrush x:Key="RibbonKit.Brushes.KeyTip.Background"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FAFDFF" Offset="0" />
                            <GradientStop Color="#EAF3FA" Offset="0.6" />
                            <GradientStop Color="#D5E6F2" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <StaticResource ResourceKey="Crystal.Drawing.InnerReflection" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Border" Color="#7C9EB8" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.KeyTip.Foreground" Color="#20364A" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.HoverBackground" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="RibbonKit.Brushes.CaptionButton.PressedBackground" Color="#809EBBD2" />
    <CornerRadius x:Key="RibbonKit.Metrics.ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.MenuItemCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.SmallControlCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.PopupCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RibbonKit.Metrics.DropDownHeaderCornerRadius">8</CornerRadius>
    <!-- A persistent boundary needs less white than a transient hover rim: the
         gallery is surrounded by pale surfaces on both sides of this outline. -->
    <DrawingGroup x:Key="Crystal.Drawing.GalleryRim">
        <GeometryDrawing Brush="#8FAABE" Geometry="M0,0 H1 V1 H0 Z" />
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
            <GeometryDrawing.Brush>
                <RadialGradientBrush Center="0.68,0" GradientOrigin="0.68,0" RadiusX="0.27" RadiusY="0.10">
                    <GradientStop Color="#DAE8F1" Offset="0" />
                    <GradientStop Color="#00B7CBDA" Offset="1" />
                </RadialGradientBrush>
            </GeometryDrawing.Brush>
        </GeometryDrawing>
    </DrawingGroup>
    <DrawingBrush x:Key="Crystal.Brushes.GalleryBorder" Drawing="{StaticResource Crystal.Drawing.GalleryRim}"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill" />
    <!-- Shallow recessed glass: opaque reading plane, an inward top/side shadow
         and a restrained lower reflection. The outer rim remains distinct. -->
    <DrawingGroup x:Key="Crystal.Drawing.GallerySurface">
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
            <GeometryDrawing.Brush>
                <RadialGradientBrush Center="0.55,0.6" GradientOrigin="0.55,0.6" RadiusX="0.9" RadiusY="0.95">
                    <GradientStop Color="#F5FBFE" Offset="0" />
                    <GradientStop Color="#E5F1F8" Offset="0.55" />
                    <GradientStop Color="#D5E6F1" Offset="1" />
                </RadialGradientBrush>
            </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
            <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B8FFFFFF" Offset="0" />
                    <GradientStop Color="#40FFFFFF" Offset="0.015" />
                    <GradientStop Color="#3852738C" Offset="0.045" />
                    <GradientStop Color="#1552738C" Offset="0.09" />
                    <GradientStop Color="#0052738C" Offset="0.20" />
                    <GradientStop Color="#00FFFFFF" Offset="0.88" />
                    <GradientStop Color="#50FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z">
            <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2052738C" Offset="0" />
                    <GradientStop Color="#0052738C" Offset="0.025" />
                    <GradientStop Color="#0052738C" Offset="0.975" />
