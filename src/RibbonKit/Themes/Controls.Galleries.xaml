<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls"
    xmlns:layout="clr-namespace:RibbonKit.Layout">

    <!-- The aggregator also lists this part directly for the public RibbonScrollBar.
         Import it here as well because deferred gallery templates resolve StaticResource
         only within their own dictionary/merged dictionaries, not aggregator siblings. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.ScrollBars.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Part of the shared RibbonKit control-template dictionary; merged by Office2024.xaml.
         RibbonGalleryItem, RibbonGallery, InRibbonGallery.
         Colours/metrics come from Tokens.Office20XX.xaml via {DynamicResource}. -->

    <!-- A deferred ScrollViewer template cannot use StaticResource against an aggregator
         sibling, and cross-file BasedOn chains are unsupported by the XAML designer. Keep
         this small gallery adapter local while importing the one shared template source above. -->
    <Style x:Key="RibbonKit.GalleryScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.Glyph}" />
        <Setter Property="Width" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
        <Setter Property="MinWidth" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
        <Setter Property="controls:RibbonScrollBar.ButtonCornerRadius"
                Value="{DynamicResource RibbonKit.Metrics.ScrollBar.ButtonCornerRadius}" />
        <Setter Property="controls:RibbonScrollBar.ThumbCornerRadius"
                Value="{DynamicResource RibbonKit.Metrics.ScrollBar.ThumbCornerRadius}" />
        <Setter Property="controls:RibbonScrollBar.RailCornerRadius"
                Value="{DynamicResource RibbonKit.Metrics.ScrollBar.RailCornerRadius}" />
        <Setter Property="Template" Value="{StaticResource RibbonKit.VerticalScrollBarTemplate}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
                <Setter Property="MinHeight" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
                <Setter Property="Template" Value="{StaticResource RibbonKit.HorizontalScrollBarTemplate}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         RibbonGalleryItem — selectable tile with hover/selected chrome
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonGalleryItem}">
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonGalleryItem}">
                    <!-- MinHeight sets the tile row height; the presenter centers the
                         (naturally-sized) content inside it. -->
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            Margin="1"
                            Padding="5,3"
                            MinHeight="48"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Group.Separator}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.CheckedBackground}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonGallery — wrapped tiles (for use inside flyouts)
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonGallery}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonGallery}">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="340">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource RibbonKit.GalleryScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         InRibbonGallery — strip + scroll/expand buttons + overlay popup
         ============================================================ -->
    <Style TargetType="{x:Type controls:InRibbonGallery}">
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Height = exactly one tile row (48 min-height incl. border + 2 margin = 50)
             + the 4px strip margins. The viewport equals the row height EXACTLY, so
             no second-row sliver is visible or hoverable in the strip. -->
        <Setter Property="Height" Value="54" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InRibbonGallery}">
                    <Grid UseLayoutRounding="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="17" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2"
                                Background="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}"
                                BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                SnapsToDevicePixels="True" />
                        <Decorator x:Name="PART_ContentHost" Grid.Column="0" Margin="2">
                            <!-- Keep the strip viewport permanently in the main-window tree.
                                 Only PART_ItemsPresenter moves to the popup, so a per-monitor
                                 DPI transition cannot carry an HWND-specific viewport/clip back. -->
                            <ScrollViewer x:Name="PART_ScrollViewer"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <!-- MaxWidth caps wrapping at the strip's width even when
                                     re-homed into the (unconstrained) popup, so the
                                     expanded gallery wraps into rows instead of one line -->
                                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ScrollViewer>
                        </Decorator>
                        <Grid x:Name="SideButtonHost"
                              Grid.Column="1"
                              Margin="0,1"
                              UseLayoutRounding="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <!-- Shared chrome for the three side buttons -->
                                <Style x:Key="SideButtonStyle" TargetType="{x:Type ButtonBase}">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ButtonBase}">
                                                <!-- The transparent root deliberately owns the complete
                                                     row. The inset border is visual chrome only; margins
                                                     must never create dead hit-test gutters at fractional DPI. -->
                                                <Grid Background="Transparent"
                                                      SnapsToDevicePixels="True"
                                                      UseLayoutRounding="True">
                                                    <Border x:Name="Chrome"
                                                            Background="Transparent"
                                                            BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                                            CornerRadius="{DynamicResource RibbonKit.Metrics.SmallControlCornerRadius}"
                                                            Margin="1,0,2,0"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background"
                                                                Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                                                        <Setter TargetName="Chrome" Property="BorderBrush"
                                                                Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                                                        <Setter TargetName="Chrome" Property="BorderThickness"
                                                                Value="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background"
                                                                Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                                                        <Setter TargetName="Chrome" Property="BorderBrush"
                                                                Value="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}" />
                                                        <Setter TargetName="Chrome" Property="BorderThickness"
                                                                Value="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <RepeatButton x:Name="PART_LineUp"
                                          Grid.Row="0"
                                          Style="{StaticResource SideButtonStyle}">
                                <Path Data="M0,3.5 L3.5,0 L7,3.5"
                                      Stroke="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </RepeatButton>
                            <RepeatButton x:Name="PART_LineDown"
                                          Grid.Row="1"
                                          Style="{StaticResource SideButtonStyle}">
                                <Path Data="M0,0 L3.5,3.5 L7,0"
                                      Stroke="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </RepeatButton>
                            <ToggleButton x:Name="PART_ExpandToggle"
                                          Grid.Row="2"
                                          Style="{StaticResource SideButtonStyle}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <StackPanel>
                                    <Rectangle Height="1.5" Width="8"
                                               Fill="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                               Margin="0,0,0,2" />
                                    <Path Data="M0,0 L3.5,3.5 L7,0"
                                          Stroke="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                        <!-- Expanded gallery: overlays the strip, like Office -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               StaysOpen="True"
                               Placement="Custom"
                               PlacementTarget="{Binding ElementName=PART_ContentHost}"
                               HorizontalOffset="-1"
                               VerticalOffset="-8"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <!--
                                A transparent Popup is a separate HWND. Its custom placement keeps
                                the natural-width card's edge at PART_ContentHost's edge, so it
                                expands away from PART_LineUp/LineDown/ExpandToggle rather than
                                overlapping those main-window controls.
                            -->
                            <Border x:Name="PART_PopupHost"
                                    Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.PopupCornerRadius}"
                                    Padding="5"
                                    Margin="4,4,4,8"
                                    MaxHeight="340">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <!-- This viewport remains owned by the popup HWND. The single
                                     ItemsPresenter is attached here only while the popup is open. -->
                                <ScrollViewer x:Name="PART_PopupScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="{x:Type ScrollBar}"
                                               BasedOn="{StaticResource RibbonKit.GalleryScrollBarStyle}" />
                                    </ScrollViewer.Resources>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
