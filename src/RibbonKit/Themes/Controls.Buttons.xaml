<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls"
    xmlns:layout="clr-namespace:RibbonKit.Layout">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.Focus.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Part of the shared RibbonKit control-template dictionary; merged by Office2024.xaml.
         RibbonButton, RibbonScreenTip, RibbonToggleButton, RibbonCheckBox, RibbonRadioButton.
         Colours/metrics come from Tokens.Office20XX.xaml via {DynamicResource}. -->

    <!-- ============================================================
         RibbonButton — Large / Medium / Small layouts via triggers
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource RibbonKit.KeyboardFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonButton}">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            Margin="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Hover/press cross-fade layers: opacity is animated 0<->1 over the
                                 Hover duration token, so the highlight eases instead of snapping.
                                 Behind the content, non-hit-testable. -->
                            <Border x:Name="HoverWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False">
                                <Border BorderBrush="{DynamicResource RibbonKit.Brushes.Control.InnerGlow}"
                                        BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                        CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}" />
                            </Border>
                            <Border x:Name="PressWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <!-- Large: 32px icon over wrapped label -->
                            <StackPanel x:Name="LargeLayout"
                                        Orientation="Vertical"
                                        Margin="6,8,6,0"
                                        VerticalAlignment="Center">
                                <Image x:Name="LargeImage"
                                       Source="{TemplateBinding LargeIcon}"
                                       Width="32" Height="32"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Header}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="76"
                                           MinHeight="32"
                                           MaxHeight="48"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <!-- Medium: 16px icon + label in a row -->
                            <StackPanel x:Name="MediumLayout"
                                        Orientation="Horizontal"
                                        Margin="4,2"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Image x:Name="MediumImage" Source="{TemplateBinding Icon}"
                                       Width="16" Height="16"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Header}"
                                           Margin="5,0,2,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Small: 16px icon only. Tight vertical margin so a stack of
                                 three small buttons plus the group caption fits the fixed
                                 groups row. Two renderings: the normal colour icon, and a
                                 flat white silhouette shown when Ribbon.QatOnColoredSurface
                                 is set (QAT on a colored title bar / strip). -->
                            <Grid x:Name="SmallLayout"
                                  Margin="5,3"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed">
                                <Image x:Name="SmallImage"
                                       Source="{TemplateBinding Icon}"
                                       Width="16" Height="16"
                                       Stretch="Uniform" />
                                <Rectangle x:Name="SmallImageTint" Width="16" Height="16"
                                           Fill="#FFFFFF"
                                           Visibility="Collapsed">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- QAT on a colored surface (accent title bar / colored strip): draw
                             the icon as a white silhouette instead of its full colour. -->
                        <Trigger Property="controls:Ribbon.QatOnColoredSurface" Value="True">
                            <Setter TargetName="SmallImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SmallImageTint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="LargeIcon" Value="{x:Null}">
                            <Setter TargetName="LargeImage" Property="Source"
                                    Value="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="Size" Value="Medium">
                            <Setter TargetName="LargeLayout" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MediumLayout" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Size" Value="Small">
                            <Setter TargetName="LargeLayout" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SmallLayout" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Hover/press highlight is a cross-fade of HoverWash/PressWash, driven in
                             code (RibbonButton.OnPropertyChanged -> RibbonMotion.FadeWash) so it
                             honors the animation level / reduced-motion — template storyboards can't
                             read the runtime Duration tokens (a DynamicResource makes the storyboard
                             un-freezable). Off a colored surface only; the QAT-on-colored variants
                             below stay instant. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <!-- On a colored surface, hover/press with the surrounding band's brushes
                             (caption/tab) instead of the neutral control brushes. Pressed comes
                             AFTER hover so it wins while the button is held. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="controls:Ribbon.QatOnColoredSurface" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Qat.ColoredHoverBackground}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="controls:Ribbon.QatOnColoredSurface" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Qat.ColoredPressedBackground}" />
                        </MultiTrigger>
                        <Trigger Property="controls:Ribbon.Density" Value="Touch">
                            <Setter TargetName="Chrome" Property="Margin" Value="{DynamicResource RibbonKit.Metrics.Touch.ChromeMargin}" />
                            <Setter TargetName="SmallImage" Property="Width" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="SmallImage" Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="SmallImageTint" Property="Width" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="SmallImageTint" Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="MediumImage" Property="Width" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="MediumImage" Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="LargeImage" Property="Width" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeIconSize}" />
                            <Setter TargetName="LargeImage" Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeIconSize}" />
                            <Setter TargetName="LargeLayout" Property="Margin" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeLayoutMargin}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="controls:Ribbon.Density" Value="Touch">
                <Setter Property="MinHeight" Value="{DynamicResource RibbonKit.Metrics.Touch.TargetSize}" />
                <Setter Property="MinWidth" Value="{DynamicResource RibbonKit.Metrics.Touch.TargetSize}" />
                <Setter Property="Margin" Value="{DynamicResource RibbonKit.Metrics.Touch.ControlMargin}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="controls:Ribbon.Density" Value="Touch" />
                    <Condition Property="Size" Value="Large" />
                </MultiTrigger.Conditions>
                <Setter Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeButtonHeight}" />
                <Setter Property="MinWidth" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeButtonMinWidth}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         RibbonScreenTip — rich tooltip
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonScreenTip}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.ScreenTip.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonScreenTip}">
                    <Border x:Name="OuterRim" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.OuterBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ScreenTip.OuterCornerRadius}"
                            Margin="{DynamicResource RibbonKit.Metrics.ScreenTip.OuterMargin}"
                            Effect="{DynamicResource RibbonKit.Effects.ScreenTipShadow}"
                            MaxWidth="300">
                        <Grid>
                            <Border x:Name="InnerReflection"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ScreenTip.InnerCornerRadius}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.InnerReflection}"
                                    IsHitTestVisible="False" />
                            <StackPanel Margin="10,8">
                                <TextBlock x:Name="TitleText"
                                           Text="{TemplateBinding Title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DescriptionText"
                                           Text="{TemplateBinding Description}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DescriptionText" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonToggleButton — like RibbonButton + checked accent tint
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonToggleButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource RibbonKit.KeyboardFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonToggleButton}">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            Margin="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Checked / hover / press cross-fade layers. Checked eases over the
                                 ToggleState token; hover/press over the Hover token. Checked+hover
                                 composes (check wash + hover wash) rather than a separate brush.
                                 Behind the content, non-hit-testable. -->
                            <Border x:Name="CheckWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.CheckedBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.CheckedBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False">
                                <Border BorderBrush="{DynamicResource RibbonKit.Brushes.Control.InnerGlow}"
                                        BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                        CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}" />
                            </Border>
                            <Border x:Name="HoverWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False">
                                <Border BorderBrush="{DynamicResource RibbonKit.Brushes.Control.InnerGlow}"
                                        BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                        CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}" />
                            </Border>
                            <Border x:Name="PressWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <StackPanel x:Name="LargeLayout"
                                        Orientation="Vertical"
                                        Margin="6,8,6,0"
                                        VerticalAlignment="Center">
                                <Image x:Name="LargeImage"
                                       Source="{TemplateBinding LargeIcon}"
                                       Width="32" Height="32"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Header}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="76"
                                           MinHeight="32"
                                           MaxHeight="48"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="MediumLayout"
                                        Orientation="Horizontal"
                                        Margin="4,2"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Image x:Name="MediumImage" Source="{TemplateBinding Icon}"
                                       Width="16" Height="16"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Header}"
                                           Margin="5,0,2,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid x:Name="SmallLayout"
                                  Width="16" Height="16"
                                  Margin="5,3"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed">
                                <Image x:Name="SmallImage"
                                       Source="{TemplateBinding Icon}"
                                       Width="16" Height="16"
                                       Stretch="Uniform" />
                                <Rectangle x:Name="SmallImageTint" Width="16" Height="16"
                                           Fill="#FFFFFF"
                                           Visibility="Collapsed">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="LargeIcon" Value="{x:Null}">
                            <Setter TargetName="LargeImage" Property="Source"
                                    Value="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="Size" Value="Medium">
                            <Setter TargetName="LargeLayout" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MediumLayout" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Size" Value="Small">
                            <Setter TargetName="LargeLayout" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SmallLayout" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Hover/press/checked highlight is a cross-fade of HoverWash/PressWash/
                             CheckWash, driven in code (RibbonToggleButton.OnPropertyChanged ->
                             RibbonMotion.FadeWash) so it honors the animation level / reduced-motion.
                             Checked+hover composes the check wash under the hover wash. Off a colored
                             surface only; the QAT-on-colored variants below stay instant. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <!-- QAT on a colored surface: white silhouette icon, and band-based
                             hover/pressed/checked so the toggle blends like the plain buttons.
                             These come LAST so they win; checked/pressed after hover. -->
                        <Trigger Property="controls:Ribbon.QatOnColoredSurface" Value="True">
                            <Setter TargetName="SmallImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SmallImageTint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="controls:Ribbon.QatOnColoredSurface" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Qat.ColoredHoverBackground}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="controls:Ribbon.QatOnColoredSurface" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Qat.ColoredPressedBackground}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="controls:Ribbon.QatOnColoredSurface" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Qat.ColoredPressedBackground}" />
                        </MultiTrigger>
                        <Trigger Property="controls:Ribbon.Density" Value="Touch">
                            <Setter TargetName="Chrome" Property="Margin" Value="{DynamicResource RibbonKit.Metrics.Touch.ChromeMargin}" />
                            <Setter TargetName="SmallImage" Property="Width" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="SmallImage" Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="SmallImageTint" Property="Width" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="SmallImageTint" Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="MediumImage" Property="Width" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="MediumImage" Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="LargeImage" Property="Width" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeIconSize}" />
                            <Setter TargetName="LargeImage" Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeIconSize}" />
                            <Setter TargetName="LargeLayout" Property="Margin" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeLayoutMargin}" />
                            <Setter TargetName="SmallLayout" Property="Width" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                            <Setter TargetName="SmallLayout" Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.IconSize}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="controls:Ribbon.Density" Value="Touch">
                <Setter Property="MinHeight" Value="{DynamicResource RibbonKit.Metrics.Touch.TargetSize}" />
                <Setter Property="MinWidth" Value="{DynamicResource RibbonKit.Metrics.Touch.TargetSize}" />
                <Setter Property="Margin" Value="{DynamicResource RibbonKit.Metrics.Touch.ControlMargin}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="controls:Ribbon.Density" Value="Touch" />
                    <Condition Property="Size" Value="Large" />
                </MultiTrigger.Conditions>
                <Setter Property="Height" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeButtonHeight}" />
                <Setter Property="MinWidth" Value="{DynamicResource RibbonKit.Metrics.Touch.LargeButtonMinWidth}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         Compact option controls — CheckBox / RadioButton
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonCheckBox}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource RibbonKit.KeyboardFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonCheckBox}">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="HoverWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <!-- Keep content spacing off Chrome: padding there would also inset the
                                 sibling hover/press washes from the full focus rectangle. -->
                            <Grid x:Name="ContentGrid" Margin="5,1,5,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="FocusRing" Width="18" Height="18" Margin="-2,0"
                                        VerticalAlignment="Center" CornerRadius="5" BorderThickness="1"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Option.FocusBorder}"
                                        Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="Indicator" Width="14" Height="14"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource RibbonKit.Brushes.Option.IdleSurface}"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Option.IdleBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RibbonKit.Metrics.OptionCornerRadius}">
                                    <Grid>
                                        <Path x:Name="CheckMark" Data="M 1,5 L 4,8 L 10,1"
                                              Stroke="{DynamicResource RibbonKit.Brushes.Option.Glyph}"
                                              StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stretch="Uniform" Margin="2.5" Visibility="Collapsed" />
                                        <Rectangle x:Name="IndeterminateMark" Width="7" Height="2"
                                                   RadiusX="1" RadiusY="1"
                                                   Fill="{DynamicResource RibbonKit.Brushes.Option.Glyph}"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="HeaderPresenter" Grid.Column="1"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  Margin="6,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Content"
                                    Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.SelectedBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.SelectedSurface}" />
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.SelectedBorder}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Indicator" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.SelectedSurface}" />
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.SelectedBorder}" />
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.ChromeFocusBorder}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="controls:Ribbon.Density" Value="Touch">
                <Setter Property="MinHeight" Value="{DynamicResource RibbonKit.Metrics.Touch.TargetSize}" />
                <Setter Property="MinWidth" Value="{DynamicResource RibbonKit.Metrics.Touch.TargetSize}" />
                <Setter Property="Margin" Value="{DynamicResource RibbonKit.Metrics.Touch.ControlMargin}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:RibbonRadioButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource RibbonKit.KeyboardFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonRadioButton}">
                    <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="HoverWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="PressWash"
                                    Background="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}"
                                    BorderBrush="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}"
                                    BorderThickness="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                    Opacity="0" IsHitTestVisible="False" />
                            <!-- Same geometry contract as RibbonCheckBox: washes fill Chrome;
                                 only indicator/text content receives the inset. -->
                            <Grid x:Name="ContentGrid" Margin="5,1,5,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="FocusRing" Width="18" Height="18" Margin="-2,0"
                                         VerticalAlignment="Center" StrokeThickness="1"
                                         Stroke="{DynamicResource RibbonKit.Brushes.Option.FocusBorder}"
                                         Opacity="0" IsHitTestVisible="False" />
                                <Ellipse x:Name="Indicator" Width="14" Height="14"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource RibbonKit.Brushes.Option.IdleSurface}"
                                         Stroke="{DynamicResource RibbonKit.Brushes.Option.IdleBorder}"
                                         StrokeThickness="1" />
                                <Ellipse x:Name="SelectionMark" Width="6" Height="6"
                                         Fill="{DynamicResource RibbonKit.Brushes.Option.Glyph}"
                                         VerticalAlignment="Center" Visibility="Collapsed" />
                                <ContentPresenter x:Name="HeaderPresenter" Grid.Column="1"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  Margin="6,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Content"
                                    Value="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Indicator" Property="Stroke"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.SelectedBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Fill"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.SelectedSurface}" />
                            <Setter TargetName="Indicator" Property="Stroke"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.SelectedBorder}" />
                            <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Option.ChromeFocusBorder}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="controls:Ribbon.Density" Value="Touch">
                <Setter Property="MinHeight" Value="{DynamicResource RibbonKit.Metrics.Touch.TargetSize}" />
                <Setter Property="MinWidth" Value="{DynamicResource RibbonKit.Metrics.Touch.TargetSize}" />
                <Setter Property="Margin" Value="{DynamicResource RibbonKit.Metrics.Touch.ControlMargin}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
