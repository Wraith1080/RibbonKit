<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls">

    <!-- Part of the shared RibbonKit control-template dictionary; merged by Office2024.xaml.
         RibbonApplicationMenu and its three companions. Colours/metrics come from
         Tokens.Office20XX.xaml via {DynamicResource}.

         This is the Office 2007 APPLICATION MENU — the two-pane drop-down the orb opens — and NOT
         the backstage, which lives in Controls.Backstage.xaml and is a full-window adorner overlay.
         The geometry here is measured from real Office 2007 captures; see
         docs/07-OFFICE-2007-THEME-PLAN.md and 04-DESIGN-NOTES.md §3.46.

         THE FRAME is a five-band sandwich, exactly as sampled across a horizontal scan line:

             #9BAFCA | #FFFFFF | band | #FFFFFF | #9BAFCA | content

         The middle band is a flat 3px on the sides, an 18px vertical gradient across the top, and
         the FOOTER BAR itself along the bottom. That is why the template is three nested Borders
         around a three-row Grid rather than one Border with a fat BorderThickness. -->

    <!-- Hit target inside a nav row. Draws NOTHING: the row's own template paints the gold glass
         underneath it in one piece across both halves, so a button that painted its own background
         would cut the fill in two. These exist purely to split the row into two click regions and
         to publish IsPressed for the row's triggers. -->
    <Style x:Key="RibbonKit.ApplicationMenuHitArea" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonApplicationMenuItem — one row of the left command column
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonApplicationMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonApplicationMenuItem}">
                    <!-- Background=Transparent, not null: the row's IsMouseOver is what lights BOTH
                         halves, so the gaps between the two buttons must be hit-testable too or the
                         highlight would blink off as the pointer crossed the hairline. -->
                    <Grid x:Name="Root"
                          Height="{DynamicResource RibbonKit.Metrics.ApplicationMenuItemHeight}"
                          Background="Transparent"
                          SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- THE TWO FILLS. Same brush, driven independently through Opacity — which
                             is the whole trick behind the half-lit state: Office 2007 dims the
                             command half to roughly a third while the pane is being used, and a
                             measured sample of that state is the hover gold composited over the nav
                             column at ~0.32 alpha. One brush, one number, no second gradient per
                             theme. -->
                        <Border x:Name="MainFill"
                                Grid.Column="0"
                                Opacity="0"
                                Background="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}">
                            <Border BorderBrush="{DynamicResource RibbonKit.Brushes.Control.InnerGlow}"
                                    BorderThickness="1,1,0,1" />
                        </Border>
                        <Border x:Name="ArrowFill"
                                Grid.Column="1"
                                Opacity="0"
                                Width="{DynamicResource RibbonKit.Metrics.ApplicationMenuArrowWidth}"
                                Background="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}">
                            <Border BorderBrush="{DynamicResource RibbonKit.Brushes.Control.InnerGlow}"
                                    BorderThickness="0,1,1,1" />
                        </Border>

                        <!-- The hairline between the halves: a light line then a dark one, in that
                             order left-to-right (sampled #FFF2C8 then #DBC17A). It sits INSIDE the
                             dimmable main fill's neighbour, so it dims with the arrow half staying
                             lit — matching the capture. -->
                        <StackPanel x:Name="SplitLine"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,1"
                                    Visibility="Collapsed">
                            <Rectangle Width="1" Fill="{DynamicResource RibbonKit.Brushes.Control.InnerGlow}" />
                            <Rectangle Width="1" Fill="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                        </StackPanel>

                        <!-- The outline spans both halves and NEVER dims — measured identical in the
                             fully-hovered and the half-lit states. -->
                        <Border x:Name="Outline"
                                Grid.ColumnSpan="2"
                                Opacity="0"
                                IsHitTestVisible="False"
                                BorderBrush="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}" />

                        <Button x:Name="PART_Primary"
                                Grid.Column="0"
                                Style="{StaticResource RibbonKit.ApplicationMenuHitArea}">
                            <Grid Margin="8,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="{TemplateBinding Icon}"
                                       Width="32"
                                       Height="32"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Focusable=False: two tab stops per row would double the length of the
                             keyboard walk down the column for a control that hover already drives. -->
                        <Button x:Name="PART_Arrow"
                                Grid.Column="1"
                                Focusable="False"
                                Width="{DynamicResource RibbonKit.Metrics.ApplicationMenuArrowWidth}"
                                Style="{StaticResource RibbonKit.ApplicationMenuHitArea}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Path Data="M0,0 L4.5,4.5 L0,9 Z"
                                  Fill="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                        </Button>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- No pane: no arrow half at all, and the Auto column collapses to zero so
                             the command half runs the full width of the row. -->
                        <Trigger Property="HasPane" Value="False">
                            <Setter TargetName="ArrowFill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Arrow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsSplitPresentation" Value="True">
                            <Setter TargetName="SplitLine" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- ACTIVE (this row's pane is on show). Everything lights up... -->
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Outline" Property="Opacity" Value="1" />
                            <Setter TargetName="MainFill" Property="Opacity" Value="1" />
                            <Setter TargetName="ArrowFill" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- ...except on a SPLIT row, where the command half drops to a third while
                             the arrow half stays fully lit. A plain drop-down row keeps both lit,
                             because it has no separate command to look inactive. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive" Value="True" />
                                <Condition Property="IsSplitPresentation" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="MainFill" Property="Opacity"
                                    Value="{DynamicResource RibbonKit.Metrics.ApplicationMenuDimOpacity}" />
                        </MultiTrigger>

                        <!-- HOVER goes AFTER active so it wins: pointing at the row always shows the
                             full gold on both halves, whatever the pane is doing. Same last-setter-
                             wins ordering rule the application button's triggers depend on. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="Opacity" Value="1" />
                            <Setter TargetName="MainFill" Property="Opacity" Value="1" />
                            <Setter TargetName="ArrowFill" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- PRESSED last of all, for the same reason. -->
                        <Trigger SourceName="PART_Primary" Property="IsPressed" Value="True">
                            <Setter TargetName="MainFill" Property="Opacity" Value="1" />
                            <Setter TargetName="MainFill" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                            <Setter TargetName="Outline" Property="Opacity" Value="1" />
                            <Setter TargetName="Outline" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}" />
                        </Trigger>
                        <Trigger SourceName="PART_Arrow" Property="IsPressed" Value="True">
                            <Setter TargetName="ArrowFill" Property="Opacity" Value="1" />
                            <Setter TargetName="ArrowFill" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                            <Setter TargetName="Outline" Property="Opacity" Value="1" />
                            <Setter TargetName="Outline" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonApplicationMenuSeparator — a group divider in the nav column

         Its own type rather than the stock Separator on purpose. A style for Separator would have
         to reach the containers through resource LOOKUP, and there is no scope that works: an
         implicit style at file level would restyle every separator in the consuming app, and one
         scoped to the menu cannot be installed — FrameworkElement.Resources is a plain CLR
         property, so no Style Setter can assign it. A dedicated type gets its default style
         through Generic.xaml like every other control here, with no lookup at all.
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonApplicationMenuSeparator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonApplicationMenuSeparator}">
                    <StackPanel Orientation="Vertical" SnapsToDevicePixels="True">
                        <Rectangle Height="1"
                                   Fill="{DynamicResource RibbonKit.Brushes.ApplicationMenu.Separator}" />
                        <Rectangle Height="1"
                                   Fill="{DynamicResource RibbonKit.Brushes.ApplicationMenu.SeparatorHighlight}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonApplicationMenuPaneItem — a row inside the right pane
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonApplicationMenuPaneItem}">
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonApplicationMenuPaneItem}">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="Glyph"
                                   Grid.Column="0"
                                   Source="{TemplateBinding Icon}"
                                   Width="32"
                                   Height="32"
                                   Stretch="Uniform"
                                   VerticalAlignment="Top" />
                            <StackPanel x:Name="TextStack" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <ContentPresenter x:Name="HeaderText"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                <TextBlock x:Name="DescriptionText"
                                           Text="{TemplateBinding Description}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- No description: this is a one-line row — a recent document, not a
                             command — so it drops the bold too. Office 2007's recent list is plain. -->
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderText" Property="TextElement.FontWeight" Value="Normal" />
                            <Setter TargetName="HeaderText" Property="TextElement.Foreground"
                                    Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                        </Trigger>
                        <!-- No icon: reclaim the 32px column entirely rather than leaving a hole. -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TextStack" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonApplicationMenuButton — the footer bar's buttons
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonApplicationMenuButton}">
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="MinWidth" Value="94" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonApplicationMenuButton}">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource RibbonKit.Brushes.ApplicationMenu.ButtonBackground}"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.ApplicationMenu.ButtonBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image x:Name="Glyph"
                                   Source="{TemplateBinding Icon}"
                                   Width="16"
                                   Height="16"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonApplicationMenu — the two-pane drop-down itself
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonApplicationMenu}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" IsItemsHost="True" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonApplicationMenu}">
                    <!-- PART_Frame carries NO chrome of its own. RibbonMotion.PlayFlyoutOpen fades
                         the surface it is handed and slides that surface's CHILD, so making the
                         invisible wrapper the surface lets the whole visible menu glide in while the
                         wrapper stays put. Painting the border here instead would have slid the
                         menu's insides against their own frame. (§3.42.) -->
                    <Border x:Name="PART_Frame" Background="Transparent">
                        <Border x:Name="Frame"
                                Background="{DynamicResource RibbonKit.Brushes.ApplicationMenu.FrameBand}"
                                BorderBrush="{DynamicResource RibbonKit.Brushes.ApplicationMenu.FrameBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RibbonKit.Metrics.ApplicationMenuCornerRadius}"
                                Effect="{DynamicResource RibbonKit.Effects.ApplicationMenuShadow}"
                                SnapsToDevicePixels="True">
                            <Border BorderBrush="{DynamicResource RibbonKit.Brushes.ApplicationMenu.FrameRim}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource RibbonKit.Metrics.ApplicationMenuInnerCornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top glass band. Taller than the 3px sides because the orb
                                         sits half inside it — that is what it is FOR. -->
                                    <Border x:Name="TopBand"
                                            Grid.Row="0"
                                            Height="{DynamicResource RibbonKit.Metrics.ApplicationMenuTopBandHeight}"
                                            CornerRadius="{DynamicResource RibbonKit.Metrics.ApplicationMenuTopBandCornerRadius}"
                                            Background="{DynamicResource RibbonKit.Brushes.ApplicationMenu.TopBandBackground}" />

                                    <Border Grid.Row="1"
                                            Margin="3,0,3,0"
                                            BorderBrush="{DynamicResource RibbonKit.Brushes.ApplicationMenu.FrameRim}"
                                            BorderThickness="1">
                                        <Border BorderBrush="{DynamicResource RibbonKit.Brushes.ApplicationMenu.FrameBorder}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="{DynamicResource RibbonKit.Metrics.ApplicationMenuNavWidth}"
                                                        Background="{DynamicResource RibbonKit.Brushes.ApplicationMenu.NavBackground}">
                                                    <ItemsPresenter />
                                                </Border>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" SnapsToDevicePixels="True">
                                                    <Rectangle Width="1"
                                                               Fill="{DynamicResource RibbonKit.Brushes.ApplicationMenu.Separator}" />
                                                    <Rectangle Width="1"
                                                               Fill="{DynamicResource RibbonKit.Brushes.ApplicationMenu.SeparatorHighlight}" />
                                                </StackPanel>

                                                <!-- PART_Pane. The control reads IsMouseOver off this
                                                     element to decide whether to LATCH the active
                                                     item, so the name matters to the code, not just
                                                     to the eye. -->
                                                <Border x:Name="PART_Pane"
                                                        Grid.Column="2"
                                                        Width="{DynamicResource RibbonKit.Metrics.ApplicationMenuPaneWidth}"
                                                        Background="{DynamicResource RibbonKit.Brushes.ApplicationMenu.PaneBackground}">
                                                    <Grid>
                                                        <!-- The DEFAULT page renders BARE — no frame,
                                                             no header band — which is how Office 2007
                                                             draws Recent Documents. Its heading is
                                                             part of the content. -->
                                                        <ContentPresenter x:Name="DefaultPage"
                                                                          Content="{TemplateBinding DefaultContent}"
                                                                          Margin="10,8,10,10" />

                                                        <!-- A nav item's page is FRAMED and gets the
                                                             shaded header band. -->
                                                        <Border x:Name="ActivePage"
                                                                Visibility="Collapsed"
                                                                Margin="0,0,2,2"
                                                                Background="{DynamicResource RibbonKit.Brushes.ApplicationMenu.PaneSurface}"
                                                                BorderBrush="{DynamicResource RibbonKit.Brushes.ApplicationMenu.PaneBorder}"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <Border x:Name="HeaderBand"
                                                                        Grid.Row="0"
                                                                        Padding="10,5"
                                                                        Background="{DynamicResource RibbonKit.Brushes.ApplicationMenu.HeaderBackground}"
                                                                        BorderBrush="{DynamicResource RibbonKit.Brushes.ApplicationMenu.Separator}"
                                                                        BorderThickness="0,0,0,1">
                                                                    <TextBlock Text="{TemplateBinding ActivePaneHeader}"
                                                                               FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                                                                </Border>
                                                                <!-- Shows the ACTIVE ITEM's Content.
                                                                     The item is that content's
                                                                     LOGICAL parent and never presents
                                                                     it itself, so this presenter is
                                                                     free to be its visual host —
                                                                     the same split TabControl uses
                                                                     for a TabItem's content. -->
                                                                <ContentPresenter Grid.Row="1"
                                                                                  Content="{TemplateBinding ActivePaneContent}"
                                                                                  Margin="4" />
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <!-- Footer bar. It IS the frame's bottom band — there is no
                                         separate border between the two, which is why it is a row of
                                         this grid and not a child of the content frame. -->
                                    <Border x:Name="FooterBand"
                                            Grid.Row="2"
                                            Height="{DynamicResource RibbonKit.Metrics.ApplicationMenuFooterHeight}"
                                            CornerRadius="{DynamicResource RibbonKit.Metrics.ApplicationMenuFooterCornerRadius}"
                                            Background="{DynamicResource RibbonKit.Brushes.ApplicationMenu.FooterBackground}">
                                        <ContentPresenter Content="{TemplateBinding FooterContent}"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasActivePane" Value="True">
                            <Setter TargetName="DefaultPage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ActivePage" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- An item with pane content but no PaneHeader gets the frame without the
                             band, so a page that wants to draw its own heading still can. -->
                        <Trigger Property="ActivePaneHeader" Value="{x:Null}">
                            <Setter TargetName="HeaderBand" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ActivePaneHeader" Value="">
                            <Setter TargetName="HeaderBand" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
