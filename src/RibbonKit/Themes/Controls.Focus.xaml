<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WPF shows this adorner for keyboard navigation only. Keep it inside the action's
         bounds so popup clipping and adjoining split halves do not cut the ring off.
         Existing input-focus and corner tokens follow the active palette and accent. -->
    <Style x:Key="RibbonKit.KeyboardFocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border Margin="2"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.Input.FocusBorder}"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
