<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls">

    <!-- WPF owns keyboard-only display. The tracker places an inset vector contour
         against the realized template surface, including its corners and transforms. -->
    <Style x:Key="RibbonKit.KeyboardFocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Canvas FlowDirection="LeftToRight" UseLayoutRounding="False" IsHitTestVisible="False">
                        <Border controls:FocusVisualTracking.Enabled="True"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource RibbonKit.Brushes.Input.FocusBorder}"
                                CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                                SnapsToDevicePixels="True" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonKit.CircularKeyboardFocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Canvas FlowDirection="LeftToRight" UseLayoutRounding="False" IsHitTestVisible="False">
                        <Ellipse x:Name="FocusRing"
                                 controls:FocusVisualTracking.Enabled="True"
                                 StrokeThickness="1"
                                 Stroke="{DynamicResource RibbonKit.Brushes.Input.FocusBorder}"
                                 SnapsToDevicePixels="True" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same contour measures the orb's visible sphere, including caption overhang. -->
    <Style x:Key="RibbonKit.ApplicationOrbKeyboardFocusVisual" TargetType="{x:Type Control}"
           BasedOn="{StaticResource RibbonKit.CircularKeyboardFocusVisual}" />
</ResourceDictionary>
