<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls">

    <!-- WPF shows this adorner for keyboard navigation only. Keep it inside the action's
         bounds so popup clipping and adjoining split halves do not cut the ring off.
         Existing input-focus and corner tokens follow the active palette and accent. -->
    <Style x:Key="RibbonKit.KeyboardFocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border controls:FocusVisualTracking.Enabled="True"
                            Margin="2"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.Input.FocusBorder}"
                            CornerRadius="{DynamicResource RibbonKit.Metrics.ControlCornerRadius}"
                            SnapsToDevicePixels="True"
                            IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonKit.CircularKeyboardFocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Ellipse x:Name="FocusRing"
                             controls:FocusVisualTracking.Enabled="True"
                             Margin="2" StrokeThickness="1"
                             Stroke="{DynamicResource RibbonKit.Brushes.Input.FocusBorder}"
                             SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mirror ApplicationOrbChrome's sphere layout, including its caption overhang.
         The button's tab-row slot is shorter than the circle it paints. -->
    <Style x:Key="RibbonKit.ApplicationOrbKeyboardFocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid Width="{DynamicResource RibbonKit.Metrics.ApplicationOrbSize}"
                          Height="{DynamicResource RibbonKit.Metrics.ApplicationOrbSize}"
                          Margin="{DynamicResource RibbonKit.Metrics.ApplicationOrbMargin}"
                          VerticalAlignment="Top">
                        <Ellipse x:Name="FocusRing"
                                 controls:FocusVisualTracking.Enabled="True"
                                 Margin="2" StrokeThickness="1"
                                 Stroke="{DynamicResource RibbonKit.Brushes.Input.FocusBorder}"
                                 SnapsToDevicePixels="True" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
