<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls">

    <!-- Shared scrollbar chrome. The keyed base style can also be applied locally to
         the native ScrollBars generated by a ScrollViewer template. -->
    <Style x:Key="RibbonKit.ScrollBarArrowButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.ButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.ButtonBorder}" />
        <Setter Property="BorderThickness"
                Value="{DynamicResource RibbonKit.Metrics.ControlHighlightBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.Glyph}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(controls:RibbonScrollBar.ButtonCornerRadius), RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonKit.ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonKit.ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.Thumb}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.ThumbBorder}" />
        <Setter Property="BorderThickness" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.ThumbBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Pill"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(controls:RibbonScrollBar.ThumbCornerRadius), RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.ScrollBar.ThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource RibbonKit.Brushes.ScrollBar.ThumbPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonKit.VerticalScrollBarThumbStyle"
           TargetType="{x:Type Thumb}"
           BasedOn="{StaticResource RibbonKit.ScrollBarThumbStyle}" />

    <Style x:Key="RibbonKit.HorizontalScrollBarThumbStyle"
           TargetType="{x:Type Thumb}"
           BasedOn="{StaticResource RibbonKit.ScrollBarThumbStyle}" />

    <ControlTemplate x:Key="RibbonKit.VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Border x:Name="Root"
                Background="{DynamicResource RibbonKit.Brushes.ScrollBar.Track}"
                CornerRadius="{Binding Path=(controls:RibbonScrollBar.RailCornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
          <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <RepeatButton x:Name="DecreaseButton"
                          Grid.Row="0"
                          Height="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}"
                          Command="{x:Static ScrollBar.LineUpCommand}"
                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                          Style="{StaticResource RibbonKit.ScrollBarArrowButtonStyle}">
                <Path Width="7"
                      Height="4"
                      Data="M0,4 L3.5,0 L7,4"
                      Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                      StrokeThickness="1.25"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
            </RepeatButton>

            <controls:RibbonScrollBarTrack x:Name="PART_Track"
                                           Grid.Row="1"
                                           IsDirectionReversed="True"
                                           MinimumThumbLength="{DynamicResource RibbonKit.Metrics.ScrollBar.MinThumbLength}"
                                           Orientation="Vertical">
                <controls:RibbonScrollBarTrack.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource RibbonKit.ScrollBarPageButtonStyle}" />
                </controls:RibbonScrollBarTrack.DecreaseRepeatButton>
                <controls:RibbonScrollBarTrack.Thumb>
                    <Thumb x:Name="Thumb"
                           Style="{StaticResource RibbonKit.VerticalScrollBarThumbStyle}" />
                </controls:RibbonScrollBarTrack.Thumb>
                <controls:RibbonScrollBarTrack.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource RibbonKit.ScrollBarPageButtonStyle}" />
                </controls:RibbonScrollBarTrack.IncreaseRepeatButton>
            </controls:RibbonScrollBarTrack>

            <RepeatButton x:Name="IncreaseButton"
                          Grid.Row="2"
                          Height="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}"
                          Command="{x:Static ScrollBar.LineDownCommand}"
                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                          Style="{StaticResource RibbonKit.ScrollBarArrowButtonStyle}">
                <Path Width="7"
                      Height="4"
                      Data="M0,0 L3.5,4 L7,0"
                      Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                      StrokeThickness="1.25"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
            </RepeatButton>

          </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" />
                <Setter TargetName="DecreaseButton" Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter TargetName="IncreaseButton" Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter TargetName="Thumb" Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="RibbonKit.HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Border x:Name="Root"
                Background="{DynamicResource RibbonKit.Brushes.ScrollBar.Track}"
                CornerRadius="{Binding Path=(controls:RibbonScrollBar.RailCornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <RepeatButton x:Name="DecreaseButton"
                          Grid.Column="0"
                          Width="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}"
                          Command="{x:Static ScrollBar.LineLeftCommand}"
                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                          Style="{StaticResource RibbonKit.ScrollBarArrowButtonStyle}">
                <Path Width="4"
                      Height="7"
                      Data="M4,0 L0,3.5 L4,7"
                      Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                      StrokeThickness="1.25"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
            </RepeatButton>

            <controls:RibbonScrollBarTrack x:Name="PART_Track"
                                           Grid.Column="1"
                                           IsDirectionReversed="False"
                                           MinimumThumbLength="{DynamicResource RibbonKit.Metrics.ScrollBar.MinThumbLength}"
                                           Orientation="Horizontal">
                <controls:RibbonScrollBarTrack.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource RibbonKit.ScrollBarPageButtonStyle}" />
                </controls:RibbonScrollBarTrack.DecreaseRepeatButton>
                <controls:RibbonScrollBarTrack.Thumb>
                    <Thumb x:Name="Thumb"
                           Style="{StaticResource RibbonKit.HorizontalScrollBarThumbStyle}" />
                </controls:RibbonScrollBarTrack.Thumb>
                <controls:RibbonScrollBarTrack.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource RibbonKit.ScrollBarPageButtonStyle}" />
                </controls:RibbonScrollBarTrack.IncreaseRepeatButton>
            </controls:RibbonScrollBarTrack>

            <RepeatButton x:Name="IncreaseButton"
                          Grid.Column="2"
                          Width="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}"
                          Command="{x:Static ScrollBar.LineRightCommand}"
                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                          Style="{StaticResource RibbonKit.ScrollBarArrowButtonStyle}">
                <Path Width="4"
                      Height="7"
                      Data="M0,0 L4,3.5 L0,7"
                      Stretch="Fill"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                      StrokeThickness="1.25"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
            </RepeatButton>

          </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.ScrollBarBrushKey}}" />
                <Setter TargetName="DecreaseButton" Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter TargetName="IncreaseButton" Property="Foreground"
                        Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter TargetName="Thumb" Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RibbonKit.ScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.Glyph}" />
        <Setter Property="Width" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
        <Setter Property="MinWidth" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
        <Setter Property="controls:RibbonScrollBar.ButtonCornerRadius"
                Value="{DynamicResource RibbonKit.Metrics.ScrollBar.ButtonCornerRadius}" />
        <Setter Property="controls:RibbonScrollBar.ThumbCornerRadius"
                Value="{DynamicResource RibbonKit.Metrics.ScrollBar.ThumbCornerRadius}" />
        <Setter Property="controls:RibbonScrollBar.RailCornerRadius"
                Value="{DynamicResource RibbonKit.Metrics.ScrollBar.RailCornerRadius}" />
        <Setter Property="Template" Value="{StaticResource RibbonKit.VerticalScrollBarTemplate}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
                <Setter Property="MinHeight" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
                <Setter Property="Template" Value="{StaticResource RibbonKit.HorizontalScrollBarTemplate}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:RibbonScrollBar}"
           BasedOn="{StaticResource RibbonKit.ScrollBarStyle}" />
</ResourceDictionary>
