<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls"
    xmlns:localization="clr-namespace:RibbonKit.Localization"
    xmlns:layout="clr-namespace:RibbonKit.Layout">

    <!-- Part of the shared RibbonKit control-template dictionary; merged by Office2024.xaml.
         RibbonQuickAccessPage, RibbonCustomizePage, RibbonCustomizeEditDialog.
         Colours/metrics come from Tokens.Office20XX.xaml via {DynamicResource}. -->

    <!-- MUST merge Controls.OptionsDialog.xaml locally: a StaticResource inside a merged
         dictionary does NOT resolve against SIBLING dictionaries merged by the same
         parent, only against this dictionary and the ones IT merges. OptionsDialogActionButtonStyle, OptionsDialogReorderButtonStyle,
         OptionsDialogPrimaryButtonStyle and OptionsDialogCloseButtonStyle are used by
         StaticResource below.
         (Also listed in Office2024.xaml; WPF caches dictionaries by Source URI.) -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.OptionsDialog.xaml" />
        <!-- Imported locally because the generated ListBox/TreeView ScrollBars live inside
             deferred templates and cannot resolve an aggregator-sibling StaticResource. -->
        <ResourceDictionary Source="/RibbonKit;component/Themes/Controls.ScrollBars.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Pilot adapter for the Customize Ribbon page only. Keep it local rather than placing an
         implicit ScrollBar style at dictionary/dialog scope: the QAT page and app-owned options
         pages must remain unchanged until the visual comparison is accepted. -->
    <Style x:Key="RibbonKit.CustomizePageScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.ScrollBar.Glyph}" />
        <Setter Property="Width" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
        <Setter Property="MinWidth" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
        <Setter Property="controls:RibbonScrollBar.ButtonCornerRadius"
                Value="{DynamicResource RibbonKit.Metrics.ScrollBar.ButtonCornerRadius}" />
        <Setter Property="controls:RibbonScrollBar.ThumbCornerRadius"
                Value="{DynamicResource RibbonKit.Metrics.ScrollBar.ThumbCornerRadius}" />
        <Setter Property="controls:RibbonScrollBar.RailCornerRadius"
                Value="{DynamicResource RibbonKit.Metrics.ScrollBar.RailCornerRadius}" />
        <Setter Property="Template" Value="{StaticResource RibbonKit.VerticalScrollBarTemplate}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
                <Setter Property="MinHeight" Value="{DynamicResource RibbonKit.Metrics.ScrollBar.Thickness}" />
                <Setter Property="Template" Value="{StaticResource RibbonKit.HorizontalScrollBarTemplate}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Shared row and frame templates for both built-in customization pages. Theme
         tokens select the curvature and materials; the native item presenters and
         ScrollViewer remain in place for virtualization and keyboard scrolling. -->
    <ControlTemplate x:Key="RibbonKit.Customize.ListFrameTemplate" TargetType="{x:Type Control}">
        <Border x:Name="Frame"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="{DynamicResource RibbonKit.Metrics.Customize.FrameCornerRadius}"
                SnapsToDevicePixels="True">
            <Border Padding="{DynamicResource RibbonKit.Metrics.Customize.FrameInset}">
                <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ScrollViewer>
            </Border>
        </Border>
    </ControlTemplate>

    <Style x:Key="RibbonKit.Customize.RowStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{DynamicResource RibbonKit.Metrics.Customize.RowCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="RibbonKit.Customize.ListItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="Padding" Value="{DynamicResource RibbonKit.Metrics.Customize.ListItemPadding}" />
        <Setter Property="Margin" Value="{DynamicResource RibbonKit.Metrics.Customize.ListItemMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Row" Style="{StaticResource RibbonKit.Customize.RowStyle}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.CheckedBackground}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Customize.SelectedBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="RibbonKit.Customize.TreeItemTemplate" TargetType="{x:Type TreeViewItem}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ToggleButton x:Name="Expander" Width="16" Height="20" Focusable="False"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8" StrokeThickness="1.3"
                                  Stroke="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <Border x:Name="Row" Grid.Column="1" Style="{StaticResource RibbonKit.Customize.RowStyle}"
                    Padding="4,3" Margin="0,1,2,1">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger>
            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Control.HoverBorder}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.CheckedBackground}" />
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Customize.SelectedBorder}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.Accent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RibbonKit.Customize.TreeContainerStyle" TargetType="{x:Type TreeViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Template" Value="{StaticResource RibbonKit.Customize.TreeItemTemplate}" />
    </Style>

    <!-- ============================================================
         RibbonQuickAccessPage — the built-in QAT customization page:
         available ribbon commands | Add/Remove/Up/Down | current QAT
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonQuickAccessPage}">
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <!-- The page fills the content area because it is an IRibbonFillPage: the dialog hosts
             it in a ScrollViewer with vertical scroll DISABLED, which constrains it to the
             viewport height (a Stretch Control then fills). No explicit Height/MaxHeight needed —
             its own two ListBoxes scroll internally. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonQuickAccessPage}">
                    <ControlTemplate.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource RibbonKit.CustomizePageScrollBarStyle}" />

                        <!-- Shared 16px-icon + caption row for both lists -->
                        <DataTemplate x:Key="CommandEntryTemplate">
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <Image Source="{Binding Icon}"
                                       Width="16" Height="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0"
                                   Text="{localization:RibbonString Key=ChooseCommandsFromRibbon}"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                   FontSize="12"
                                   Margin="0,0,0,6" />
                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   Text="{localization:RibbonString Key=CurrentQuickAccessToolbar}"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                   FontSize="12"
                                   Margin="0,0,0,6" />

                        <ListBox x:Name="PART_AvailableList"
                                 Grid.Column="0" Grid.Row="1"
                                 Template="{StaticResource RibbonKit.Customize.ListFrameTemplate}"
                                 ItemContainerStyle="{StaticResource RibbonKit.Customize.ListItemStyle}"
                                 Foreground="{TemplateBinding Foreground}"
                                 Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                 BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.Border}"
                                 BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource CommandEntryTemplate}" />

                        <!-- Add / Remove between the two lists (like the Customize Ribbon page). -->
                        <StackPanel Grid.Column="1" Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0">
                            <Button x:Name="PART_AddButton"
                                    Style="{StaticResource OptionsDialogActionButtonStyle}"
                                    Margin="0,0,0,6">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AddActionLabel"
                                               Text="{localization:RibbonString Key=Add}" />
                                    <TextBlock x:Name="AddActionArrow"
                                               Grid.Column="1"
                                               Text="»"
                                               Margin="4,0,0,0" />
                                </Grid>
                            </Button>
                            <Button x:Name="PART_RemoveButton"
                                    Style="{StaticResource OptionsDialogActionButtonStyle}">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RemoveActionArrow"
                                               Text="«"
                                               Margin="0,0,4,0" />
                                    <TextBlock x:Name="RemoveActionLabel"
                                               Grid.Column="1"
                                               Text="{localization:RibbonString Key=Remove}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <ListBox x:Name="PART_CurrentList"
                                 Grid.Column="2" Grid.Row="1"
                                 Template="{StaticResource RibbonKit.Customize.ListFrameTemplate}"
                                 ItemContainerStyle="{StaticResource RibbonKit.Customize.ListItemStyle}"
                                 Foreground="{TemplateBinding Foreground}"
                                 Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                 BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.Border}"
                                 BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource CommandEntryTemplate}" />

                        <!-- Up / Down to the RIGHT of the current list, mirroring the ribbon
                             page — icon-only reorder buttons. -->
                        <StackPanel Grid.Column="3" Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button x:Name="PART_UpButton"
                                    Content="▲"
                                    Style="{StaticResource OptionsDialogReorderButtonStyle}"
                                    ToolTip="{localization:RibbonString Key=MoveUp}"
                                    Margin="0,0,0,6" />
                            <Button x:Name="PART_DownButton"
                                    Content="▼"
                                    Style="{StaticResource OptionsDialogReorderButtonStyle}"
                                    ToolTip="{localization:RibbonString Key=MoveDown}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter TargetName="AddActionLabel" Property="Grid.Column" Value="1" />
                            <Setter TargetName="AddActionArrow" Property="Grid.Column" Value="0" />
                            <Setter TargetName="AddActionArrow" Property="Text" Value="«" />
                            <Setter TargetName="AddActionArrow" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="RemoveActionLabel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="RemoveActionArrow" Property="Grid.Column" Value="1" />
                            <Setter TargetName="RemoveActionArrow" Property="Text" Value="»" />
                            <Setter TargetName="RemoveActionArrow" Property="Margin" Value="4,0,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonCustomizePage — the built-in "Customize the Ribbon"
         page: available commands | Add/Remove | structure tree (tabs
         → groups → commands, checkbox = tab visibility) | Up/Down,
         with New Tab / New Group / Rename below the tree
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonCustomizePage}">
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="MinHeight" Value="240" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonCustomizePage}">
                    <ControlTemplate.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource RibbonKit.CustomizePageScrollBarStyle}" />

                        <!-- Left list rows: 16px icon + "Tab › Group › Command" caption -->
                        <DataTemplate x:Key="CustomizeCommandEntryTemplate">
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <Image Source="{Binding Icon}"
                                       Width="16" Height="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>

                        <!-- Tree rows: visibility checkbox (tabs only) + optional icon + caption -->
                        <HierarchicalDataTemplate DataType="{x:Type controls:RibbonCustomizeNode}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <CheckBox IsChecked="{Binding IsVisibleChecked, Mode=TwoWay}"
                                          Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVisibility}}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"
                                          Focusable="False" />
                                <Image Source="{Binding Icon}"
                                       Width="16" Height="16"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Style.Triggers>
                                                <!-- No icon → no reserved gap (tab captions
                                                     would indent for nothing). -->
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding Header}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </ControlTemplate.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0"
                                   Text="{localization:RibbonString Key=ChooseCommandsFromRibbon}"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                   FontSize="12"
                                   Margin="0,0,0,6" />
                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   Text="{localization:RibbonString Key=CustomizeRibbonLabel}"
                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}"
                                   FontSize="12"
                                   Margin="0,0,0,6" />

                        <ListBox x:Name="PART_AvailableList"
                                 Grid.Column="0" Grid.Row="1"
                                 Template="{StaticResource RibbonKit.Customize.ListFrameTemplate}"
                                 ItemContainerStyle="{StaticResource RibbonKit.Customize.ListItemStyle}"
                                 Foreground="{TemplateBinding Foreground}"
                                 Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                 BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.Border}"
                                 BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource CustomizeCommandEntryTemplate}" />

                        <StackPanel Grid.Column="1" Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0">
                            <Button x:Name="PART_AddButton"
                                    Style="{StaticResource OptionsDialogActionButtonStyle}"
                                    Margin="0,0,0,6">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AddActionLabel"
                                               Text="{localization:RibbonString Key=Add}" />
                                    <TextBlock x:Name="AddActionArrow"
                                               Grid.Column="1"
                                               Text="»"
                                               Margin="4,0,0,0" />
                                </Grid>
                            </Button>
                            <Button x:Name="PART_RemoveButton"
                                    Style="{StaticResource OptionsDialogActionButtonStyle}">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RemoveActionArrow"
                                               Text="«"
                                               Margin="0,0,4,0" />
                                    <TextBlock x:Name="RemoveActionLabel"
                                               Grid.Column="1"
                                               Text="{localization:RibbonString Key=Remove}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <TreeView x:Name="PART_Tree"
                                  Grid.Column="2" Grid.Row="1"
                                  Template="{StaticResource RibbonKit.Customize.ListFrameTemplate}"
                                  ItemContainerStyle="{StaticResource RibbonKit.Customize.TreeContainerStyle}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                  BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.Border}"
                                  BorderThickness="1"
                                  Padding="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.Resources>
                                <!-- Child containers use the same state and geometry as roots. -->
                                <Style TargetType="{x:Type TreeViewItem}"
                                       BasedOn="{StaticResource RibbonKit.Customize.TreeContainerStyle}" />
                            </TreeView.Resources>
                        </TreeView>

                        <StackPanel Grid.Column="3" Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button x:Name="PART_UpButton"
                                    Content="▲"
                                    Style="{StaticResource OptionsDialogReorderButtonStyle}"
                                    ToolTip="{localization:RibbonString Key=MoveUp}"
                                    Margin="0,0,0,6" />
                            <Button x:Name="PART_DownButton"
                                    Content="▼"
                                    Style="{StaticResource OptionsDialogReorderButtonStyle}"
                                    ToolTip="{localization:RibbonString Key=MoveDown}" />
                        </StackPanel>

                        <!-- Reset restores the host-supplied baseline (factory ribbon),
                             discarding all customizations. Import/Export round-trip the current
                             layout to a JSON file. Bottom-left, like Office. -->
                        <StackPanel Grid.Column="0" Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0">
                            <Button x:Name="PART_ResetButton"
                                    Content="{localization:RibbonString Key=Reset}"
                                    Style="{StaticResource OptionsDialogActionButtonStyle}"
                                    Margin="0,0,6,0" />
                            <!-- Import/Export are icon-only (compact reorder-button style) so all
                                 three actions fit Column 0 without widening the dialog; the ToolTip
                                 carries the meaning. Glyphs: OpenFile (load) and Save (write). -->
                            <Button x:Name="PART_ImportButton"
                                    Style="{StaticResource OptionsDialogReorderButtonStyle}"
                                    ToolTip="{localization:RibbonString Key=ImportRibbonLayoutTooltip}"
                                    AutomationProperties.Name="{localization:RibbonString Key=Import}"
                                    Margin="0,0,6,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE8E5;" />
                            </Button>
                            <Button x:Name="PART_ExportButton"
                                    Style="{StaticResource OptionsDialogReorderButtonStyle}"
                                    ToolTip="{localization:RibbonString Key=ExportRibbonLayoutTooltip}"
                                    AutomationProperties.Name="{localization:RibbonString Key=Export}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE74E;" />
                            </Button>
                        </StackPanel>

                        <!-- Structure tools, under the tree like Office. Edit… opens the
                             per-target dialog (name / icon / layout / size). -->
                        <Grid Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_NewTabButton"
                                    Grid.Column="0"
                                    Content="{localization:RibbonString Key=NewTab}"
                                    Style="{StaticResource OptionsDialogActionButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button x:Name="PART_NewGroupButton"
                                    Grid.Column="1"
                                    Content="{localization:RibbonString Key=NewGroup}"
                                    Style="{StaticResource OptionsDialogActionButtonStyle}" />
                            <Button x:Name="PART_EditButton"
                                    Grid.Column="3"
                                    Content="{localization:RibbonString Key=Edit}"
                                    Style="{StaticResource OptionsDialogActionButtonStyle}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter TargetName="AddActionLabel" Property="Grid.Column" Value="1" />
                            <Setter TargetName="AddActionArrow" Property="Grid.Column" Value="0" />
                            <Setter TargetName="AddActionArrow" Property="Text" Value="«" />
                            <Setter TargetName="AddActionArrow" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="RemoveActionLabel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="RemoveActionArrow" Property="Grid.Column" Value="1" />
                            <Setter TargetName="RemoveActionArrow" Property="Text" Value="»" />
                            <Setter TargetName="RemoveActionArrow" Property="Margin" Value="4,0,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         RibbonCustomizeEditDialog — the small per-target edit modal
         opened by the customize page's Edit… button: name (always),
         icon + layout (custom groups), size (custom-group commands).
         Same chrome recipe as the options dialog (custom white title
         bar, close-only, DWM rounded corners from code).
         ============================================================ -->
    <Style TargetType="{x:Type controls:RibbonCustomizeEditDialog}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="34"
                              GlassFrameThickness="0"
                              ResizeBorderThickness="0"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonCustomizeEditDialog}">
                    <ControlTemplate.Resources>
                        <Style x:Key="EditDialogLabelStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Secondary}" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ControlTemplate.Resources>
                    <AdornerDecorator>
                        <Border Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Title bar: Title left (no icon), Close only -->
                                <Grid Grid.Row="0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{TemplateBinding Title}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                    <Button x:Name="PART_CloseButton"
                                            Grid.Column="1"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            Style="{StaticResource OptionsDialogCloseButtonStyle}"
                                            ToolTip="{localization:RibbonString Key=Close}" />
                                </Grid>

                                <!-- Sections; the control collapses the ones that don't
                                     apply to the current target. -->
                                <StackPanel Grid.Row="1" Margin="16,8,16,4">
                                    <TextBlock Text="{localization:RibbonString Key=NameLabel}"
                                               Style="{StaticResource EditDialogLabelStyle}" />
                                    <TextBox x:Name="PART_NameBox"
                                             VerticalContentAlignment="Center"
                                             Padding="6,5"
                                             Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                             BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.Border}"
                                             Foreground="{DynamicResource RibbonKit.Brushes.Text.Primary}"
                                             Margin="0,0,0,12" />

                                    <StackPanel x:Name="PART_IconSection" Margin="0,0,0,12">
                                        <TextBlock Text="{localization:RibbonString Key=IconFromRibbonCommandsLabel}"
                                                   Style="{StaticResource EditDialogLabelStyle}" />
                                        <ListBox x:Name="PART_IconList"
                                                 MaxHeight="150"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 Background="{DynamicResource RibbonKit.Brushes.Ribbon.ContentBackground}"
                                                 BorderBrush="{DynamicResource RibbonKit.Brushes.ScreenTip.Border}"
                                                 BorderThickness="1"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="36" Height="36">
                                                        <Image Source="{Binding Icon}"
                                                               Width="20" Height="20"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{localization:RibbonString Key=None}"
                                                                   FontSize="10"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource RibbonKit.Brushes.Text.Secondary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNone}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <StackPanel x:Name="PART_LayoutSection" Margin="0,0,0,12">
                                        <TextBlock Text="{localization:RibbonString Key=GroupLayoutLabel}"
                                                   Style="{StaticResource EditDialogLabelStyle}" />
                                        <ComboBox x:Name="PART_LayoutBox" />
                                    </StackPanel>

                                    <StackPanel x:Name="PART_SizeSection" Margin="0,0,0,12">
                                        <TextBlock Text="{localization:RibbonString Key=ButtonSizeLabel}"
                                                   Style="{StaticResource EditDialogLabelStyle}" />
                                        <ComboBox x:Name="PART_SizeBox" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action buttons -->
                                <Border Grid.Row="2"
                                        BorderBrush="{DynamicResource RibbonKit.Brushes.Ribbon.Border}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="16,10,16,10">
                                        <Button x:Name="PART_OkButton"
                                                Content="{localization:RibbonString Key=Ok}"
                                                IsDefault="True"
                                                Style="{StaticResource OptionsDialogPrimaryButtonStyle}" />
                                        <Button x:Name="PART_CancelButton"
                                                Content="{localization:RibbonString Key=Cancel}"
                                                IsCancel="True"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource OptionsDialogActionButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </AdornerDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
