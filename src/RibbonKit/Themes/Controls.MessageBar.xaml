<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RibbonKit.Controls"
    xmlns:localization="clr-namespace:RibbonKit.Localization">

    <!-- Repeatable Office-style warning/information strips. Colours come entirely from the
         active token dictionary; hosts may still override Background/Foreground per message. -->
    <Style TargetType="{x:Type controls:RibbonMessageBar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="{DynamicResource RibbonKit.Metrics.MessageBar.Margin}" />
        <!-- While messages are presented, the ribbon/QAT keeps its own shadow and this continuation
             surface becomes the combined card's final shadow-casting edge. -->
        <Setter Property="Effect" Value="{DynamicResource RibbonKit.Effects.ContentShadow}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonMessageBar}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Avoid retaining the theme's bottom margin after the final row closes. Keep the
                 ItemsControl measurable so an ItemsSource can still generate its first container;
                 the collapsed rows themselves contribute zero height. -->
            <Trigger Property="HasOpenMessages" Value="False">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:RibbonMessage}">
        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.MessageBar.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.MessageBar.Foreground}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RibbonMessage}">
                    <Border x:Name="PART_Root"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource RibbonKit.Brushes.MessageBar.Border}"
                            BorderThickness="{DynamicResource RibbonKit.Metrics.MessageBar.BorderThickness}"
                            CornerRadius="0"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="18" Height="18"
                                  Margin="12,0,8,0"
                                  VerticalAlignment="Center">
                                <Viewbox x:Name="DefaultIcon"
                                         Width="18" Height="18"
                                         Visibility="Collapsed">
                                    <Grid Width="18" Height="18">
                                        <Path Data="M9,1.5 L15.5,4 V8.5 C15.5,12.4 12.8,15.2 9,16.5 C5.2,15.2 2.5,12.4 2.5,8.5 V4 Z"
                                              Fill="Transparent"
                                              Stroke="{DynamicResource RibbonKit.Brushes.MessageBar.IconForeground}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round" />
                                        <Path Data="M9,5.2 V10.4 M9,13 L9.01,13"
                                              Stroke="{DynamicResource RibbonKit.Brushes.MessageBar.IconForeground}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Grid>
                                </Viewbox>
                                <Image x:Name="CustomIcon"
                                       Width="16" Height="16"
                                       Source="{TemplateBinding Icon}"
                                       Stretch="Uniform" />
                            </Grid>

                            <TextBlock x:Name="TitleText"
                                       Grid.Column="1"
                                       Text="{TemplateBinding Title}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <TextBlock x:Name="MessageText"
                                       Grid.Column="2"
                                       Text="{TemplateBinding Message}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,4" />

                            <Button x:Name="PART_ActionButton"
                                    Grid.Column="3"
                                    MinHeight="26"
                                    Margin="10,3"
                                    Padding="9,2"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding ActionContent}"
                                    Command="{TemplateBinding ActionCommand}"
                                    CommandParameter="{TemplateBinding ActionCommandParameter}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Background" Value="{DynamicResource RibbonKit.Brushes.Control.SurfaceBackground}" />
                                        <Setter Property="Foreground" Value="{DynamicResource RibbonKit.Brushes.Text.Primary}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource RibbonKit.Brushes.ScreenTip.Border}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="Chrome"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="{DynamicResource RibbonKit.Metrics.SmallControlCornerRadius}">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="4"
                                    Width="22" Height="22"
                                    Margin="4,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{localization:RibbonString Key=Close}">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Chrome"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource RibbonKit.Metrics.SmallControlCornerRadius}">
                                            <Path Data="M0,0 L8,8 M8,0 L0,8"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:RibbonMessage}}}"
                                                  StrokeThickness="1.2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Path.RenderTransform>
                                                    <TranslateTransform X="0.5" Y="0.5" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource RibbonKit.Brushes.Control.HoverBackground}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush"
                                                        Value="{DynamicResource RibbonKit.Brushes.MessageBar.CloseHoverBorder}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource RibbonKit.Brushes.Control.PressedBackground}" />
                                                <Setter TargetName="Chrome" Property="BorderBrush"
                                                        Value="{DynamicResource RibbonKit.Brushes.MessageBar.CloseHoverBorder}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="DefaultIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CustomIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleText" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ActionContent" Value="{x:Null}">
                            <Setter TargetName="PART_ActionButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDismissible" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsPresented" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsLastOpenMessage" Value="True">
                            <Setter TargetName="PART_Root" Property="CornerRadius"
                                    Value="{DynamicResource RibbonKit.Metrics.MessageBar.LastCornerRadius}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
