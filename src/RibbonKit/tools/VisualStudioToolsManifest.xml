<?xml version="1.0" encoding="utf-8"?>
<!--
  Toolbox population for the new WPF/.NET XAML designer. The designer reads this from the NuGet
  package's tools\ folder and shows ONLY the listed types (an allowlist) under the VSCategory tab
  — so internal part/host/panel/dialog types are excluded simply by not being listed.

  NOTE: this only takes effect when RibbonKit is consumed as a NuGet PACKAGE. In a project-reference
  setup (e.g. the showcase referencing the RibbonKit project) discovery reflects public controls.
  ToolboxMetadata in RibbonKit.DesignTools supplies matching visibility/category intent there;
  this manifest itself does not filter project references. Verify the two discovery paths separately.
-->
<FileList>
  <File Reference="RibbonKit.dll">
    <ToolboxItems VSCategory="RibbonKit" BlendCategory="RibbonKit" UIFramework="WPF">
      <!-- Primary -->
      <Item Type="RibbonKit.Controls.Ribbon" />

      <!-- Structure -->
      <Item Type="RibbonKit.Controls.RibbonTab" />
      <Item Type="RibbonKit.Controls.RibbonGroup" />
      <Item Type="RibbonKit.Controls.RibbonGroupSeparator" />

      <!-- Command controls -->
      <Item Type="RibbonKit.Controls.RibbonButton" />
      <Item Type="RibbonKit.Controls.RibbonToggleButton" />
      <Item Type="RibbonKit.Controls.RibbonCheckBox" />
      <Item Type="RibbonKit.Controls.RibbonRadioButton" />
      <Item Type="RibbonKit.Controls.RibbonSplitButton" />
      <Item Type="RibbonKit.Controls.RibbonDropDownButton" />
      <Item Type="RibbonKit.Controls.RibbonComboBox" />
      <Item Type="RibbonKit.Controls.RibbonTextBox" />
      <Item Type="RibbonKit.Controls.RibbonScrollBar" />
      <Item Type="RibbonKit.Controls.RibbonMenuItem" />

      <!-- Galleries -->
      <Item Type="RibbonKit.Controls.RibbonGallery" />
      <Item Type="RibbonKit.Controls.InRibbonGallery" />
      <Item Type="RibbonKit.Controls.RibbonGalleryItem" />

      <!-- Backstage -->
      <Item Type="RibbonKit.Controls.Backstage" />
      <Item Type="RibbonKit.Controls.BackstageTabItem" />

      <!-- Application menu: child items belong in their semantic menu/pane/footer slots. -->
      <Item Type="RibbonKit.Controls.RibbonApplicationMenu" />
      <Item Type="RibbonKit.Controls.RibbonApplicationMenuItem" />
      <Item Type="RibbonKit.Controls.RibbonApplicationMenuSeparator" />
      <Item Type="RibbonKit.Controls.RibbonApplicationMenuPaneItem" />
      <Item Type="RibbonKit.Controls.RibbonApplicationMenuButton" />

      <!-- Host-authored options/customization content; the host assigns the Ribbon explicitly. -->
      <Item Type="RibbonKit.Controls.RibbonOptionsPage" />
      <Item Type="RibbonKit.Controls.RibbonCustomizePage" />
      <Item Type="RibbonKit.Controls.RibbonSimplifiedCustomizePage" />
      <Item Type="RibbonKit.Controls.RibbonQuickAccessPage" />

      <!-- Messages -->
      <Item Type="RibbonKit.Controls.RibbonMessageBar" />
      <Item Type="RibbonKit.Controls.RibbonMessage" />

      <!-- Preview MDI host; child windows are generated from host-owned documents. -->
      <Item Type="RibbonKit.Controls.MdiContainer" />
    </ToolboxItems>
  </File>
</FileList>
